diff --git a/STUDIO/lora/inference_benchmark.rb b/STUDIO/lora/inference_benchmark.rb
new file mode 100644
index 0000000..22ef787
--- /dev/null
+++ b/STUDIO/lora/inference_benchmark.rb
@@ -0,0 +1,188 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+# Controlled inference benchmark for a subject's own LoRA. The guidance, steps
+# and LoRA-strength numbers in training_standards.yml are interim until they
+# are measured; this tool varies ONE axis at a time around the current
+# inference block, holding prompts, seed and grading constant, so each render
+# isolates a single cause. Usage:
+#
+#   ruby STUDIO/lora/inference_benchmark.rb --subject merethe
+#   ruby STUDIO/lora/inference_benchmark.rb --subject merethe --matrix
+#
+# --matrix prints the cells without spending anything. A full run costs one
+# provider prediction per cell (two prompts x seven cells at the time of
+# writing). Every render is private (0700 directory, 0600 files), measured
+# with the same whole-frame proxies judge.rb uses, and labelled for full-size
+# human comparison. The metrics are proxies, not identity verdicts: the
+# receipt's verdict stays AWAITING_HUMAN_REVIEW until a person compares the
+# renders at 100% against the approved holdout references.
+
+require "fileutils"
+require "json"
+require "optparse"
+require "time"
+require "yaml"
+require_relative "idea_picture"
+require_relative "../postpro/uncanny"
+
+module Studio
+  module Lora
+    module InferenceBenchmark
+      ROOT = File.expand_path(__dir__).freeze
+      STANDARDS_PATH = File.join(ROOT, "training_standards.yml").freeze
+      STANDARDS = YAML.safe_load_file(
+        STANDARDS_PATH, permitted_classes: [], permitted_symbols: [], aliases: false
+      ).freeze
+
+      class Error < StandardError; end
+
+      # Expand the benchmark block into labelled cells: the baseline (current
+      # inference block, no overrides) plus one cell per value on each axis.
+      # Pure, so tests can pin the matrix without a provider.
+      def self.cells(standards = STANDARDS)
+        inference = standards.fetch("inference")
+        benchmark = standards.fetch("benchmark")
+        seed = benchmark.fetch("seed")
+        prompts = benchmark.fetch("prompts")
+        raise Error, "benchmark prompts must be a non-empty list" unless prompts.is_a?(Array) && prompts.any?
+
+        base = {
+          "guidance_scale" => inference.fetch("guidance_scale"),
+          "num_inference_steps" => inference.fetch("num_inference_steps"),
+          "lora_scale" => inference.fetch("lora_scale"),
+        }
+        variants = [{ "label" => "baseline", "overrides" => {} }]
+        benchmark.fetch("axes").each do |axis, values|
+          Array(values).each do |value|
+            variants << { "label" => "#{axis}=#{value}", "overrides" => { axis => value } }
+          end
+        end
+
+        prompts.each_with_index.flat_map do |prompt, prompt_index|
+          variants.map do |variant|
+            {
+              "label" => "p#{prompt_index + 1}_#{variant.fetch("label")}",
+              "prompt" => prompt,
+              "seed" => seed,
+              "overrides" => variant.fetch("overrides"),
+              "settings" => base.merge(variant.fetch("overrides")),
+            }
+          end
+        end
+      end
+
+      class Runner
+        def initialize(subject:, subjects_root: Studio::Visual::IdeaPicture::SUBJECTS)
+          @subject = subject.to_s
+          @subjects_root = File.expand_path(subjects_root)
+          @subject_directory = File.join(@subjects_root, @subject)
+          unless File.directory?(@subject_directory) && !File.symlink?(@subject_directory)
+            raise Error, "subject directory is missing or symlinked"
+          end
+        end
+
+        def run
+          output = new_output_directory
+          results = InferenceBenchmark.cells.map { |cell| render_cell(cell, output) }
+          receipt = {
+            "schema" => "studio.lora.inference_benchmark.v1",
+            "subject" => @subject,
+            "created_at" => Time.now.utc.iso8601,
+            "render_count" => results.length,
+            "provider_predictions" => results.length,
+            "provider_uploads" => 0,
+            "renders" => results,
+            "identity_assessment" => "NOT_AUTOMATED",
+            "verdict" => "AWAITING_HUMAN_REVIEW",
+            "review_instruction" => "Compare every full-size render against the approved holdout references at 100%. Metrics are whole-frame proxies; they cannot establish likeness, skin naturalness or composition.",
+          }
+          path = File.join(output, "benchmark.json")
+          write_private(path, JSON.pretty_generate(receipt) + "\n")
+          { "status" => "AWAITING_HUMAN_REVIEW", "receipt" => path, "render_count" => results.length }
+        end
+
+        private
+
+        def render_cell(cell, output)
+          picture = Studio::Visual::IdeaPicture.new(
+            subject: @subject, subjects_root: @subjects_root, directory: output,
+            lora_only: true, allow_unreviewed_likeness: true,
+            inference_overrides: cell.fetch("overrides").merge("seed" => cell.fetch("seed"))
+          )
+          picture.validate_model!
+          still = picture.write(
+            cell.fetch("prompt"), film: false,
+            output_stem: "benchmark_#{cell.fetch("label")}"
+          ).fetch("still")
+          reading = Postpro::Uncanny.read(still)
+          {
+            "label" => cell.fetch("label"),
+            "settings" => cell.fetch("settings"),
+            "seed" => cell.fetch("seed"),
+            "file" => File.basename(still),
+            "texture" => reading.texture,
+            "specular_spread" => reading.specular_spread,
+            "clipping_percent" => reading.clipping,
+            "tonal_range" => reading.tonal_range,
+          }
+        end
+
+        def new_output_directory
+          cache = File.join(@subject_directory, ".cache")
+          secure_directory!(cache)
+          stamp = Time.now.utc.strftime("%Y%m%dT%H%M%S%6N")
+          path = File.join(cache, "inference-benchmark", stamp)
+          secure_directory!(File.dirname(path))
+          secure_directory!(path)
+          path
+        end
+
+        def secure_directory!(path)
+          raise Error, "refusing symlink directory: #{path}" if File.symlink?(path)
+
+          FileUtils.mkdir_p(path, mode: 0o700)
+          stat = File.lstat(path)
+          raise Error, "benchmark directory is not owned by the current user" unless stat.directory? && stat.uid == Process.uid
+
+          File.chmod(0o700, path)
+        end
+
+        def write_private(path, contents)
+          raise Error, "benchmark file already exists: #{File.basename(path)}" if File.exist?(path) || File.symlink?(path)
+
+          File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
+            file.write(contents)
+            file.flush
+            file.fsync
+          end
+          File.chmod(0o600, path)
+        end
+      end
+    end
+  end
+end
+
+if $PROGRAM_NAME == __FILE__
+  options = { subject: nil, matrix: false }
+  OptionParser.new do |parser|
+    parser.banner = "Usage: ruby STUDIO/lora/inference_benchmark.rb --subject NAME [--matrix]"
+    parser.on("--subject NAME", "Subject whose LoRA is benchmarked") { |value| options[:subject] = value }
+    parser.on("--matrix", "Print the benchmark cells without rendering") { options[:matrix] = true }
+    parser.on("-h", "--help", "Show this help") { puts parser; exit 0 }
+  end.parse!
+
+  if options[:subject].to_s.empty?
+    warn "a subject is required: --subject NAME"
+    exit 64
+  end
+
+  if options[:matrix]
+    puts JSON.pretty_generate(Studio::Lora::InferenceBenchmark.cells)
+    exit 0
+  end
+
+  result = Studio::Lora::InferenceBenchmark::Runner.new(subject: options[:subject]).run
+  puts JSON.pretty_generate(result)
+  exit 0
+end
