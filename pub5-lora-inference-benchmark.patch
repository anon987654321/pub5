new file mode 100644
index 0000000..0eed2ad
--- /dev/null
+++ b/MASTER/test/test_lora_inference_benchmark.rb
@@ -0,0 +1,66 @@
+# frozen_string_literal: true
+
+require "minitest/autorun"
+
+begin
+  require_relative "../../STUDIO/lora/inference_benchmark"
+rescue LoadError => error
+  # The benchmark pulls in the render chain (vips for the grade/uncanny
+  # readers); a machine without those gems can still run the rest of the suite.
+  warn "skipping inference benchmark tests: #{error.message}"
+  return
+end
+
+# The benchmark's one guarantee is that every render isolates a single cause:
+# the baseline cell carries no overrides and every other cell varies exactly
+# one axis. If the matrix ever varies two axes at once, a comparison between
+# cells says nothing about either.
+class TestLoraInferenceBenchmark < Minitest::Test
+  Standards = {
+    "inference" => {
+      "guidance_scale" => 7.5, "num_inference_steps" => 28, "lora_scale" => 1.0,
+    },
+    "benchmark" => {
+      "seed" => 42,
+      "prompts" => ["prompt one", "prompt two"],
+      "axes" => {
+        "guidance_scale" => [2.5, 3.5],
+        "num_inference_steps" => [45],
+        "lora_scale" => [0.7],
+      },
+    },
+  }.freeze
+
+  def cells
+    Studio::Lora::InferenceBenchmark.cells(Standards)
+  end
+
+  def test_baseline_cell_carries_no_overrides
+    baselines = cells.select { |cell| cell["label"].end_with?("baseline") }
+    assert_equal 2, baselines.length
+    assert(baselines.all? { |cell| cell["overrides"].empty? })
+  end
+
+  def test_every_variant_varies_exactly_one_axis
+    variants = cells.reject { |cell| cell["label"].end_with?("baseline") }
+    refute_empty variants
+    variants.each do |cell|
+      assert_equal 1, cell["overrides"].length, "#{cell["label"]} must vary one axis, got #{cell["overrides"].keys}"
+    end
+  end
+
+  def test_every_prompt_and_seed_is_held_constant
+    assert_equal [42], cells.map { |cell| cell["seed"] }.uniq
+    assert_equal 2, cells.group_by { |cell| cell["prompt"] }.length
+    # 4 variants x 2 prompts.
+    assert_equal 8, cells.length
+    assert_equal 8, cells.map { |cell| cell["label"] }.uniq.length
+  end
+
+  def test_settings_reflect_the_varied_axis
+    cell = cells.find { |item| item["label"] == "p1_guidance_scale=2.5" }
+    assert_equal 2.5, cell.dig("settings", "guidance_scale")
+    assert_equal 28, cell.dig("settings", "num_inference_steps")
+    assert_equal 1.0, cell.dig("settings", "lora_scale")
+  end
+end
