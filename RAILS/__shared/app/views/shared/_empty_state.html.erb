<%#
  Shared empty state — title + body + optional CTA.
  Usage:
    render "shared/empty_state",
      title: "No posts",
      body: "Try another search.",
      action: { label: "Compose", path: new_post_path }
%>
<% title = local_assigns[:title] %>
<% body = local_assigns[:body] %>
<% action = local_assigns[:action] %>
<%= tag.section class: class_names("empty empty-state", local_assigns[:class]), role: "status", aria: (local_assigns.fetch(:live, true) ? { live: "polite" } : {}) do %>
  <%# Only draw an icon when it conveys useful information. %>
  <% if local_assigns[:icon].present? %>
    <%= tag.span class: "empty-state-icon", aria: { hidden: true } do %>
      <%= icon local_assigns[:icon], size: 24 %>
    <% end %>
  <% end %>
  <%= tag.h2 title, class: "empty-state-title" if title.present? %>
  <%= tag.p body, class: "empty-state-body" if body.present? %>
  <% if action.is_a?(Hash) && action[:label].present? && action[:path].present? %>
    <%= link_to action[:label], action[:path], class: "button button-primary empty-state-action" %>
  <% end %>
<% end %>
