<% content_for :title, @comic_strip.prompt.truncate(60) %>

<article aria-labelledby="comic-strip-title">
  <header>
    <h1 id="comic-strip-title"><%= @comic_strip.prompt %></h1>
    <p><%= t("comic_strips.show.style") %>: <%= t("comic_strips.styles.#{@comic_strip.style}") %> · <%= t("comic_strips.show.status") %>: <%= t("comic_strips.statuses.#{@comic_strip.status}") %></p>
  </header>

  <% if @comic_strip.status == "completed" && @comic_strip.safe_image_urls.any? %>
    <section aria-label="<%= t('comic_strips.show.generated_images') %>" class="comic-grid">
      <% @comic_strip.safe_image_urls.each do |url| %>
        <%= image_tag url, alt: t("comic_strips.show.panel_alt"), loading: "lazy" %>
      <% end %>
    </section>
  <% elsif @comic_strip.status.in?(%w[pending processing]) %>
    <p><%= t("comic_strips.show.in_progress") %> <%= link_to t("comic_strips.show.refresh"), comic_strip_path(@comic_strip) %></p>
  <% elsif @comic_strip.status == "failed" %>
    <p role="status"><%= t("comic_strips.show.failed") %></p>
  <% end %>
</article>
