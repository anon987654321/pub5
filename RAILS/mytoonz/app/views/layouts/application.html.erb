<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#000000" data-light-color="#ffffff" data-dark-color="#000000">
  <meta name="turbo-cache-control" content="no-preview">
  <%= tag.meta name: "turbo-cache-control", content: "no-cache" %>
  <title><%= content_for?(:title) ? "#{yield(:title)} — #{t('app.name')}" : t("app.name") %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : t('app.description') %>">
  <link rel="canonical" href="<%= request.original_url.split("?").first %>">
  <meta property="og:site_name" content="<%= t('app.name') %>">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : t('app.name') %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : t('app.description') %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preload" href="/icon.png" as="image">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= json_ld_script(website_json_ld(site_name: t("app.name"), url: root_url, description: t("app.description"))) %>
  <%= javascript_importmap_tags %>
</head>
<body class="zen-minimal" data-pwa-key="mytoonz" data-controller="pwa-standalone">
<a class="skip-link" href="#main-content"><%= t("nav.skip_to_content") %></a>
<nav data-pwa-primary-nav data-turbo-permanent aria-label="<%= t('nav.primary') %>">
  <%= link_to t("app.name"), root_path, class: "brand", aria: { current: current_page?(root_path) ? "page" : nil } %>
  <%= link_to t("nav.gallery"), comic_strips_path, aria: { current: current_page?(comic_strips_path) ? "page" : nil } %>
  <% if authenticated? %>
    <%= render "shared/inbox_link" %>
    <%= link_to t("nav.sign_out"), session_path, data: { turbo_method: :delete, turbo_prefetch: false } %>
  <% else %>
    <%= link_to t("nav.sign_in"), new_session_path %>
  <% end %>
</nav>
<%= tag.p(notice, role: "status", class: "flash-notice") if notice %>
<%= tag.p(alert, role: "alert", class: "flash-alert") if alert %>
<main id="main-content"><%= yield %></main>
<%= render "shared/install_prompt" %>
</body>
</html>
