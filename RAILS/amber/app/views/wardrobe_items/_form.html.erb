<%= form_with model: wardrobe_item do |form| %>
  <%= render "shared/errors", object: wardrobe_item %>

  <%= tag.div class: "field" do %>
    <%= form.label :item_id %>
    <%= form.collection_select :item_id, Current.user.items.order(:title), :id, :title,
          { prompt: true }, { required: true } %>
  <% end %>

  <%= tag.div class: "field" do %>
    <%= form.label :condition %>
    <%= form.select :condition, WardrobeItem::CONDITIONS, include_blank: true %>
  <% end %>

  <%= tag.div class: "field" do %>
    <%= form.label :acquisition_date %>
    <%= form.date_field :acquisition_date %>
  <% end %>

  <%= tag.div class: "field" do %>
    <%= form.label :notes %>
    <%= character_counter_field form, :notes, max: 2000, rows: 4 %>
  <% end %>

  <%= form.submit %>
<% end %>
