<% content_for :title, "Food" %>
<header class="page-header" role="banner" aria-label="<%= t("a11y.food_listings_header") %>">
  <h1>Available food</h1>
  <nav role="navigation" aria-label="<%= t("a11y.food_actions") %>">
    <% if authenticated? %><%= link_to "List food", new_food_listing_path %><% end %>
