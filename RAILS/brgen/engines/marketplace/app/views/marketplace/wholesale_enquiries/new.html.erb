<% content_for :title, t("marketplace.wholesale_enquiries.new") %>

<%= tag.section class: "wholesale-enquiry-form" do %>
  <%= tag.h1 t("marketplace.wholesale_enquiries.new") %>
  <p><%= @store.name %></p>
  <p><%= t("marketplace.wholesale_enquiries.no_order_yet") %></p>
  <%= render "shared/errors", object: @enquiry %>

  <%= form_with model: @enquiry,
        url: shop_wholesale_enquiries_path(@store),
        scope: :wholesale_enquiry do |form| %>
    <%= tag.fieldset do %>
      <%= form.label :buyer_company_name, t("marketplace.wholesale_enquiries.company_name") %>
      <%= form.text_field :buyer_company_name, required: true, maxlength: 200, autocomplete: "organization" %>
    <% end %>
    <%= tag.fieldset do %>
      <%= form.label :organisation_number, t("marketplace.wholesale_enquiries.organisation_number") %>
      <%= form.text_field :organisation_number, required: true, maxlength: 11,
            inputmode: "numeric", autocomplete: "off", placeholder: "123 456 789" %>
    <% end %>
    <%= tag.fieldset do %>
      <%= form.label :contact_name, t("marketplace.wholesale_enquiries.contact_name") %>
      <%= form.text_field :contact_name, required: true, maxlength: 200, autocomplete: "name" %>
    <% end %>
    <%= tag.fieldset do %>
      <%= form.label :contact_email, t("marketplace.wholesale_enquiries.contact_email") %>
      <%= form.email_field :contact_email, required: true, maxlength: 254, autocomplete: "email" %>
    <% end %>
    <%= tag.fieldset do %>
      <%= form.label :contact_phone, t("marketplace.wholesale_enquiries.contact_phone") %>
      <%= form.telephone_field :contact_phone, maxlength: 40, autocomplete: "tel" %>
    <% end %>
    <%= tag.fieldset do %>
      <%= form.label :requested_items, t("marketplace.wholesale_enquiries.requested_items") %>
      <%= tag.p t("marketplace.wholesale_enquiries.requested_items_hint"), class: "hint" %>
      <%= form.text_area :requested_items, required: true, rows: 6, maxlength: 4_000 %>
    <% end %>
    <%= tag.fieldset do %>
      <%= form.label :delivery_location, t("marketplace.wholesale_enquiries.delivery_location") %>
      <%= form.text_field :delivery_location, required: true, maxlength: 200,
            autocomplete: "shipping postal-code" %>
    <% end %>
    <%= tag.fieldset do %>
      <%= form.label :wanted_at, t("marketplace.wholesale_enquiries.wanted_at") %>
      <%= form.date_field :wanted_at %>
    <% end %>
    <%= form.submit t("marketplace.wholesale_enquiries.submit") %>
  <% end %>
<% end %>
