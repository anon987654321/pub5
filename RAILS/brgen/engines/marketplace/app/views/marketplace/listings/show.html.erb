<% content_for :title, @listing.title %>
<% content_for :description, meta_description_for(@listing) %>
<% content_for :json_ld, json_ld_for(@listing, type: :product) %>
<% content_for :og_type, "product" %>
<% content_for :og_image, seo_image_url(@listing.photos.first) %>
<% content_for :json_ld, json_ld_script(breadcrumb_json_ld([
      [t("marketplace.home_title", city: city_name), listings_url],
      [@listing.title, seo_canonical_url]
    ])) %>

<% if params[:listed] == "1" && Current.user.present? && Current.user == @listing.user %>
  <aside class="listing-published-notice" role="status">
    <strong><%= t("marketplace.listing_published_heading") %></strong>
    <%= link_to t("marketplace.list_another"), new_listing_path(kind: @listing.kind),
          class: "button button-primary" %>
  </aside>
<% end %>

<%= render "marketplace/nav_bar",
      cart_count: (Current.user.present? ? Current.user.marketplace_orders.where(status: "pending").count : 0),
      categories: @categories %>

<%# Bol-style product page, measured at 1440 and 400: a 13px breadcrumb, then
    the picture on the left seven twelfths and, on the right, the title, the
    stars and a white buy box holding price, facts and the actions. On a phone
    the two columns stack, picture first. %>
<nav class="store-breadcrumb" aria-label="<%= t("storefront.breadcrumb") %>">
  <%= link_to t("marketplace.home_title", city: city_name), listings_path %>
  <% if @listing.category %>
    <%= link_to @listing.category.name, listings_path(kind: @listing.kind, category_id: @listing.category_id) %>
  <% end %>
  <%= tag.span @listing.title, aria: { current: "page" } %>
</nav>

<div class="store-pdp">
  <div class="store-pdp-media">
    <% if @listing.video.attached? %>
      <%= video_tag @listing.video, controls: true, preload: "metadata", class: "listing-video", aria: { label: t("marketplace.optional_video") } %>
    <% end %>
    <% if @listing.photos.attached? %>
      <%= render "shared/media_gallery", attachments: @listing.photos, title: @listing.title %>
    <% else %>
      <%# No photograph was uploaded, so the well says so with the title's initial
          rather than a picture of something else. %>
      <div class="deal-card-img" aria-hidden="true">
        <div class="deal-card-placeholder"><%= @listing.title.to_s.first&.upcase %></div>
      </div>
    <% end %>
  </div>

  <div class="store-pdp-info">
    <div class="page-header marketplace-listing-header">
      <%= tag.h1 @listing.title %>
      <nav aria-label="<%= t("aria.listing_actions") %>" class="marketplace-actions">
        <% if Current.user.present? && Current.user == @listing.user %>
          <%= link_to t("actions.edit"), edit_listing_path(@listing), class: "button button-ghost" %>
        <% elsif Current.user.present? %>
          <%= render "marketplace/listings/favorite_button",
                listing: @listing,
                favorited: @listing.favorite_for(Current.user).present? %>
          <%# A scam listing is reported from its own page; reporting needs an account. %>
          <%= render "shared/report_button", target: @listing, reason: "scam" if authenticated? %>
        <% end %>
      </nav>
    </div>
    <% if @listing.reviews_count.to_i.positive? %>
      <%= render "shared/store_stars", rating: @listing.rating, count: @listing.reviews_count %>
    <% end %>

    <%= render "marketplace/listings/buybox" %>
  </div>
</div>

<section class="store-pdp-description">
  <div><%= read_more(@listing.description, lines: 6, more: t("actions.read_more"), less: t("actions.read_less")) %></div> <%# scan: intentional — read_more needs one block to clamp %>
  <button class="button-share" data-controller="share"
          data-share-title-value="<%= @listing.title %>"
          data-share-url-value="<%= request.original_url %>"
          data-action="click->share#share"><%= t("marketplace.share") %></button>
  <%= link_to t("marketplace.share_to_feed"),
        main_app.new_post_path(title: @listing.title, url: request.original_url),
        class: "button button-ghost" %>
  <%= render "shared/affiliate_disclosure" %>
</section>

<%= render "shared/also_nearby", items: @nearby_listings, title: t("marketplace.nearby_listings") %>

<%= render "marketplace/listings/questions", listing: @listing, questions: @questions, question_form: @question %>

<%# Kaufland's review rows, the markup takeaway's restaurant page already uses:
    the stars drawn from the rating, then who and when. %>
<section class="section-divider store-reviews" aria-labelledby="listing-reviews-heading">
  <%= tag.h2 t("marketplace.reviews"), id: "listing-reviews-heading", class: "section-heading--md" %>
  <% if @review %>
    <div class="form-wrap form-wrap--flush">
      <%= form_with(model: @review, url: listing_reviews_path(@listing)) do |f| %>
        <div class="field"><%= f.label :rating %><%= f.select :rating, options_for_select((1..5).map { |n| [ "#{n} ★", n ] }) %></div>
        <div class="field"><%= f.label :body %><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :body, rows: 3 , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></div>
        <div class="field"><%= f.submit t("marketplace.post_review"), class: "button button-primary" %></div>
      <% end %>
    </div>
  <% end %>
  <% if @reviews.any? %>
    <%= render partial: "marketplace/listings/review", collection: @reviews %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_reviews"),
          body: t("marketplace.no_reviews_body"),
          action: { label: t("marketplace.browse_listings"), path: listings_path } %>
  <% end %>
</section>

<% if Current.user.present? && Current.user != @listing.user && @listing.buyable? %>
  <div id="make-offer" class="section-divider">
    <%# h2, not a styled p: the page's sections are its outline. %>
    <%= tag.h2 t("marketplace.make_offer"), class: "section-heading--md" %>
    <p><%= t("marketplace.message_seller_hint") %></p>
    <div class="form-wrap form-wrap--flush">
      <% draft_key = "brgen-marketplace-order-#{@listing.to_param}-new" %>
      <%= form_with(model: @order, url: listing_orders_path(@listing), data: { controller: "draft-store autosave", "draft-store-key-value": draft_key, **autosave_data(key: draft_key, url: main_app.draft_path(draft_key)) }) do |f| %>
        <div class="field"><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :message, placeholder: t("marketplace.message_seller"), aria: { label: t("marketplace.message_seller") }, rows: 3 , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></div>
        <% if @variants.present? %>
          <%# A listing with sizes is bought by the size: an order naming none is
              one the seller cannot pack, and the model refuses it. %>
          <div class="field">
            <%= f.label :variant_id, t("marketplace.choose_variant") %>
            <%= f.select :variant_id,
                  @variants.map { |variant| [ "#{variant.label} — #{variant.price_display}", variant.id ] },
                  { include_blank: t("marketplace.choose_variant_blank") } %>
          </div>
        <% end %>
        <div class="field"><%= f.submit t("marketplace.send_offer"), class: "button button-primary" %> <span data-autosave-target="status" aria-live="polite"></span></div>
      <% end %>
    </div>
  </div>
<% end %>

<%= render "marketplace/listings/owner_dashboard",
      listing: @listing, buy_box_reasons: @buy_box_reasons,
      buy_box_result: @buy_box_result, seller_performance: @seller_performance %>

