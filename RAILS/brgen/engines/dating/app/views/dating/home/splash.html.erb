<% content_for :title, t("dating.splash.title") %>

<%# The operator's first screen for dating (mockup, mobile): "sveip for å
    begynne", the heart, the word dating, and the identity check that guards
    the deck. The whole screen is the way in: a swipe anywhere, or the link,
    which is all there is without script. %>
<section class="dating-splash"
         data-controller="dating-splash"
         data-dating-splash-url-value="<%= root_path(start: 1) %>"
         data-action="pointerdown->dating-splash#pointerDown pointerup->dating-splash#pointerUp pointercancel->dating-splash#pointerCancel">
  <%= link_to t("dating.splash.start"), root_path(start: 1), class: "dating-splash-start" %>

  <%# The recovered screenshot defines the open light-trail heart. The local
      css-doodle build animates light across four broken contour strokes.
      The same mask supplies a static first paint without JavaScript. %>
  <div class="dating-splash-heart" data-dating-splash-target="heart" aria-hidden="true">
    <css-doodle>
      :doodle { @grid: 1 / 100%; }
      background-image: var(--heart-trail-color);
      background-size: 170% 150%;
      background-position: 35% 50%;
      mask: var(--heart-trail-mask) center / contain no-repeat;
      animation: heart-light var(--heart-trail-duration) ease-in-out both;
      @keyframes heart-light {
        0% { background-position: 0% 80%; opacity: .65; }
        35% { background-position: 70% 10%; opacity: 1; }
        70% { background-position: 100% 70%; opacity: .82; }
        100% { background-position: 35% 50%; opacity: 1; }
      }
    </css-doodle>
  </div>

  <%= tag.h1 t("dating.splash.title"), class: "dating-splash-title" %>

  <%# Named only when it is true: the provider the identity gate actually
      requires before a profile can be shown (Dating::BaseController). %>
  <% if identity_provider_name %>
    <p class="dating-splash-trust">
      <%= t("dating.splash.protected_by") %>
      <% if identity_provider_name == "Vipps" %>
        <%= image_tag "vipps/vipps-wordmark.svg", alt: "Vipps", width: 164, height: 66 %>
      <% else %>
        <%= tag.strong identity_provider_name %>
      <% end %>
    </p>
  <% end %>
</section>
