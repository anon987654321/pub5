<% content_for :title, t("dating.splash.title") %>

<%# The operator's first screen for dating (mockup, mobile): "sveip for å
    begynne", the heart, the word dating, and the identity check that guards
    the deck. The whole screen is the way in: a swipe anywhere, or the link,
    which is all there is without script. %>
<section class="dating-splash"
         data-controller="dating-splash"
         data-dating-splash-url-value="<%= root_path(start: 1) %>"
         data-action="pointerdown->dating-splash#pointerDown pointerup->dating-splash#pointerUp">
  <%= link_to t("dating.splash.start"), root_path(start: 1), class: "dating-splash-start" %>

  <div class="dating-splash-heart">
    <%# Complete Hjerterom lockup, restored from pub4 history. The original heart
        and wordmark stay together; Dating remains the vertical heading below.
        The inline SVG pauses at its first frame for reduced motion. %>
    <%# chrome_i18n: ok – the lockup wordmark is brand copy, not translated %>
    <%= render "dating/home/hjerterom_logo", compact: false, svg_uid: "dating-splash", label: "Hjerterom" %>
  </div>

  <%= tag.h1 t("dating.splash.title"), class: "dating-splash-title" %>

  <%# Named only when it is true: the provider the identity gate actually
      requires before a profile can be shown (Dating::BaseController). %>
  <% if identity_provider_name %>
    <%= tag.p safe_join([t("dating.splash.protected_by"), tag.strong(identity_provider_name)], " "),
              class: "dating-splash-trust" %>
  <% end %>
</section>
