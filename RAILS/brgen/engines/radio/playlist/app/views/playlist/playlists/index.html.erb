<% content_for :title, t("playlist.home_title") %>

<%# The tunnel is the visual surface; this heading names the page in the document outline. %>
<%= tag.h1 t("playlist.home_title"), class: "visually-hidden" %>

<%# The archived Radio Bergen tunnel is rendered from the Playlist engine and
    remains the primary visualizer/player. Its library drawer opens the existing
    Playlist model; browsing all hosted tracks remains one click away. Playback
    starts only after an explicit gesture. %>
<%= render "playlist/playlists/radio_tunnel",
      playlists: @playlists,
      pagy: nil,
      auto_start: false,
      hide_overlay: false,
      minimal: false,
      show_library: true %>
