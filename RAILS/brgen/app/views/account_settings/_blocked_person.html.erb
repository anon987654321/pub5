<%# One blocked person, with the button that lifts the block. locals: block %>
<%= tag.li do %>
  <%= link_to block.blocked.display_name, user_path(block.blocked) %>
  <%= button_to t("account_blocks.unblock"), unblock_user_path(block.blocked), method: :delete,
                data: { turbo_confirm: t("account_blocks.confirm_unblock") }, class: "button button-small" %>
<% end %>
