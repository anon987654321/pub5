<% attachments = local_assigns.fetch(:attachments, []) %>
<% title = local_assigns.fetch(:title, "Gallery") %>

<% if attachments.any? %>
  <section
    data-controller="lightbox"
    aria-label="<%= title %>"
  >
    <div class="media-gallery" tabindex="0" role="group" aria-label="<%= title %>"
         data-controller="carousel" data-carousel-options-value='{"preserveSizing":true}'>
      <% attachments.each do |attachment| %>
        <a href="<%= main_app.url_for(attachment) %>" class="media-gallery-item">
          <%= lazy_image_tag attachment, alt: title, blurhash: attachment.try(:metadata).try(:[], "blurhash") %>
        </a>
      <% end %>
    </div>
  </section>
<% end %>
