#!/usr/bin/env zsh
set -euo pipefail

# Start web and Solid Queue side by side (overmind preferred, foreman fallback).

if ! command -v overmind >/dev/null 2>&1 && ! command -v foreman >/dev/null 2>&1; then
  print -u2 "Install overmind or foreman to run multiple processes."
  exit 1
fi

if command -v overmind >/dev/null 2>&1; then
  exec overmind start -f Procfile.dev "$@"
else
  exec foreman start -f Procfile.dev "$@"
fi
