diff --git a/MASTER/lib/operator/law_inventory.rb b/MASTER/lib/operator/law_inventory.rb
index a9f6aab..7a84161 100644
--- a/MASTER/lib/operator/law_inventory.rb
+++ b/MASTER/lib/operator/law_inventory.rb
@@ -221,7 +221,14 @@ module Operator
     def rule_dependencies
       raw = Master.load_laws(root: MASTER)
       deps = raw["law_deps"] || {}
-      return deps.transform_keys { |key| key.to_s.downcase }.transform_values { |value| Array(value).map(&:to_s) } if deps.is_a?(Hash)
+      if deps.is_a?(Hash)
+        return deps.transform_keys { |key| key.to_s.downcase }.transform_values do |value|
+          # Entries are { "after" => [...] }; Array(hash) would yield key-value
+          # pairs, so the old Array(value) rendered every dependency list as
+          # stringified Ruby pairs in `laws --card`. Bare arrays pass through.
+          Array(value.is_a?(Hash) ? value["after"] : value).map(&:to_s)
+        end
+      end
 
       {}
     rescue StandardError
diff --git a/MASTER/test/test_law_inventory.rb b/MASTER/test/test_law_inventory.rb
index 7a4b7f9..006e264 100644
--- a/MASTER/test/test_law_inventory.rb
+++ b/MASTER/test/test_law_inventory.rb
@@ -81,4 +81,29 @@ class TestLawInventory < Minitest::Test
     assert_operator matrix.size, :>, 5
     assert matrix.all? { |row| row[:persona] && row[:axes] && row[:rules] }
   end
+
+  # law_deps entries are { "after" => [...] } mappings. Array(hash) yields
+  # key-value pairs, so the previous transform returned stringified pairs
+  # and every law's dependencies read as Ruby syntax instead of Law ids.
+  def test_rule_dependencies_returns_the_after_list_not_stringified_pairs
+    document = {
+      "law_deps" => {
+        "MERGE" => { "after" => %w[HOIST FLATTEN] },
+        "DECOUPLE" => { "after" => ["FLATTEN"] },
+      },
+    }
+    Master.stub(:load_laws, ->(root:) { document }) do
+      deps = Operator::LawInventory.rule_dependencies
+      assert_equal %w[HOIST FLATTEN], deps.fetch("merge")
+      assert_equal ["FLATTEN"], deps.fetch("decouple")
+      assert deps.values.flatten.all? { |dep| dep.match?(/\A[A-Z_]+\z/) }
+    end
+  end
+
+  def test_rule_dependencies_tolerates_bare_array_entries
+    document = { "law_deps" => { "MERGE" => %w[HOIST] } }
+    Master.stub(:load_laws, ->(root:) { document }) do
+      assert_equal %w[HOIST], Operator::LawInventory.rule_dependencies.fetch("merge")
+    end
+  end
 end
