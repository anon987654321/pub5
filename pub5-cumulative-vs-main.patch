+# frozen_string_literal: true
+
+require_relative "test_helper"
+require_relative "../lib/voice/speech_worker"
+
+# The one-shot TTS worker re-execs MASTER, so its stderr opens with deps0:
+# boot lines that buried the real cause in the operator's error (2026-11-23).
+class TestSpeechWorkerFailureDetail < Minitest::Test
+  Host = Class.new { include Master::Voice::SpeechWorker }
+
+  def detail(err) = Host.new.send(:worker_failure_detail, err)
+
+  def test_boot_banner_lines_are_dropped_when_the_cause_follows
+    err = "deps0: bundle ok\ndeps0: bundle ok\ntts0: one-shot synthesis produced no audio\n"
+    assert_equal "tts0: one-shot synthesis produced no audio", detail(err)
+  end
+
+  def test_a_bare_deps0_failure_is_the_cause_and_stays
+    assert_equal "deps0: gem missing", detail("deps0: gem missing\n")
+  end
+
+  def test_empty_stderr_stays_empty
+    assert_equal "", detail(nil)
+  end
+end
diff --git a/MASTER/test/test_token_guard.rb b/MASTER/test/test_token_guard.rb
new file mode 100644
index 0000000..294195a
--- /dev/null
+++ b/MASTER/test/test_token_guard.rb
@@ -0,0 +1,59 @@
+# frozen_string_literal: true
+
+require_relative "test_helper"
+require_relative "../tools/token_guard"
+require "open3"
+require "tmpdir"
+
+# A PAT pasted into chat on 2026-11-23 had nothing between it and a commit. The
+# fake credentials below are assembled at run time so this file never carries a
+# token-shaped literal of its own.
+class TestTokenGuard < Minitest::Test
+  TOKEN = ("ghp_" + ("Qx7Lm2Vz" * 5)).freeze
+  GUARD = File.expand_path("../tools/token_guard.rb", __dir__)
+
+  def diff_adding(line, path: "scripts/deploy.sh", start: 10)
+    "diff --git a/#{path} b/#{path}\n--- a/#{path}\n+++ b/#{path}\n@@ -1,0 +#{start},1 @@\n+#{line}\n"
+  end
+
+  def test_an_added_token_is_found_with_its_file_and_line
+    found = TokenGuard.scan(diff_adding("export GH=#{TOKEN}"))
+    assert_equal [["scripts/deploy.sh", 10, "GitHub token"]], found.map { |f| [f.path, f.line, f.kind] }
+  end
+
+  def test_the_report_never_repeats_the_secret
+    found = TokenGuard.scan(diff_adding("export GH=#{TOKEN}"))
+    refute_includes TokenGuard.report(found), TOKEN
+  end
+
+  def test_removed_and_context_lines_are_not_read
+    diff = "+++ b/a.rb\n@@ -1,2 +1,1 @@\n-token #{TOKEN}\n #{TOKEN}\n"
+    assert_empty TokenGuard.scan(diff)
+  end
+
+  def test_obvious_placeholders_pass_like_the_scanner_fixtures
+    ["ghp_abcdefghijklmnopqrstuvwxyz123456", "ghp_#{'a' * 36}", "ghp_EXAMPLE#{'Z9' * 10}"].each do |fake|
+      assert_empty TokenGuard.scan(diff_adding(fake)), fake
+    end
+  end
+
+  def test_other_credential_shapes_are_found
+    assert_equal ["private key block"], TokenGuard.scan(diff_adding("-----BEGIN RSA " + "PRIVATE KEY-----")).map(&:kind)
+    assert_equal ["Anthropic key"], TokenGuard.scan(diff_adding("k=sk-ant-#{'Rt4Yp8Ks' * 5}")).map(&:kind)
+  end
+
+  def test_the_cli_refuses_a_staged_token_and_the_override_allows_it
+    Dir.mktmpdir do |dir|
+      run = ->(*cmd, env: {}) { Open3.capture3(env, *cmd, chdir: dir) }
+      run.call("git", "init", "-q")
+      File.write(File.join(dir, "env.sh"), "GH=#{TOKEN}\n")
+      run.call("git", "add", "env.sh")
+      _o, err, status = run.call(RbConfig.ruby, GUARD)
+      refute status.success?
+      assert_match(/env\.sh:1/, err)
+      refute_includes err, TOKEN
+      _o, _e, status = run.call(RbConfig.ruby, GUARD, env: { "PUB5_ALLOW_TOKEN_SHAPE" => "1" })
+      assert status.success?
+    end
+  end
+end
diff --git a/MASTER/test/test_visual_register.rb b/MASTER/test/test_visual_register.rb
new file mode 100644
index 0000000..3fd29af
--- /dev/null
+++ b/MASTER/test/test_visual_register.rb
@@ -0,0 +1,184 @@
+# frozen_string_literal: true
+
+require_relative "test_helper"
+require "tmpdir"
+require "open3"
+require "fileutils"
+require_relative "../checks/support/visual_register"
+
+class TestVisualRegister < Minitest::Test
+  # Tiny in-memory PNGs through PngDiff's own codec: the composite modes are
+  # pure pixel functions, so exact byte-level assertions pin them without a
+  # browser ever opening.
+  def write_png(dir, name, width, height, pixels)
+    path = File.join(dir, name)
+    File.binwrite(path, Deploy::PngDiff.encode_rgba(width, height, pixels.flatten.pack("C*")))
+    path
+  end
+
+  def pixel(path, x, y)
+    img = Deploy::PngDiff.decode(File.binread(path))
+    row_bytes = img[:width] * img[:channels]
+    row = previous = Array.new(row_bytes, 0)
+    (y + 1).times do |yy|
+      line = img[:raw].byteslice(yy * (row_bytes + 1), row_bytes + 1)
+      row = Deploy::PngDiff.unfilter_row(line, previous:, channels: img[:channels])
+      previous = row
+    end
+    i = x * img[:channels]
+    [row[i], row[i + 1], row[i + 2]]
+  end
+
+  def solid(dir, name, rgb, width: 2, height: 2)
+    write_png(dir, name, width, height, Array.new(width * height) { rgb + [255] })
+  end
+
+  def test_anaglyph_of_identical_captures_reads_gray
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [10, 200, 90])
+      out = File.join(dir, "out.png")
+      result = Deploy::VisualRegister.composite(a_path: a, b_path: a, mode: "anaglyph", out_path: out)
+      assert_equal :composited, result[:status]
+      assert_equal [10, 200, 90], pixel(out, 0, 0)
+      assert_equal [10, 200, 90], pixel(out, 1, 1)
+    end
+  end
+
+  def test_anaglyph_keeps_a_in_red_and_b_in_cyan
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [255, 0, 0])
+      b = solid(dir, "b.png", [0, 0, 255])
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "anaglyph", out_path: out)
+      assert_equal [255, 0, 255], pixel(out, 0, 0) # red from A, green+blue from B
+    end
+  end
+
+  def test_difference_is_black_where_identical_and_amplified_where_not
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [100, 100, 100])
+      b = solid(dir, "b.png", [110, 90, 100])
+      same = File.join(dir, "same.png")
+      drift = File.join(dir, "drift.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: a, mode: "difference", out_path: same)
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "difference", out_path: drift, amplify: 4)
+      assert_equal [0, 0, 0], pixel(same, 1, 1)
+      assert_equal [40, 40, 0], pixel(drift, 1, 1)
+    end
+  end
+
+  def test_difference_clamps_instead_of_wrapping
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [255, 0, 0])
+      b = solid(dir, "b.png", [0, 0, 0])
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "difference", out_path: out, amplify: 4)
+      assert_equal [255, 0, 0], pixel(out, 0, 0) # 255 * 4 would wrap without the clamp
+    end
+  end
+
+  def test_overlay_blends_half_and_half
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 100, 200])
+      b = solid(dir, "b.png", [100, 100, 100])
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "overlay", out_path: out)
+      assert_equal [50, 100, 150], pixel(out, 1, 0)
+    end
+  end
+
+  def test_checkerboard_alternates_per_tile
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [255, 0, 0], width: 2, height: 2)
+      b = solid(dir, "b.png", [0, 0, 255], width: 2, height: 2)
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "checkerboard", out_path: out, tile: 1)
+      assert_equal [255, 0, 0], pixel(out, 0, 0)
+      assert_equal [0, 0, 255], pixel(out, 1, 0)
+      assert_equal [0, 0, 255], pixel(out, 0, 1)
+      assert_equal [255, 0, 0], pixel(out, 1, 1)
+    end
+  end
+
+  def test_dimension_mismatch_refuses_to_guess
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 0, 0], width: 2, height: 2)
+      b = solid(dir, "b.png", [0, 0, 0], width: 4, height: 2)
+      result = Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "anaglyph",
+                                                out_path: File.join(dir, "out.png"))
+      assert_equal :dimension_mismatch, result[:status]
+      assert_nil result[:composite_image]
+    end
+  end
+
+  def test_unknown_mode_is_refused
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 0, 0])
+      assert_raises(ArgumentError) do
+        Deploy::VisualRegister.composite(a_path: a, b_path: a, mode: "sepia", out_path: File.join(dir, "o.png"))
+      end
+    end
+  end
+
+  def test_grid_overlay_tints_lines_and_leaves_interiors
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 0, 0], width: 4, height: 4)
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.grid_overlay(capture_path: a, out_path: out, spacing: 2)
+      on_line = pixel(out, 1, 0) # y == 0 is a (major) grid line over black
+      off_line = pixel(out, 1, 1)
+      assert_equal [0, 0, 0], off_line
+      assert_equal 0, on_line[0]
+      assert_operator on_line[1], :>, 0 # cyan ink, green/blue channels only
+      assert_equal on_line[1], on_line[2]
+    end
+  end
+
+  # The shipped bug lived in the command line, not the library: flags were never
+  # captured (--out "required" on every call) and a private PngDiff method was
+  # called. These run the real executable so both stay caught.
+  BIN = File.expand_path("../bin/visual-register", __dir__)
+
+  def cli(*args)
+    Open3.capture3(RbConfig.ruby, BIN, *args)
+  end
+
+  def test_cli_writes_the_composite_to_out_and_honors_amplify
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [10, 10, 10])
+      b = solid(dir, "b.png", [12, 10, 10])
+      weak = File.join(dir, "weak.png")
+      strong = File.join(dir, "strong.png")
+      _o, err, status = cli(a, b, "--mode", "difference", "--amplify", "1", "--out", weak)
+      assert status.success?, err
+      _o, err, status = cli(a, b, "--mode", "difference", "--amplify", "4", "--out", strong)
+      assert status.success?, err
+      assert_equal [2, 0, 0], pixel(weak, 0, 0)
+      assert_equal [8, 0, 0], pixel(strong, 0, 0)
+    end
+  end
+
+  def test_cli_grid_flag_reaches_the_grid_path
+    Dir.mktmpdir do |dir|
+      shot = solid(dir, "shot.png", [200, 10, 10], width: 8, height: 8)
+      out = File.join(dir, "grid.png")
+      _o, err, status = cli(shot, "--grid", "--spacing", "4", "--out", out)
+      assert status.success?, err
+      refute_equal [200, 10, 10], pixel(out, 0, 0), "grid line should tint the corner"
+      assert_equal [200, 10, 10], pixel(out, 1, 1)
+    end
+  end
+
+  def test_cli_exit_codes_for_missing_out_unknown_mode_and_mismatch
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [1, 2, 3])
+      big = solid(dir, "big.png", [1, 2, 3], width: 4, height: 4)
+      out = File.join(dir, "o.png")
+      refute cli(a, a)[2].success?
+      refute cli(a, a, "--mode", "nope", "--out", out)[2].success?
+      _o, err, status = cli(a, big, "--out", out)
+      assert_equal 1, status.exitstatus
+      assert_match(/dimensions differ/, err)
+    end
+  end
+end
diff --git a/MASTER/tools/token_guard.rb b/MASTER/tools/token_guard.rb
new file mode 100644
index 0000000..c8bf232
--- /dev/null
+++ b/MASTER/tools/token_guard.rb
@@ -0,0 +1,84 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+# Refuse a commit or push whose ADDED lines carry a real-looking credential.
+#
+# A GitHub PAT was pasted into a chat on 2026-11-23, and the handoff notes record
+# the same thing happening before. The runtime redactor scrubs logs; nothing
+# stopped a token from being committed. This reads only what a change adds, so
+# an old fixture is never re-flagged, and it never prints the token it found.
+#
+#   token_guard.rb              scan the staged diff        (pre-commit)
+#   token_guard.rb --range A..B scan the commits in a range (pre-push)
+#
+# Obvious placeholders (alphabet runs, repeated characters, EXAMPLE/FAKE) pass,
+# which is what the scanner fixtures in this repo use. PUB5_ALLOW_TOKEN_SHAPE=1
+# says "I looked, it is not a credential" for the one case this misjudges.
+
+module TokenGuard
+  Finding = Data.define(:path, :line, :kind)
+
+  PATTERNS = {
+    "GitHub token" => /\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}\b/,
+    "GitHub fine-grained token" => /\bgithub_pat_[A-Za-z0-9_]{30,}\b/,
+    "Anthropic key" => /\bsk-ant-[A-Za-z0-9_-]{30,}/,
+    "API key" => /\bsk-[A-Za-z0-9]{32,}\b/,
+    "AWS access key" => /\bAKIA[0-9A-Z]{16}\b/,
+    "private key block" => /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/,
+  }.freeze
+
+  PLACEHOLDER = /abcdefghijklm|0123456789|(.)\1{7,}|example|fake|dummy|redacted|your[_-]?(?:token|key)|<[^>]+>/i
+
+  module_function
+
+  def placeholder?(text) = text.match?(PLACEHOLDER)
+
+  # diff is unified-diff text; only lines it adds are read.
+  def scan(diff)
+    path = nil
+    line_no = 0
+    findings = []
+    diff.each_line do |raw|
+      case raw
+      when /\A\+\+\+ b\/(.*)/ then path = Regexp.last_match(1).strip
+      when /\A@@ -\S+ \+(\d+)/ then line_no = Regexp.last_match(1).to_i - 1
+      when /\A\+(?!\+\+)/
+        line_no += 1
+        text = raw[1..]
+        PATTERNS.each do |kind, pattern|
+          hit = text[pattern]
+          findings << Finding.new(path: path.to_s, line: line_no, kind:) if hit && !placeholder?(hit)
+        end
+      when /\A[ ]/ then line_no += 1
+      end
+    end
+    findings
+  end
+
+  def report(findings)
+    findings.map { |f| "  #{f.path}:#{f.line}  #{f.kind}" }.join("\n")
+  end
+end
+
+if $PROGRAM_NAME == __FILE__
+  exit 0 if ENV["PUB5_ALLOW_TOKEN_SHAPE"] == "1"
+
+  diff =
+    if ARGV.first == "--range"
+      IO.popen(["git", "log", "-p", "--format=", "-U0", ARGV.fetch(1)], err: File::NULL, &:read)
+    else
+      IO.popen(%w[git diff --cached -U0 --no-color], &:read)
+    end
+  findings = TokenGuard.scan(diff.to_s.dup.force_encoding(Encoding::UTF_8).scrub)
+  exit 0 if findings.empty?
+
+  warn ""
+  warn "token-guard: REFUSED - #{findings.size} added line(s) look like a real credential:"
+  warn TokenGuard.report(findings)
+  warn ""
+  warn "  Remove it and rotate it if it was ever pasted anywhere. Revoke on GitHub first;"
+  warn "  history rewrites do not un-leak a token. If it is a placeholder this misjudged:"
+  warn "  PUB5_ALLOW_TOKEN_SHAPE=1 git commit ..."
+  warn ""
+  exit 1
+end
