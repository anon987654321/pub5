+      # The holdout set is the independent likeness evidence: approved
+      # photographs of the subject that never entered the training dataset, so
+      # a likeness verdict against them measures generalisation rather than
+      # recall of training data. Absence is a warning (review falls back to
+      # training-set references, which proves less); contamination is a FAIL,
+      # because a photograph present in both places turns the review into the
+      # model grading its own homework. Compare content hashes, not names: a
+      # copied file under a new name is still contamination.
+      def validate_holdout(report, directory)
+        holdout = File.join(directory, HOLDOUT_PATH)
+        unless File.exist?(holdout) || File.symlink?(holdout)
+          report["warnings"] << "No holdout set: likeness review falls back to training-set references, so generalisation is UNPROVEN"
+          return
+        end
+        if File.symlink?(holdout) || !File.directory?(holdout)
+          fail_check(report, "holdout_path", "Holdout path must be a real directory, never a symlink")
+          return
+        end
+
+        stat = File.lstat(holdout)
+        unless stat.uid == Process.uid && (stat.mode & 0o077).zero?
+          fail_check(report, "holdout_permissions", "Holdout directory must be owned by the current user and owner-only (0700)")
+          return
+        end
+
+        real = File.realpath(holdout)
+        unless inside?(real, File.realpath(directory))
+          fail_check(report, "holdout_path_scope", "Holdout resolves outside this subject's private directory")
+          return
+        end
+
+        insecure = []
+        hashes = {}
+        Dir.children(real).sort.each do |name|
+          next unless IMAGE_EXTENSIONS.include?(File.extname(name).downcase)
+
+          path = File.join(real, name)
+          file_stat = File.lstat(path)
+          unless file_stat.file? && !file_stat.symlink? && file_stat.uid == Process.uid &&
+                 file_stat.nlink == 1 && (file_stat.mode & 0o077).zero? && file_stat.size.positive?
+            insecure << name
+            next
+          end
+          hashes[Digest::SHA256.file(path).hexdigest] = name
+        rescue SystemCallError
+          insecure << name
+        end
+        if insecure.any?
+          fail_check(report, "holdout_image_permissions", "Holdout images must be regular, singly-linked, owner-only (0600) files: #{insecure.first(5).join(", ")}")
+          return
+        end
+
+        if hashes.length < HOLDOUT_MIN_IMAGES
+          block(report, "holdout_image_count", "Holdout has #{hashes.length} usable images; at least #{HOLDOUT_MIN_IMAGES} are required for an independent likeness review")
+          return
+        end
+
+        dataset = File.join(directory, TRAINING_STANDARD.fetch("dataset").fetch("path"))
+        contaminated = []
+        if File.directory?(dataset) && !File.symlink?(dataset)
+          Dir.children(File.realpath(dataset)).sort.each do |name|
+            next unless IMAGE_EXTENSIONS.include?(File.extname(name).downcase)
+
+            path = File.join(File.realpath(dataset), name)
+            next unless File.file?(path) && !File.symlink?(path)
+
+            digest = Digest::SHA256.file(path).hexdigest
+            contaminated << "#{name} == holdout/#{hashes[digest]}" if hashes.key?(digest)
+          rescue SystemCallError
+            nil
+          end
+        end
+        if contaminated.any?
+          fail_check(report, "holdout_separation", "Holdout photographs also present in the training dataset: #{contaminated.first(5).join(", ")}")
+        else
+          pass_check(report, "holdout_separation", "#{hashes.length} holdout photographs are content-distinct from the training dataset")
+        end
+      end
