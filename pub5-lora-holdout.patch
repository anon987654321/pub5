+# frozen_string_literal: true
+
+require "fileutils"
+require "minitest/autorun"
+require "tmpdir"
+require_relative "../../STUDIO/lora/validate"
+
+# The holdout set is the independent likeness evidence: approved photographs
+# that never entered training. These tests pin the three outcomes that matter:
+# absence is a warning with an honest UNPROVEN generalisation status, too few
+# images blocks, and content overlap with the dataset is a FAIL.
+class TestLoraHoldout < Minitest::Test
+  def setup
+    @root = Dir.mktmpdir("lora-holdout-test-")
+    @subject = File.join(@root, "merethe")
+    FileUtils.mkdir_p(@subject)
+    File.chmod(0o700, @subject)
+    @validator = Studio::Lora::Validator.new(root: @root)
+  end
+
+  def teardown
+    FileUtils.remove_entry(@root)
+  end
+
+  def test_missing_holdout_warns_without_blocking
+    report = fresh_report
+    @validator.send(:validate_holdout, report, @subject)
+
+    assert_empty report["blockers"]
+    assert_equal 1, report["warnings"].length
+    assert_includes report["warnings"].first, "UNPROVEN"
+  end
+
+  def test_holdout_below_minimum_blocks
+    write_images(File.join(@subject, "holdout"), %w[a.jpg b.jpg])
+    report = fresh_report
+    @validator.send(:validate_holdout, report, @subject)
+
+    assert_equal %w[holdout_image_count], report["blockers"].map { |item| item["id"] }
+  end
+
+  def test_distinct_holdout_and_dataset_passes_separation
+    write_images(File.join(@subject, "holdout"), %w[a.jpg b.jpg c.jpg])
+    write_images(File.join(@subject, "dataset"), %w[x.jpg y.jpg z.jpg])
+    report = fresh_report
+    @validator.send(:validate_holdout, report, @subject)
+
+    assert_empty report["blockers"]
+    check = report["checks"].find { |item| item["id"] == "holdout_separation" }
+    assert_equal "PASS", check["state"]
+  end
+
+  def test_contaminated_holdout_fails_even_when_renamed
+    holdout_dir = write_images(File.join(@subject, "holdout"), %w[a.jpg b.jpg c.jpg])
+    dataset_dir = write_images(File.join(@subject, "dataset"), %w[x.jpg y.jpg z.jpg])
+    # The same bytes under a different name is still contamination.
+    FileUtils.cp(File.join(holdout_dir, "b.jpg"), File.join(dataset_dir, "renamed.jpg"))
+    File.chmod(0o600, File.join(dataset_dir, "renamed.jpg"))
+
+    report = fresh_report
+    @validator.send(:validate_holdout, report, @subject)
+
+    contamination = report["blockers"].find { |item| item["id"] == "holdout_separation" }
+    refute_nil contamination
+    assert_equal "FAIL", report["state"]
+    assert_includes contamination["detail"], "renamed.jpg"
+  end
+
+  def test_symlinked_holdout_is_refused
+    target = File.join(@root, "elsewhere")
+    FileUtils.mkdir_p(target)
+    File.symlink(target, File.join(@subject, "holdout"))
+
+    report = fresh_report
+    @validator.send(:validate_holdout, report, @subject)
+
+    assert_equal %w[holdout_path], report["blockers"].map { |item| item["id"] }
+    assert_equal "FAIL", report["state"]
+  end
+
+  private
+
+  def fresh_report
+    { "state" => "PASS", "checks" => [], "blockers" => [], "warnings" => [] }
+  end
+
+  def write_images(directory, names)
+    FileUtils.mkdir_p(directory)
+    File.chmod(0o700, directory)
+    names.each_with_index do |name, index|
+      path = File.join(directory, name)
+      File.binwrite(path, "image-bytes-#{directory}-#{name}-#{index}")
+      File.chmod(0o600, path)
+    end
+    directory
+  end
+end
