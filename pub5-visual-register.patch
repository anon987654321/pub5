+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+# Composite two captures into review evidence, or lay the rhythm grid over
+# one. No browser, no gems beyond zlib - PngDiff owns the codec.
+#
+#   visual-register A.png B.png --mode anaglyph --out drift.png
+#   visual-register A.png B.png --mode difference --amplify 4 --out diff.png
+#   visual-register shot.png --grid --spacing 4 --out gridded.png
+#
+# Modes are documented on Deploy::VisualRegister. Captures come from the
+# existing machinery (cdp_session / capture_engine); this tool never opens a
+# page itself, so its output is reproducible from stored PNGs.
+
+require "optparse"
+require_relative "../checks/support/visual_register"
+
+options = { mode: "anaglyph", amplify: Deploy::VisualRegister::DEFAULT_AMPLIFY,
+            tile: Deploy::VisualRegister::DEFAULT_TILE, spacing: 4 }
+parser = OptionParser.new do |o|
+  o.banner = "usage: visual-register A.png [B.png] [--mode M | --grid] --out OUT.png"
+  o.on("--mode M", Deploy::VisualRegister::MODES, "composite mode (#{Deploy::VisualRegister::MODES.join(', ')})")
+  o.on("--grid", "rhythm-grid overlay over A.png (B not used)")
+  o.on("--out PATH", "output PNG (required)")
+  o.on("--amplify N", Integer, "difference amplification (default #{options[:amplify]})")
+  o.on("--tile N", Integer, "checkerboard tile px (default #{options[:tile]})")
+  o.on("--spacing N", Integer, "grid spacing px (default #{options[:spacing]})")
+end
+parser.parse!(ARGV)
+
+out = options.delete(:out)
+grid = options.delete(:grid)
+parser.abort("the --out PATH is required") unless out
+
+result =
+  if grid
+    parser.abort("--grid takes exactly one capture") unless ARGV.one?
+    Deploy::VisualRegister.grid_overlay(capture_path: ARGV.fetch(0), out_path: out, spacing: options[:spacing])
+  else
+    parser.abort("composite modes take A.png and B.png") unless ARGV.size == 2
+    Deploy::VisualRegister.composite(a_path: ARGV.fetch(0), b_path: ARGV.fetch(1),
+                                     mode: options[:mode], out_path: out,
+                                     amplify: options[:amplify], tile: options[:tile])
+  end
+
+if result[:status] == :dimension_mismatch
+  warn "visual-register: dimensions differ - A #{result[:a_dimensions].join('x')} vs B #{result[:b_dimensions].join('x')}"
+  exit 1
+end
+
+puts "visual-register: #{result[:status]} #{result[:mode] || "grid"} -> #{result[:composite_image]} (#{result[:width]}x#{result[:height]})"
diff --git a/MASTER/checks/support/visual_register.rb b/MASTER/checks/support/visual_register.rb
new file mode 100644
index 0000000..73742aa
--- /dev/null
+++ b/MASTER/checks/support/visual_register.rb
@@ -0,0 +1,144 @@
+# frozen_string_literal: true
+
+require_relative "png_diff"
+
+module Deploy
+  # Composite evidence for a pair of captures. PngDiff answers "how much
+  # changed" with a number and a red heatmap; VisualRegister answers "where do
+  # the two captures sit relative to each other" with an image a reviewer reads
+  # at a glance. Every mode is a pure pixel function over two same-size PNGs,
+  # so the instrument needs no browser and no gems beyond PngDiff's own zlib.
+  #
+  #   difference    |A-B| per channel, amplified. Identical pixels are black;
+  #                 drift lights up. Amplification makes sub-perceptual drift
+  #                 visible; the count and ratio still come from PngDiff.
+  #   anaglyph      A into the red channel, B into green+blue. Registered
+  #                 pixels read gray; drift shows as red/cyan fringes whose
+  #                 direction tells you which way B moved.
+  #   overlay       50/50 blend. Double edges mark misalignment - the onion
+  #                 skin. Fast to read, not measurable; pair with a ratio.
+  #   checkerboard  Alternating tiles of A and B. No blending, so tonal drift
+  #                 (one surface token off from another) stays visible.
+  #
+  # grid_overlay is the one-capture cousin: the rhythm grid laid over a single
+  # capture so off-rhythm edges read as lines floating between grid lines.
+  module VisualRegister
+    MODES = %w[difference anaglyph overlay checkerboard].freeze
+    MAX_PIXELS = PngDiff::MAX_PIXELS
+    DEFAULT_AMPLIFY = 4
+    DEFAULT_TILE = 32
+    # The grid reads as an instrument, not as content: hairlines at ~15%
+    # strength, every eighth line doubled so the 32px cadence is countable.
+    GRID_MINOR_ALPHA = 38
+    GRID_MAJOR_ALPHA = 76
+    GRID_COLOR = [0, 255, 255].freeze
+
+    module_function
+
+    def composite(a_path:, b_path:, mode:, out_path:, amplify: DEFAULT_AMPLIFY, tile: DEFAULT_TILE)
+      raise ArgumentError, "unknown mode #{mode.inspect} (expected one of #{MODES.join(', ')})" unless MODES.include?(mode.to_s)
+
+      a = PngDiff.decode(File.binread(a_path))
+      b = PngDiff.decode(File.binread(b_path))
+      unless a[:width] == b[:width] && a[:height] == b[:height]
+        return {
+          status: :dimension_mismatch,
+          a_dimensions: [a[:width], a[:height]],
+          b_dimensions: [b[:width], b[:height]],
+          composite_image: nil,
+        }
+      end
+
+      rgba = map_rows(a, b) do |a_px, b_px, x, y|
+        case mode.to_s
+        when "difference"   then difference_pixel(a_px, b_px, amplify)
+        when "anaglyph"     then [a_px[0], b_px[1], b_px[2], 255]
+        when "overlay"      then overlay_pixel(a_px, b_px)
+        else                     (x / tile + y / tile).even? ? opaque(a_px) : opaque(b_px)
+        end
+      end
+
+      File.binwrite(out_path, PngDiff.encode_rgba(a[:width], a[:height], rgba))
+      { status: :composited, mode: mode.to_s, width: a[:width], height: a[:height], composite_image: out_path }
+    end
+
+    # One capture under the rhythm grid. spacing is the law's unit (4px);
+    # every major_every-th line is drawn stronger so the eye can count.
+    def grid_overlay(capture_path:, out_path:, spacing: 4, major_every: 8)
+      img = PngDiff.decode(File.binread(capture_path))
+      a_ch = img[:channels]
+      a_row_bytes = img[:width] * a_ch
+      previous = Array.new(a_row_bytes, 0)
+      rgba = String.new(encoding: Encoding::BINARY)
+
+      img[:height].times do |y|
+        scanline = img[:raw].byteslice(y * (a_row_bytes + 1), a_row_bytes + 1)
+        row = PngDiff.unfilter(scanline.getbyte(0), scanline.byteslice(1, a_row_bytes), previous, a_ch)
+        img[:width].times do |x|
+          i = x * a_ch
+          line = (x % spacing).zero? || (y % spacing).zero?
+          major = (x % (spacing * major_every)).zero? || (y % (spacing * major_every)).zero?
+          alpha = line ? (major ? GRID_MAJOR_ALPHA : GRID_MINOR_ALPHA) : 0
+          rgba << blend(GRID_COLOR[0], row[i], alpha) << blend(GRID_COLOR[1], row[i + 1], alpha) <<
+                  blend(GRID_COLOR[2], row[i + 2], alpha) << 255
+        end
+        previous = row
+      end
+
+      File.binwrite(out_path, PngDiff.encode_rgba(img[:width], img[:height], rgba))
+      { status: :gridded, width: img[:width], height: img[:height], spacing:, composite_image: out_path }
+    end
+
+    def difference_pixel(a_px, b_px, amplify)
+      [
+        clamp((a_px[0] - b_px[0]).abs * amplify),
+        clamp((a_px[1] - b_px[1]).abs * amplify),
+        clamp((a_px[2] - b_px[2]).abs * amplify),
+        255,
+      ]
+    end
+
+    def overlay_pixel(a_px, b_px)
+      [(a_px[0] + b_px[0]) / 2, (a_px[1] + b_px[1]) / 2, (a_px[2] + b_px[2]) / 2, 255]
+    end
+
+    # Chromium's RGB screenshots carry no alpha byte; pretend 255 so every
+    # mode downstream has a four-element pixel to work with.
+    def opaque(px) = [px[0], px[1], px[2], 255]
+
+    def clamp(v) = v > 255 ? 255 : v
+
+    def blend(ink, under, alpha) = (ink * alpha + under * (255 - alpha)) / 255
+
+    # Walks both images row by row (unfiltering through PngDiff, never holding
+    # more than a scanline per side) and packs the yielded pixels into one
+    # RGBA buffer. Rows keep memory flat on full-viewport captures.
+    def map_rows(a, b)
+      a_ch = a[:channels]
+      b_ch = b[:channels]
+      a_row_bytes = a[:width] * a_ch
+      b_row_bytes = b[:width] * b_ch
+      a_prev = Array.new(a_row_bytes, 0)
+      b_prev = Array.new(b_row_bytes, 0)
+      out = String.new(capacity: a[:width] * a[:height] * 4, encoding: Encoding::BINARY)
+
+      a[:height].times do |y|
+        a_line = a[:raw].byteslice(y * (a_row_bytes + 1), a_row_bytes + 1)
+        b_line = b[:raw].byteslice(y * (b_row_bytes + 1), b_row_bytes + 1)
+        a_row = PngDiff.unfilter(a_line.getbyte(0), a_line.byteslice(1, a_row_bytes), a_prev, a_ch)
+        b_row = PngDiff.unfilter(b_line.getbyte(0), b_line.byteslice(1, b_row_bytes), b_prev, b_ch)
+
+        a[:width].times do |x|
+          ai = x * a_ch
+          bi = x * b_ch
+          a_px = [a_row[ai], a_row[ai + 1], a_row[ai + 2]]
+          b_px = [b_row[bi], b_row[bi + 1], b_row[bi + 2]]
+          out << yield(a_px, b_px, x, y).pack("C4")
+        end
+        a_prev = a_row
+        b_prev = b_row
+      end
+      out
+    end
+  end
+end
diff --git a/MASTER/test/test_visual_register.rb b/MASTER/test/test_visual_register.rb
new file mode 100644
index 0000000..9eff6a7
--- /dev/null
+++ b/MASTER/test/test_visual_register.rb
@@ -0,0 +1,135 @@
+# frozen_string_literal: true
+
+require_relative "test_helper"
+require "tmpdir"
+require "fileutils"
+require_relative "../checks/support/visual_register"
+
+class TestVisualRegister < Minitest::Test
+  # Tiny in-memory PNGs through PngDiff's own codec: the composite modes are
+  # pure pixel functions, so exact byte-level assertions pin them without a
+  # browser ever opening.
+  def write_png(dir, name, width, height, pixels)
+    path = File.join(dir, name)
+    File.binwrite(path, Deploy::PngDiff.encode_rgba(width, height, pixels.flatten.pack("C*")))
+    path
+  end
+
+  def pixel(path, x, y)
+    img = Deploy::PngDiff.decode(File.binread(path))
+    row_bytes = img[:width] * img[:channels]
+    row = previous = Array.new(row_bytes, 0)
+    (y + 1).times do |yy|
+      line = img[:raw].byteslice(yy * (row_bytes + 1), row_bytes + 1)
+      row = Deploy::PngDiff.unfilter_row(line, previous:, channels: img[:channels])
+      previous = row
+    end
+    i = x * img[:channels]
+    [row[i], row[i + 1], row[i + 2]]
+  end
+
+  def solid(dir, name, rgb, width: 2, height: 2)
+    write_png(dir, name, width, height, Array.new(width * height) { rgb + [255] })
+  end
+
+  def test_anaglyph_of_identical_captures_reads_gray
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [10, 200, 90])
+      out = File.join(dir, "out.png")
+      result = Deploy::VisualRegister.composite(a_path: a, b_path: a, mode: "anaglyph", out_path: out)
+      assert_equal :composited, result[:status]
+      assert_equal [10, 200, 90], pixel(out, 0, 0)
+      assert_equal [10, 200, 90], pixel(out, 1, 1)
+    end
+  end
+
+  def test_anaglyph_keeps_a_in_red_and_b_in_cyan
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [255, 0, 0])
+      b = solid(dir, "b.png", [0, 0, 255])
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "anaglyph", out_path: out)
+      assert_equal [255, 0, 255], pixel(out, 0, 0) # red from A, green+blue from B
+    end
+  end
+
+  def test_difference_is_black_where_identical_and_amplified_where_not
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [100, 100, 100])
+      b = solid(dir, "b.png", [110, 90, 100])
+      same = File.join(dir, "same.png")
+      drift = File.join(dir, "drift.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: a, mode: "difference", out_path: same)
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "difference", out_path: drift, amplify: 4)
+      assert_equal [0, 0, 0], pixel(same, 1, 1)
+      assert_equal [40, 40, 0], pixel(drift, 1, 1)
+    end
+  end
+
+  def test_difference_clamps_instead_of_wrapping
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [255, 0, 0])
+      b = solid(dir, "b.png", [0, 0, 0])
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "difference", out_path: out, amplify: 4)
+      assert_equal [255, 0, 0], pixel(out, 0, 0) # 255 * 4 would wrap without the clamp
+    end
+  end
+
+  def test_overlay_blends_half_and_half
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 100, 200])
+      b = solid(dir, "b.png", [100, 100, 100])
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "overlay", out_path: out)
+      assert_equal [50, 100, 150], pixel(out, 1, 0)
+    end
+  end
+
+  def test_checkerboard_alternates_per_tile
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [255, 0, 0], width: 2, height: 2)
+      b = solid(dir, "b.png", [0, 0, 255], width: 2, height: 2)
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "checkerboard", out_path: out, tile: 1)
+      assert_equal [255, 0, 0], pixel(out, 0, 0)
+      assert_equal [0, 0, 255], pixel(out, 1, 0)
+      assert_equal [0, 0, 255], pixel(out, 0, 1)
+      assert_equal [255, 0, 0], pixel(out, 1, 1)
+    end
+  end
+
+  def test_dimension_mismatch_refuses_to_guess
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 0, 0], width: 2, height: 2)
+      b = solid(dir, "b.png", [0, 0, 0], width: 4, height: 2)
+      result = Deploy::VisualRegister.composite(a_path: a, b_path: b, mode: "anaglyph",
+                                                out_path: File.join(dir, "out.png"))
+      assert_equal :dimension_mismatch, result[:status]
+      assert_nil result[:composite_image]
+    end
+  end
+
+  def test_unknown_mode_is_refused
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 0, 0])
+      assert_raises(ArgumentError) do
+        Deploy::VisualRegister.composite(a_path: a, b_path: a, mode: "sepia", out_path: File.join(dir, "o.png"))
+      end
+    end
+  end
+
+  def test_grid_overlay_tints_lines_and_leaves_interiors
+    Dir.mktmpdir do |dir|
+      a = solid(dir, "a.png", [0, 0, 0], width: 4, height: 4)
+      out = File.join(dir, "out.png")
+      Deploy::VisualRegister.grid_overlay(capture_path: a, out_path: out, spacing: 2)
+      on_line = pixel(out, 1, 0) # y == 0 is a (major) grid line over black
+      off_line = pixel(out, 1, 1)
+      assert_equal [0, 0, 0], off_line
+      assert_equal 0, on_line[0]
+      assert_operator on_line[1], :>, 0 # cyan ink, green/blue channels only
+      assert_equal on_line[1], on_line[2]
+    end
+  end
+end
