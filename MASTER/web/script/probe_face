#!/usr/bin/env ruby
# frozen_string_literal: true

require "shellwords"
require "timeout"
require "fileutils"
require "json"
require "base64"

URL = ARGV[0] || "http://localhost:53187/"
WAIT = Integer(ENV.fetch("PROBE_WAIT", "12"))
BROWSER_TIMEOUT = Integer(ENV.fetch("PROBE_BROWSER_TIMEOUT", "20"))
STRICT_MASKS = ENV["PROBE_MASKS"] == "1"
FORCE = ENV["PROBE_FORCE_BROWSER"] == "1" || STRICT_MASKS
VIEWPORT = ENV.fetch("PROBE_VIEWPORT", "1280,900")
raise ArgumentError, "invalid PROBE_VIEWPORT" unless VIEWPORT.match?(/\A[1-9]\d{2,3},[1-9]\d{2,3}\z/)
CHROME_PATHS = [
  ENV["CHROME_PATH"],
  "/usr/local/bin/chromium",
  "/usr/local/bin/chrome",
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "/Applications/Chromium.app/Contents/MacOS/Chromium",
].compact.freeze

def pick_chrome
  CHROME_PATHS.find { |path| File.executable?(path) }
end

def chrome_version_ok?(path, timeout_s: 3)
  Timeout.timeout(timeout_s) do
    out = `#{Shellwords.escape(path)} --version 2>/dev/null`
    !out.to_s.strip.empty?
  end
rescue Timeout::Error, StandardError
  false
end

def build_browser(path)
  require "ferrum"
  Ferrum::Browser.new(
    headless: true,
    browser_path: path,
    process_timeout: BROWSER_TIMEOUT,
    browser_options: {
      "headless" => "new",
      "window-size" => VIEWPORT,
      "no-sandbox" => nil,
      "disable-gpu" => nil,
      "disable-dev-shm-usage" => nil,
      "enable-webgl" => nil,
      "use-gl" => "swiftshader",
      "enable-unsafe-swiftshader" => nil,
      "ignore-certificate-errors" => nil,
      "remote-allow-origins" => "*",
    },
    timeout: 90,
  )
end

def skip_probe(reason)
  puts "probe: SKIP (#{reason})"
  exit(STRICT_MASKS ? 1 : 0)
end

chrome = pick_chrome
puts "probe: #{URL}"
puts "chrome: #{chrome || '(none)'}"

skip_probe("no Chrome executable — set CHROME_PATH or use probe_http") unless chrome
if RUBY_PLATFORM.include?("darwin") && !FORCE
  skip_probe("macOS headless Ferrum unreliable here — set PROBE_FORCE_BROWSER=1 to try")
end
skip_probe("Chrome --version failed — use probe_http") unless chrome_version_ok?(chrome)

browser = nil
failures = []
console_msgs = []
network_errors = []

begin
  browser = Timeout.timeout(BROWSER_TIMEOUT + 5) { build_browser(chrome) }
  width, height = VIEWPORT.split(",").map(&:to_i)
  browser.resize(width:, height:)

  browser.on(:console) { |msg| console_msgs << "[#{msg.type}] #{msg.args.map(&:value).join(' ')}" rescue nil }

  browser.network.intercept
  browser.on(:request) { |req| req.continue }
  browser.on(:response) do |res|
    s = res.status.to_i
    network_errors << "#{s} #{res.url.split('?').first.split('/').last}" if s >= 400
  end

  browser.evaluate_on_new_document(<<~JS)
    window._errs = [];
    window.onerror = function(msg, src, line) {
      window._errs.push(msg + ' @ ' + (src||'').split('/').pop() + ':' + line);
    };
    window.addEventListener('unhandledrejection', function(e) {
      window._errs.push('UNHANDLED: ' + String(e.reason));
    });
  JS

  begin
    browser.go_to URL
  rescue Ferrum::PendingConnectionsError => e
    puts "WARN: pending connections on load - #{e.message}"
  end
  puts "loaded, waiting #{WAIT}s..."
  sleep WAIT

  puts "\n=== JS errors ==="
  errs = browser.evaluate("window._errs || []") rescue []
  puts errs.empty? ? "(none)" : errs.join("\n")
  failures << "js errors present" unless errs.empty?

  puts "\n=== network errors ==="
  puts network_errors.empty? ? "(none)" : network_errors.join("\n")
  failures << "network errors present" unless network_errors.empty?

  puts "\n=== primer state ==="
  puts browser.evaluate("document.getElementById('primer') ? 'exists' : 'gone'")

  puts "\n=== simulate tap ==="
  primer = browser.evaluate("document.getElementById('primer')?.getBoundingClientRect()?.toJSON()")
  if primer && primer["width"].to_f.positive? && primer["height"].to_f.positive?
    browser.mouse.click(x: (primer["x"] + primer["width"] / 2).to_i, y: (primer["y"] + primer["height"] / 2).to_i)
  else
    failures << "primer has no visible hit target"
  end
  sleep 8

  state = browser.evaluate(<<~JS) rescue {}
    ({
      primerFired: !!window._primerFired,
      primerGone: !document.getElementById('primer'),
      faceSession: document.body.classList.contains('face-session'),
      zshLive: document.getElementById('prompt-form').classList.contains('live'),
      uiStatus: (document.getElementById('ui-status') || {}).textContent || '',
      faceType: typeof window.MASTER_FACE,
      errs: window._errs || []
    })
  JS

  puts "state: #{state.inspect}"
  failures << "primer not fired" unless state["primerFired"]
  failures << "primer still visible" unless state["primerGone"]
  failures << "face-session missing" unless state["faceSession"]
  failures << "zsh not live" unless state["zshLive"]

  deadline = Time.now + 60
  until state["faceType"] == "object" || Time.now > deadline
    sleep 2
    state["faceType"] = browser.evaluate("typeof window.MASTER_FACE") rescue "undefined"
  end
  failures << "MASTER_FACE missing after 60s" unless state["faceType"] == "object"

  if STRICT_MASKS && failures.empty?
    target = File.expand_path(ENV.fetch("PROBE_MASK_DIR", "tmp/mask-probe"))
    FileUtils.mkdir_p(target)
    profiles = browser.evaluate("window.MASTER_FACE_MASKS.profiles.map(p => p.id)")
    original = browser.evaluate("window.MASTER_FACE_MASKS.current().id")
    receipts = []
    angles = { "front" => 0, "three-quarter" => Math::PI / 4, "profile" => Math::PI / 2, "rear" => Math::PI }
    failures << "empty sculpture catalogue" if profiles.empty?
    expected_points = nil
    profiles.each do |profile|
      selected = browser.evaluate("window.MASTER_FACE_MASKS.select(#{profile.to_json})")
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 12
      settled = false
      consecutive = 0
      until Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
        stable = browser.evaluate("Math.abs(window.MASTER_FACE?.morphCurrent) <= 0.002 && Math.abs(window.MASTER_FACE?.faceMat?._morphVel || 0) <= 0.002 && document.documentElement.dataset.faceSubjectRenderer === 'primary-points'")
        consecutive = stable ? consecutive + 1 : 0
        settled = consecutive >= 3
        break if settled
        sleep 0.1
      end
      receipt = browser.evaluate(<<~JS)
        (() => {
          const master = window.MASTER_FACE;
          const face = document.getElementById('face');
          const log = document.getElementById('chat-shell');
          const f = face.getBoundingClientRect(), l = log.getBoundingClientRect();
          const gl = master.renderer?.getContext();
          return { profile: document.documentElement.dataset.maskProfile,
            points: (master.faceScatter?.length || 0) / 3,
            fps: window.MasterRenderPolicy?.snapshot?.().fps ?? null,
            sculpture: master.faceMat?.uniforms?.uSculpture?.value === 1,
            gpu: master.faceMat?.isShaderMaterial === true,
            context_lost: !gl || gl.isContextLost(),
            width: f.width, height: f.height, disjoint: f.bottom <= l.top + 1,
            viewport: [innerWidth, innerHeight], dpr: devicePixelRatio,
            reduced_motion: matchMedia('(prefers-reduced-motion: reduce)').matches };
        })()
      JS
      receipt["settled"] = settled
      receipt["selected"] = selected
      expected_points ||= receipt["points"]
      failures << "sculpture #{profile} failed integration" unless selected && settled &&
        receipt["profile"] == profile && receipt["points"].to_i.positive? &&
        receipt["points"] == expected_points && receipt["disjoint"] &&
        receipt["sculpture"] && receipt["gpu"] && !receipt["context_lost"]
      browser.screenshot(path: File.join(target, "#{profile}.png"))

      # Capture the real production scene and shader from controlled viewpoints,
      # synchronously before the next frame can overwrite the rotation.
      receipt["angles"] = angles.map do |name, yaw|
        capture = browser.evaluate(<<~JS)
          (() => {
            const { renderer, scene, camera, head, faceMat } = window.MASTER_FACE;
            const rotation = head.rotation.clone(), cameraPosition = camera.position.clone();
            const cameraRotation = camera.quaternion.clone(), scale = head.scale.clone();
            const motion = faceMat.uniforms.uSculptureMotion;
            const priorMotion = motion.value, autoClear = renderer.autoClear;
            const gl = renderer.getContext();
            try {
              motion.value = 0;
              head.rotation.set(0, #{yaw}, 0);
              head.scale.setScalar(1);
              camera.position.set(0, 0, cameraPosition.length());
              camera.lookAt(0, 0, 0);
              renderer.autoClear = true;
              const start = performance.now();
              renderer.render(scene, camera);
              gl.finish();
              const render_ms = performance.now() - start;
              const canvas = renderer.domElement, copy = document.createElement('canvas');
              copy.width = canvas.width; copy.height = canvas.height;
              const ctx = copy.getContext('2d', { willReadFrequently: true });
              ctx.drawImage(canvas, 0, 0);
              const pixels = ctx.getImageData(0, 0, copy.width, copy.height).data;
              let ink = 0, chromatic = 0, min = 255, max = 0;
              for (let i = 0; i < pixels.length; i += 4) {
                const r = pixels[i], g = pixels[i+1], b = pixels[i+2];
                const high = Math.max(r,g,b), low = Math.min(r,g,b);
                if (high < 32) continue;
                ink++;
                if (high-low > 2) chromatic++;
                min = Math.min(min,low); max = Math.max(max,high);
              }
              return { png: copy.toDataURL('image/png').split(',')[1],
                ink, chromatic, min, max, render_ms, gl_error: gl.getError(),
                width: copy.width, height: copy.height,
                drawn_points: renderer.info?.render?.points ?? null };
            } finally {
              motion.value = priorMotion;
              head.rotation.copy(rotation); head.scale.copy(scale);
              camera.position.copy(cameraPosition); camera.quaternion.copy(cameraRotation);
              renderer.autoClear = autoClear;
            }
          })()
        JS
        File.binwrite(File.join(target, "#{profile}-#{name}.png"), Base64.strict_decode64(capture.delete("png")))
        capture["angle"] = name
        coverage = capture["ink"].to_f / [capture["width"] * capture["height"], 1].max
        capture["coverage"] = coverage
        failures << "sculpture #{profile}/#{name} failed pixel check" unless
          coverage.between?(0.0002, 0.35) && capture["chromatic"].zero? &&
          capture["max"] - capture["min"] <= 3 && capture["gl_error"].zero?
        if capture["drawn_points"] && capture["drawn_points"] != expected_points
          failures << "sculpture #{profile}/#{name} draws competing carriers"
        end
        capture
      end
      receipts << receipt
    end
    browser.evaluate("window.MASTER_FACE_MASKS.select(#{original.to_json})")
    failures << "late JS errors present" unless browser.evaluate("window._errs || []").empty?
    failures << "late network errors present" unless network_errors.empty?
    failures << "shader compilation errors present" if console_msgs.any? { |line| line.match?(/shader error|VALIDATE_STATUS false|GL_INVALID_OPERATION/i) }
    File.write(File.join(target, "receipts.json"), JSON.pretty_generate(receipts) + "\n")
    puts "mask probe: #{receipts.size} sculptures, #{receipts.sum { |r| r.fetch("angles").size }} viewpoints, #{target}"
  end

  puts "\n=== console log tail ==="
  puts console_msgs.last(10).join("\n") unless console_msgs.empty?
rescue Timeout::Error => e
  skip_probe("browser launch timeout (#{e.class}) — use probe_http")
rescue StandardError => e
  if e.class.name == "Ferrum::ProcessTimeoutError"
    skip_probe("browser launch timeout (Ferrum) — use probe_http")
  end
  failures << "probe exception: #{e.class}: #{e.message}"
  puts "probe error: #{e.class}: #{e.message}"
  puts e.backtrace.first(3).join("\n")
ensure
  browser&.quit
end

if failures.empty?
  puts "\nprobe: PASS"
  exit 0
else
  puts "\nprobe: FAIL"
  failures.each { |f| puts "  - #{f}" }
  exit 1
end
