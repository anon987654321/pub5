<div class="ghostty-viewport">
  <div class="ghostty-header">
    <div id="pixel-face-container" class="master-pixel-face"></div>
    <div style="color: #666666; font-size: 12px; margin-top: 6px;">
      OpenBSD 7.6-current (GENERIC.MP) #0: master_web0 ttyWeb0
    </div>
  </div>

  <div id="terminal-scroll-container">
    <!-- VirtualTerminal mounts here -->
  </div>

  <div class="ghostty-input-row">
    <span class="prompt-token" id="prompt-label">master: ~ $</span>
    <input type="text" id="web-input" class="ghostty-input" autofocus autocomplete="off" spellcheck="false" />
  </div>
</div>
