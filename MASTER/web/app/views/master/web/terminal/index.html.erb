<main class="ghostty-viewport">
  <header class="ghostty-header">
    <div id="pixel-face-container" class="master-pixel-face" aria-hidden="true"></div>
    <p class="ghostty-banner"><%= @dmesg_header %></p>
  </header>

  <div id="terminal-scroll-container" role="log" aria-live="polite"></div>

  <div class="ghostty-input-row">
    <label class="prompt-token" for="web-input">master: ~ $</label>
    <input type="text" id="web-input" class="ghostty-input" autofocus autocomplete="off"
           autocapitalize="off" spellcheck="false" enterkeyhint="send">
  </div>
</main>
