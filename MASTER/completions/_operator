#compdef operator

# bin/operator's subcommands, one line each. test/test_completions.rb fails when
# this list and the `when` branches in bin/operator differ.
_operator() {
  local -a commands
  commands=(
    'affiliate:permissioned Tradedoubler Claims API read, prepare and confirmed submit'
    'branches:classify branches against main and report merge/delete candidates'
    'brief:the authority chain, the mechanical guards and the top-ranked Laws, before the first edit'
    'check:every declared check in the repo, fixing as it goes'
    'ci:every RAILS app'\''s bin/ci'
    'cities:the RAILS city pages, from the local source'
    'coverage:the RAILS coverage run'
    'deploy-story:what the OPENBSD deploy actually did, step by step'
    'design:screenshot, edit one layout rule, keep it only if it measures better'
    'doctor:the environment traps, checked in seconds'
    'domain-ghosts:OPENBSD domains that answer but have no live site'
    'event-bus:census Ruby publishers and subscribers and browser events'
    'fix:/fix runs, queue, pass, logs and commits, read-only'
    'hooks:install the shared-tree commit guard'
    'land:commit path-scoped, re-check, push current branch'
    'law-weight:Ruby-line mass of each Law file, largest last'
    'laws:one law, its exemption, and what it finds'
    'lint:judge files by the law, no model'
    'measure:every ratchet, current against ceiling'
    'memory:record a reviewed verdict on a memory entry'
    'post-pull:the checklist after a pull'
    'premerge:the RAILS premerge proof'
    'push:replay unpublished main commits onto a moved origin/main and push'
    'pushed?:is this content on origin/main'
    'readers:who reaches this file, across all four governed trees'
    'snapshot:regenerate the snapshot packs'
    'spark:a high-creativity orientation without a model'
    'status:what is dirty, per tree'
    'test:smallest complete proof for the paths'
    'tree-weight:tracked-file counts per tree, from git ls-files'
    'triangle:boot brgen, amber, bsdports and the master face locally'
    'visual:read-only rendered review and local seed content'
    'vps:state, deploy, logs or admin on the box'
    'wishlist:the current bounded next-work queue'
  )

  _arguments -C '1: :->command' '*:: :->args'

  case $state in
    command) _describe 'operator commands' commands ;;
  esac
}

_operator "$@"
