#!/usr/bin/env ruby
# frozen_string_literal: true

# MASTER on the phone. Ruby rather than zsh, because Termux ships ruby as a
# required package and zsh only as an optional one.
#
#   bin/master-mobile doctor    what the phone has and lacks, as JSON; exit 0 only when ready
#   bin/master-mobile bridge    the face at http://127.0.0.1:8765/face, on Falcon
#   bin/master-mobile host      the face socket alone, for a companion app
#   bin/master-mobile sms       the SMS operator gateway; prints what it is missing when it may not run
#   bin/master-mobile notify    one on-screen toast, then exit
#   bin/master-mobile say       one spoken line over the phone speaker, then exit
#   bin/master-mobile snap      a burst of camera stills graded through the STUDIO postpro chain
#   bin/master-mobile <args>    bin/master in the mobile profile

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"))
require "mobile/profile"

ENV["MASTER_PROFILE"] = "mobile"
Master::Mobile::Profile.new.activate!

case ARGV.first
when "doctor"
  require "mobile/doctor"
  report = Master::Mobile::Doctor.new(root:).report
  puts JSON.pretty_generate(report)
  exit(report["status"] == "ready" ? 0 : 1)
when "bridge"
  require "mobile/face_bridge_http"
  Master::Mobile::FaceBridgeHttp.new(root:).start!
when "host"
  require "mobile/host"
  host = Master::Mobile::Host.new(root:)
  host.start!
  warn "mobile0: face socket #{host.face.socket_path}, session #{host.session.id}"
  %w[INT TERM].each { |signal| trap(signal) { host.stop!; exit } }
  host.serve_loop
when "sms"
  require "mobile/gateway"
  gateway = Master::Mobile::Gateway.new(root: root)
  if (reason = gateway.disabled_reason)
    warn "mobile0: sms gateway not started - #{reason}"
    exit 1
  end
  warn "mobile0: sms gateway polling every #{gateway.interval_s}s; only #{gateway.prefix} commands, only allowed numbers"
  %w[INT TERM].each { |signal| trap(signal) { exit } }
  gateway.run_forever
when "notify"
  require "device"
  text = ARGV[1].to_s.strip
  if text.empty?
    warn "mobile0: notify needs text; bin/master-mobile notify \"scanning done\""
    exit 1
  end
  begin
    Master::Device.toast(text)
  rescue Master::Device::Error => e
    warn "mobile0: #{e.message}"
    exit 1
  end
when "say"
  require "device"
  text = ARGV[1].to_s.strip
  if text.empty?
    warn "mobile0: say needs text; bin/master-mobile say \"MASTER online, klar for ordre\""
    exit 1
  end
  begin
    Master::Device.speak(text)
  rescue Master::Device::Error => e
    warn "mobile0: #{e.message}"
    exit 1
  end
when "snap"
  # Burst by default: five frames through the phone's own camera port, each
  # graded immediately through the STUDIO postpro chain, raw kept beside the
  # grade. Media deliverables stay outside the checkout under STUDIO's
  # output contract; MASTER coordinates, STUDIO grades.
  require "device"
  require "shellwords"
  studio = File.expand_path("../STUDIO", root)
  script = File.join(studio, "postpro", "postpro.rb")
  unless File.file?(script)
    warn "mobile0: no postpro at #{script}; clone the STUDIO tree beside MASTER"
    exit 1
  end
  require File.join(studio, "output_paths.rb")
  burst = Integer(ARGV.values_at(ARGV.index("--count").to_i + 1).first || ENV["MASTER_SNAP_BURST"] || 5)
  burst = 10 if burst > 10
  camera = Integer(ARGV.last.to_s.match?(/\A\d\z/) ? ARGV.last : 0)
  unless Master::Device.android?
    warn "mobile0: snap needs an Android/Termux host - camera absent here"
    exit 1
  end
  out_dir = Studio::OutputPaths.directory("photograph")
  require "fileutils"
  FileUtils.mkdir_p(out_dir)
  graded = 0
  burst.times do |shot|
    stamp = Time.now.utc.strftime("%Y%m%dT%H%M%S%6N")
    raw = File.join(out_dir, "snap_#{stamp}.jpg")
    begin
      Master::Device.camera_photo(raw, camera: camera)
    rescue Master::Device::Error => e
      warn "mobile0: snap #{shot + 1} failed - #{e.message}"
      next
    end
    stdout, stderr, status = Master::Io::Exec.capture3(RbConfig.ruby, script, "--rough", "--count", "1", raw, timeout: 600)
    if status.success? && !Dir[File.join(out_dir, "postpro_snap_#{stamp}*.jpg")].empty?
      graded += 1
    else
      warn "mobile0: grade #{shot + 1} failed - #{[stderr, stdout].compact.reject(&:empty?).first.to_s.strip}"
    end
  end
  puts "mobile0: snap burst done - #{graded}/#{burst} graded in #{out_dir}"
  exit(graded > 0 ? 0 : 1)
else
  exec(File.join(root, "bin", "master"), *ARGV)
end
