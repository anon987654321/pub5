#!/usr/bin/env bun
// zai-chat — MASTER cli-lane bridge to the operator's configured z-ai SDK account.
//
// Session-scoped reroute (operator request, 2026-11-16): /fix model calls ride
// the same z-ai account the agent CLI already uses. The key stays inside the
// SDK's own .z-ai-config; nothing is copied into any file here.
//
// 2026-11-17: the bridge stopped shelling out to `z-ai chat`. That CLI takes
// the prompt only as an argv value, and a single argv cannot exceed the
// kernel's MAX_ARG_STRLEN (~128 KiB) — every repair-sized /fix prompt died
// with E2BIG before the request left the machine, the lane parked itself, and
// the run fell to the slow free floor. This bridge reads the prompt from
// stdin with no size ceiling and posts straight through the same SDK the CLI
// uses, so large prompts ride the primary lane like small ones.
//
// Usage:
//   zai-chat --stdin            prompt on stdin, plain-text reply on stdout
//   zai-chat probe              one tiny live call; prints a reply containing "ok"
//   zai-chat --model <id> ...   model id override (models.yml model_flag)
//
// ZAI_CHAT_MODEL names the requested model (default glm-5.3-flash, the
// operator's primary gateway id, 2026-11-16). A gateway that pins its own
// model answers with whatever it serves; the reply is used either way.
//
// A failed request or an empty reply exits non-zero so the lane reports an
// error and the chain walks on.

import fs from "node:fs";

const HOME = process.env.HOME || "/";
const SDK_CANDIDATES = [
  `${HOME}/.bun/install/global/node_modules/z-ai-web-dev-sdk/dist/index.js`,
  "/usr/local/lib/node_modules/z-ai-web-dev-sdk/dist/index.js",
  "/etc/.z-ai-sdk/dist/index.js",
];

async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8");
}

function parseArgs(argv) {
  const args = { mode: null, model: null };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--stdin") args.mode = "stdin";
    else if (arg === "probe") args.mode = "probe";
    else if (arg === "--model" || arg === "-m") {
      i += 1;
      args.model = argv[i];
    } else {
      process.stderr.write(`zai-chat: unknown argument ${arg}\n`);
      process.exit(2);
    }
  }
  if (!args.mode) {
    process.stderr.write("usage: zai-chat --stdin|probe [--model <id>]\n");
    process.exit(2);
  }
  return args;
}

async function loadSdk() {
  const candidates = [...SDK_CANDIDATES];
  try {
    candidates.unshift(Bun.resolveSync("z-ai-web-dev-sdk", process.cwd()));
  } catch {
    // bare resolution is a bonus, not a requirement
  }
  for (const path of candidates) {
    try {
      if (!fs.existsSync(path)) continue;
      const mod = await import(path);
      const ZAI = mod.default || mod.ZAI || mod;
      return { ZAI, source: path };
    } catch (error) {
      process.stderr.write(`zai-chat: sdk load failed at ${path}: ${error.message}\n`);
    }
  }
  return null;
}

const args = parseArgs(process.argv.slice(2));
const prompt = args.mode === "probe" ? "Reply with the single word: ok" : await readStdin();
if (!prompt.trim()) {
  process.stderr.write("zai-chat: empty prompt\n");
  process.exit(1);
}

const sdk = await loadSdk();
if (!sdk) {
  process.stderr.write("zai-chat: z-ai SDK not found (looked in bun/node global modules)\n");
  process.exit(1);
}

let client;
try {
  client = await sdk.ZAI.create();
} catch (error) {
  process.stderr.write(`zai-chat: sdk config unavailable: ${error.message}\n`);
  process.exit(1);
}

const model = args.model || process.env.ZAI_CHAT_MODEL || "glm-5.3-flash";
let reply;
try {
  reply = await Promise.race([
    client.chat.completions.create({
      model,
      messages: [{ role: "user", content: prompt }],
      thinking: { type: "disabled" },
    }),
    new Promise((_, reject) =>
      setTimeout(() => reject(new Error("zai-chat: deadline exceeded")), 285_000),
    ),
  ]);
} catch (error) {
  process.stderr.write(`zai-chat: request failed: ${error.message}\n`);
  process.exit(1);
}

const content = reply?.choices?.[0]?.message?.content;
if (typeof content !== "string" || !content.trim()) {
  process.stderr.write("zai-chat: empty or unreadable reply\n");
  process.exit(1);
}
process.stdout.write(content);
if (args.mode === "probe") process.stdout.write("\n");
process.exit(0);
