#!/usr/bin/env bun
// zai-tts — MASTER voice-lane bridge to the operator's configured z-ai SDK account.
//
// Same credential boundary as bin/zai-chat: the key stays inside the SDK's own
// .z-ai-config (cwd, home, or /etc); nothing is copied into any file here.
// This is a bridge, not a second speech stack — synthesis request shaping,
// chunking, conversion and joining live in MASTER/lib/voice/engines.rb, and
// the engine chain in data/tts.yml decides when this lane is tried at all.
//
// Usage:
//   zai-tts VOICE SPEED OUT_PATH < text-on-stdin
//   zai-tts probe              one tiny live call; prints a reply containing "ok"
//
// VOICE is an SDK voice id (tongtong, chuichui, xiaochen, jam, kazi, douji,
// luodo). SPEED is the API's 0.5-2.0 range. OUT_PATH must end .wav — the API
// serves wav here (mp3 response_format is refused by this endpoint), and the
// engine converts to mp3 with its existing ffmpeg helper.
//
// The request carries the plain text only — no SSML — because faithful speech
// is the default (data/tts.yml). The API caps one request at 1024 characters;
// the engine chunks above that, and this bridge refuses a longer input instead
// of silently truncating it. A failed request, an empty reply or an unreadable
// output file exits non-zero so the engine chain falls through as on any
// other engine failure.

import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const HOME = process.env.HOME || "/";
const SDK_CANDIDATES = [
  `${HOME}/.bun/install/global/node_modules/z-ai-web-dev-sdk/dist/index.js`,
  "/usr/local/lib/node_modules/z-ai-web-dev-sdk/dist/index.js",
  "/etc/.z-ai-sdk/dist/index.js",
];
const MAX_INPUT_CHARS = 1024;
const REQUEST_DEADLINE_MS = 120_000;
const MIN_WAV_BYTES = 44; // a real WAV carries at least its 44-byte header

async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8");
}

function parseArgs(argv) {
  const args = { mode: null, voice: null, speed: null, outPath: null };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "probe") {
      args.mode = "probe";
    } else if (args.voice === null) {
      args.voice = arg;
    } else if (args.speed === null) {
      args.speed = arg;
    } else if (args.outPath === null) {
      args.outPath = arg;
    } else {
      process.stderr.write(`zai-tts: unknown argument ${arg}\n`);
      process.exit(2);
    }
  }
  if (args.mode === "probe") return args;
  if (!args.voice || args.speed === null || !args.outPath) {
    process.stderr.write("usage: zai-tts VOICE SPEED OUT_PATH < text | zai-tts probe\n");
    process.exit(2);
  }
  if (!args.outPath.endsWith(".wav")) {
    process.stderr.write("zai-tts: OUT_PATH must end .wav (the engine converts to mp3)\n");
    process.exit(2);
  }
  const speed = Number(args.speed);
  if (!Number.isFinite(speed) || speed < 0.5 || speed > 2.0) {
    process.stderr.write("zai-tts: SPEED must be between 0.5 and 2.0\n");
    process.exit(2);
  }
  args.speed = speed;
  return args;
}

async function loadSdk() {
  const candidates = [...SDK_CANDIDATES];
  try {
    candidates.unshift(Bun.resolveSync("z-ai-web-dev-sdk", process.cwd()));
  } catch {
    // bare resolution is a bonus, not a requirement
  }
  for (const candidate of candidates) {
    try {
      if (!fs.existsSync(candidate)) continue;
      const mod = await import(candidate);
      const ZAI = mod.default || mod.ZAI || mod;
      return { ZAI, source: candidate };
    } catch (error) {
      process.stderr.write(`zai-tts: sdk load failed at ${candidate}: ${error.message}\n`);
    }
  }
  return null;
}

async function synthesizeTo(client, input, voice, speed, outPath) {
  const response = await Promise.race([
    client.audio.tts.create({
      input,
      voice,
      speed,
      response_format: "wav",
      stream: false,
    }),
    new Promise((_, reject) =>
      setTimeout(() => reject(new Error("zai-tts: deadline exceeded")), REQUEST_DEADLINE_MS),
    ),
  ]);
  const arrayBuffer = await response.arrayBuffer();
  const buffer = Buffer.from(new Uint8Array(arrayBuffer));
  if (buffer.length <= MIN_WAV_BYTES) {
    throw new Error(`zai-tts: empty or unreadable audio (${buffer.length} bytes)`);
  }
  fs.writeFileSync(outPath, buffer);
  return buffer.length;
}

const args = parseArgs(process.argv.slice(2));
const isProbe = args.mode === "probe";
const text = isProbe ? "Probe." : await readStdin();
if (!text.trim()) {
  process.stderr.write("zai-tts: empty input\n");
  process.exit(1);
}
if (text.length > MAX_INPUT_CHARS) {
  process.stderr.write(`zai-tts: input exceeds the API's ${MAX_INPUT_CHARS}-character ceiling\n`);
  process.exit(1);
}

const sdk = await loadSdk();
if (!sdk) {
  process.stderr.write("zai-tts: z-ai SDK not found (looked in bun/node global modules)\n");
  process.exit(1);
}

let client;
try {
  client = await sdk.ZAI.create();
} catch (error) {
  process.stderr.write(`zai-tts: sdk config unavailable: ${error.message}\n`);
  process.exit(1);
}

try {
  const voice = isProbe ? "tongtong" : args.voice;
  const speed = isProbe ? 1.0 : args.speed;
  const outPath = isProbe
    ? path.join(os.tmpdir(), `zai-tts-probe-${process.pid}.wav`)
    : args.outPath;
  await synthesizeTo(client, text, voice, speed, outPath);
  if (isProbe) {
    fs.rmSync(outPath, { force: true });
    process.stdout.write("ok\n");
  }
  process.exit(0);
} catch (error) {
  process.stderr.write(`zai-tts: request failed: ${error.message}\n`);
  process.exit(1);
}
