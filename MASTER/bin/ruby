#!/bin/sh
# Select the best installed Ruby supported by the project's Gemfile.
set -eu

# macOS libmalloc reads these variables before Ruby starts. Clear them here
# for direct use too; the normal bin/master path also strips them.
case `uname -s 2>/dev/null || true` in
  Darwin)
    while IFS= read -r entry; do
      name=${entry%%=*}
      case "$name" in
        MallocStackLogging*)
          case "$name" in
            *[!A-Za-z0-9_]*) ;;
            *) unset "$name" ;;
          esac
          ;;
      esac
    done <<EOF
$(env)
EOF
    ;;
esac

MIN_MAJOR=3
MIN_MINOR=3
MAX_MAJOR=4
MAX_MINOR=0

if [ -n "${PUB5_RUBY:-}" ] && [ -x "${PUB5_RUBY}" ]; then
  exec "${PUB5_RUBY}" "$@"
fi

BEST_KEY=-1
BEST_RUBY=

add_candidate() {
  ruby=$1
  [ -x "$ruby" ] || return 0

  version=$("$ruby" -e 'print RUBY_VERSION' 2>/dev/null || true)
  case "$version" in
    *.*.*) ;;
    *) return 0 ;;
  esac

  major=${version%%.*}
  rest=${version#*.}
  minor=${rest%%.*}
  patch=${rest#*.}
  case "$major$minor$patch" in
    ""|*[!0-9]*) return 0 ;;
  esac

  if [ "$major" -lt "$MIN_MAJOR" ] || [ "$major" -gt "$MAX_MAJOR" ]; then
    return 0
  fi
  if [ "$major" -eq "$MIN_MAJOR" ] && [ "$minor" -lt "$MIN_MINOR" ]; then
    return 0
  fi
  if [ "$major" -eq "$MAX_MAJOR" ] && [ "$minor" -gt "$MAX_MINOR" ]; then
    return 0
  fi

  key=$((major * 1000000 + minor * 1000 + patch))
  if [ "$key" -gt "$BEST_KEY" ]; then
    BEST_KEY=$key
    BEST_RUBY=$ruby
  fi
}

# rbenv installations are authoritative candidates even when rbenv itself is
# not on PATH: the executable is enough to launch the selected interpreter.
RBENV_ROOT=${RBENV_ROOT:-${HOME:-}/.rbenv}
for ruby in "$RBENV_ROOT"/versions/*/bin/ruby; do
  [ -x "$ruby" ] || continue
  add_candidate "$ruby"
done

# Common package/Homebrew versioned names, followed by the host's generic ruby.
for name in ruby4.0 ruby40 ruby3.4 ruby34 ruby3.3 ruby33 ruby; do
  ruby_path=$(command -v "$name" 2>/dev/null || true)
  [ -n "$ruby_path" ] && add_candidate "$ruby_path"
done

if [ -n "$BEST_RUBY" ]; then
  ACTUAL=$("$BEST_RUBY" -e 'print RUBY_VERSION')
  if [ "${MASTER_QUIET:-0}" != 1 ] &&
     { [ "${MASTER_DMESG:-0}" = 1 ] || [ "${MASTER_VERBOSE:-0}" = 1 ]; }; then
    printf '%s\n' "ruby0: selected $ACTUAL ($BEST_RUBY), best supported Ruby available" >&2
  fi
  exec "$BEST_RUBY" "$@"
fi

printf '%s\n' "ruby0: no supported Ruby found (requires >= 3.3 and < 4.1)" >&2
printf '%s\n' "ruby0: install Ruby 4.0.x when available; Ruby 3.4.x or 3.3.x is also supported" >&2
exit 1
