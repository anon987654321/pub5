#!/bin/sh
# Use the host's generic Ruby first; discover alternatives only when it is too old.
set -eu

# macOS libmalloc reads these variables before Ruby starts. Clear them here
# for direct use too; the normal bin/master path also strips them.
case `uname -s 2>/dev/null || true` in
  Darwin)
    while IFS= read -r entry; do
      name=${entry%%=*}
      case "$name" in
        MallocStackLogging*)
          case "$name" in
            *[!A-Za-z0-9_]*) ;;
            *) unset "$name" ;;
          esac
          ;;
      esac
    done <<EOF
$(env)
EOF
    ;;
esac

MIN_MAJOR=3
MIN_MINOR=3

BEST_KEY=-1
BEST_RUBY=

add_candidate() {
  ruby=$1
  [ -x "$ruby" ] || return 0

  version=$("$ruby" -e 'print RUBY_VERSION' 2>/dev/null || true)
  case "$version" in
    *.*.*) ;;
    *) return 0 ;;
  esac

  major=${version%%.*}
  rest=${version#*.}
  minor=${rest%%.*}
  patch=${rest#*.}
  case "$major$minor$patch" in
    ""|*[!0-9]*) return 0 ;;
  esac

  if [ "$major" -lt "$MIN_MAJOR" ]; then
    return 0
  fi
  if [ "$major" -eq "$MIN_MAJOR" ] && [ "$minor" -lt "$MIN_MINOR" ]; then
    return 0
  fi

  key=$((major * 1000000 + minor * 1000 + patch))
  if [ "$key" -gt "$BEST_KEY" ]; then
    BEST_KEY=$key
    BEST_RUBY=$ruby
  fi
}

if [ -n "${PUB5_RUBY:-}" ]; then
  add_candidate "${PUB5_RUBY}"
  if [ -z "$BEST_RUBY" ]; then
    printf '%s\\n' "ruby0: PUB5_RUBY is not a compatible Ruby >= 3.3: ${PUB5_RUBY}" >&2
    exit 1
  fi
  exec "${PUB5_RUBY}" "$@"
fi
BEST_KEY=-1
BEST_RUBY=

# Prefer the generic interpreter selected by the user's PATH. It is the Ruby
# they installed and use; do not silently switch to a different version.
GENERIC_RUBY=$(command -v ruby 2>/dev/null || true)
if [ -n "$GENERIC_RUBY" ]; then
  add_candidate "$GENERIC_RUBY"
  if [ "$BEST_RUBY" = "$GENERIC_RUBY" ]; then
    ACTUAL=$("$GENERIC_RUBY" -e 'print RUBY_VERSION')
    [ "${MASTER_QUIET:-0}" = 1 ] || printf '%s\\n' "ruby0: using installed Ruby $ACTUAL ($GENERIC_RUBY)" >&2
    exec "$GENERIC_RUBY" "$@"
  fi
fi

# Discover alternate package/rbenv interpreters only when generic Ruby is too old.
RBENV_ROOT=${RBENV_ROOT:-${HOME:-}/.rbenv}
for ruby in "$RBENV_ROOT"/versions/*/bin/ruby; do
  [ -x "$ruby" ] || continue
  add_candidate "$ruby"
done

# Common package/Homebrew versioned names, followed by the host's generic ruby.
for name in ruby4.3 ruby43 ruby4.2 ruby42 ruby4.1 ruby41 ruby4.0 ruby40 ruby3.4 ruby34 ruby3.3 ruby33;
  ruby_path=$(command -v "$name" 2>/dev/null || true)
  [ -n "$ruby_path" ] && add_candidate "$ruby_path"
done

if [ -n "$BEST_RUBY" ]; then
  ACTUAL=$("$BEST_RUBY" -e 'print RUBY_VERSION')
  if [ "${MASTER_QUIET:-0}" != 1 ] &&
     { [ "${MASTER_DMESG:-0}" = 1 ] || [ "${MASTER_VERBOSE:-0}" = 1 ]; }; then
    printf '%s\n' "ruby0: selected $ACTUAL ($BEST_RUBY), best supported Ruby available" >&2
  fi
  exec "$BEST_RUBY" "$@"
fi

printf '%s\n' "ruby0: no supported Ruby found (requires Ruby >= 3.3)" >&2
printf '%s\n' "ruby0: install Ruby 3.3 or newer, or set PUB5_RUBY to a compatible interpreter" >&2
exit 1
