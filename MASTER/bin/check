#!/usr/bin/env ruby
# frozen_string_literal: true

require "shellwords"
require "open3"
require "timeout"
require "time"

# Read-only help and log retrieval stay available even when the MASTER runtime
# itself cannot boot. This command verifies; /fix is the canonical repair loop.
CHECK_HELP = <<~HELP.freeze
  usage: bin/check [--profile operator|contributor|agent|web|ci|full] [--list] [--format human|brief|json]
         bin/check --show-log [--tail=N]

  Profiles:
    operator     local operator suite, security sweep and core checks (default)
    contributor  contributor suite and deterministic checks
    agent        agent/Law tooling and registry checks
    web          browser-facing tests and static web contracts
    ci           canonical CI floor; MASTER_CI_* may widen it
    full         CI, every owned tree's native tests/parsers, probes and audit

  Options:
    --list             show the exact steps for the selected profile; run nothing
    --show-log         print the saved combined log without booting MASTER
    --tail=N           with --show-log, print only the final N lines (default 120)
    --help             show this help without booting MASTER

  Repair:
    Start MASTER/bin/master and enter /fix [TREE]. /fix repairs and runs
    scope-aware proof. bin/check is supplemental verification, not a required
    post-/fix step. bin/operator check is a separate repo-wide maintenance
    ladder and writes fixes unless --scan-only is supplied.
HELP

def show_check_log(argv)
  args = argv.dup
  args.delete("--show-log")
  tail = 120
  if (index = args.index("--tail"))
    value = args[index + 1]
    raise ArgumentError, "--tail requires a positive line count" unless value
    args.slice!(index, 2)
    tail = Integer(value, 10)
  elsif (value = args.find { |arg| arg.start_with?("--tail=") })
    args.delete(value)
    tail = Integer(value.delete_prefix("--tail="), 10)
  end
  raise ArgumentError, "--tail must be between 1 and 10000" unless (1..10_000).cover?(tail)
  raise ArgumentError, "unexpected log option(s): #{args.join(" ")}" unless args.empty?

  root = File.expand_path("..", __dir__)
  path = File.expand_path(ENV.fetch("MASTER_CHECK_RUN_LOG", File.join(root, ".master", "check", "latest.log")))
  raise IOError, "refusing a symlinked check log: #{path}" if File.symlink?(path)
  raise Errno::ENOENT, path unless File.file?(path)

  # Bound memory when a check has accumulated a very large compiler/test log.
  File.open(path, "rb") do |file|
    truncated = file.size > 4 * 1024 * 1024
    file.seek([file.size - 4 * 1024 * 1024, 0].max)
    content = file.read.to_s.force_encoding(Encoding::UTF_8).scrub
    content = content.sub(/\A.*?\n/, "") if truncated
    puts "log: #{path} (last #{tail} lines#{truncated ? ", bounded to 4 MiB" : ""})"
    print content.lines.last(tail).join
  end
  0
rescue ArgumentError, IOError, SystemCallError => error
  warn "check-log0: #{error.class}: #{error.message}"
  1
end

if ARGV.include?("--help") || ARGV.include?("-h")
  puts CHECK_HELP
  exit 0
end
exit(show_check_log(ARGV)) if ARGV.include?("--show-log")

require_relative "../lib/boot/entrypoint"
Master::Boot::Entrypoint.prepare!(root: File.expand_path("..", __dir__))

# The ladder, law/ and the scan registry and then the critique tier, is a mode of this command rather than
# a second one: --ladder, or any of its own flags, hands the arguments to lib/operator/check_ladder.rb.
LADDER_FLAGS = %w[--ladder --scan-only --lexical-only --semantic-only --explain].freeze
if ARGV.any? { |arg| LADDER_FLAGS.include?(arg) || arg.start_with?("--tree=") }
  ARGV.delete("--ladder")
  load File.expand_path("../lib/operator/check_ladder.rb", __dir__)
  exit
end
#
# One check entrypoint. A profile is a named list of steps — pick one:
#
#   bin/check [--profile NAME] [--format human|brief|json]
#
#   operator     (default) unit suite + core spine + data singularity
#   contributor  fast: unit suite + data singularity
#   agent        law/agent changes: selftest + data singularity
#   web          the face: static web UI (+ live web when MASTER_WEB_LIVE=1)
#   ci           the canonical local CI floor; MASTER_CI_FULL/WEB/BROWSER widen it
#   full         operator-grade check: ci + test:all_trees + bin/probe all + rake audit
#
# `bin/operator check` runs this as one stage of the repo-wide chain, alongside the
# scanner, the RAILS checks, the ratchets and the sprawl census.
#
# Steps compose from two makers (rake / bin), so a new profile is one line of data.

require "optparse"
require_relative "../lib/operator/check_runner"
require_relative "../lib/operator/check_brief"
require_relative "../lib/operator/ruby_runner"
require_relative "../lib/trace/dmesg"

ROOT = File.expand_path("..", __dir__)
RUBY = Operator::RubyRunner.ruby_cmd
BUNDLE = Operator::RubyRunner.bundle_cmd

profile = "operator"
format = "human"
list = false
OptionParser.new do |parser|
  parser.banner = "usage: bin/check [--profile operator|contributor|agent|web|ci|full] [--list] [--format human|brief|json]"
  parser.on("--profile=NAME") { |value| profile = value }
  parser.on("--format=NAME") { |value| format = value }
  parser.on("--list", "show the selected profile commands without running them") { list = true }
end.parse!
unless %w[human brief json].include?(format)
  Master::Trace::Dmesg.status("check0", "unknown format #{format}, have human, brief or json")
  exit 64
end

rake = ->(*task) { [task.join(" "), BUNDLE, "exec", "rake", *task] }
run_bin = ->(name, *args) { ["bin/#{name} #{args.join(' ')}".strip, RUBY, File.join(ROOT, "bin", name), *args] }
web_live = ENV["MASTER_WEB_LIVE"] == "1"
# vm23 has node at /usr/local/bin, which is not on cron's PATH — so resolve it
# rather than assuming the shell will.
node_bin = ENV["PATH"].to_s.split(File::PATH_SEPARATOR).push("/usr/local/bin")
                      .map { |dir| File.join(dir, "node") }.find { |p| File.executable?(p) }
web_test_dir = File.join(ROOT, "..", "MASTER", "web", "test")
web_node_tests = Dir[File.join(web_test_dir, "**/*.test.mjs")].sort
web_node_step = if node_bin && web_node_tests.any?
  ["web ui behaviour", node_bin, "--test", *web_node_tests]
else
  reason = node_bin ? "no JavaScript tests found beneath #{web_test_dir}" :
    "Node.js unavailable; web behavior was not measured"
  ["web ui behaviour unavailable", RUBY, "-e", "warn #{reason.inspect}; exit 3"]
end
web_live_step = if web_live
  rake["test:integration_web"]
else
  ["integration web unavailable", RUBY, "-e", "warn 'MASTER_WEB_LIVE=1 was not set'; exit 3"]
end

# test:subsystems groups CLI, operator-intent/routing, I/O and fix regressions
# for a focused run. It is in the operator and contributor profiles and the CI
# list so a break there is caught by the checks contributors actually run.
# rake["tools"] is in agent as well as the two heavy profiles, and it is the
# only step that is. The agent profile is what runs around law and fix-loop work,
# which is exactly the work that has silently broken tools before — `bin/check --ladder`'s
# /fix step rewrites the whole shared worktree, and until MASTER/tools/check.rb there
# was nothing in any profile that noticed. It costs ~3s: parse is in-process AST
# and the two load probes are about a second each.

# One list of CI steps, not two.
#
# `bin/ci` kept its own copy of these rake tasks beside this file's profiles:
# the same seven steps declared twice, free to drift, and `--profile=full`
# shelled out to that copy — so full ran selftest and core_smoke once through
# bin/ci and again through `rake audit`, and paid for both. bin/ci is this
# profile now, and full composes the list rather than re-running the script.
#
# The three MASTER_CI_* widenings are the workflow's, kept here because the
# workflow sets them and this is where the steps they add are declared.
# Boots the container and builds the FixLoop, no model call: the only step that
# sees a reader of a method that no longer exists (Laws#thresholds, 2026-10).
boot_smoke = ["boot smoke", RUBY, File.join(ROOT, "tools", "boot_smoke.rb")]

law_syntax = ["law syntax", RUBY, "-e", <<~'RUBY', ROOT]
  Dir.glob(File.join(ARGV.fetch(0), "law", "*.rb")).sort.each do |path|
    RubyVM::InstructionSequence.compile_file(path)
  rescue SyntaxError => e
    warn "#{path.delete_prefix(ARGV.fetch(0) + File::SEPARATOR)}: #{e.message.lines.first.to_s.strip}"
    exit 1
  end
RUBY

# gem:build_proof is here and nowhere else: the gemspec claims a file list that
# nothing verified, and a package built from a silently-shortened list ships
# fewer files than it claims. The proof is one package build, ~2s.
ci_steps = [law_syntax, boot_smoke, rake["test"], rake["test:core"], rake["test:subsystems"],
            rake["test:web"], rake["test:web_ui"], rake["selftest"],
            rake["lint:data_singularity"], rake["core_smoke"], rake["tools"],
            rake["gem:build_proof"]]
ci_steps += [run_bin["smoke"], rake["selfcheck"], rake["constitution"]] unless ENV["MASTER_CI_FULL"] == "0"
ci_steps << web_node_step
ci_steps << rake["test:integration_web"] unless ENV["MASTER_CI_WEB"] == "0"
unless ENV["MASTER_CI_BROWSER"] == "0"
  webgl = File.join(ROOT, "..", "MASTER", "web", "script", "probe_webgl_guard.rb")
  if File.file?(webgl)
    # The Ruby CDP probe reads the page itself and requires a real browser
    # response; source-only or missing-browser evidence cannot turn green.
    ENV["PROBE_REQUIRE_BROWSER"] ||= "1"
    ci_steps << ["webgl probe", RUBY, webgl]
  else
    Master::Trace::Dmesg.status("web0", "webgl probe skipped, missing #{webgl}")
  end
end

# rake audit already runs selftest, core_smoke and constitution, so full lists
# the CI steps that audit does not cover rather than the whole of ci.
full_ci = ci_steps.reject { |step| %w[selftest core_smoke constitution].include?(step.first) }

PROFILES = {
  "operator"    => [law_syntax, boot_smoke, rake["test"], rake["test:subsystems"], rake["security_sweep"],
                    rake["test:core"], rake["lint:data_singularity"], rake["lint:dedup"], rake["tools"]],
  "contributor" => [law_syntax, boot_smoke, rake["test"], rake["test:subsystems"], rake["security_sweep"],
                    rake["lint:data_singularity"], rake["lint:dedup"], rake["tools"]],
  # lint:word_boundary is here and nowhere else: its subject is a `\b` written
  # next to punctuation in a rule regex, which is a word boundary that can never
  # fire, and the agent profile is the one that runs around rule work. It has
  # cost something four times — TYPE_CHECK's `is_a\?\b` clause was dead from the
  # day it was written, so half of what OPEN_CLOSED promised never ran. The lint
  # existed for weeks in no profile at all, which is the defect it detects,
  # wearing the other coat. 0.2s.
  "agent"       => [law_syntax, boot_smoke, rake["selftest"], rake["lint:data_singularity"], rake["lint:dedup"],
                    rake["lint:word_boundary"], rake["tools"]],
  # Face tests keep three runtimes: the MASTER Rack UI test, the Rails-backed
  # MASTER/web suite, and every shipped JavaScript behavior test under Node.
  # The canonical web tree moved to MASTER/web; the old MASTER/web glob
  # selected zero files without failing, so CI reported green without measuring
  # any of those JavaScript tests. An empty inventory or missing runtime is now
  # a visible non-pass rather than a silent omission.
  "web"         => [law_syntax, rake["test:web_ui"], web_node_step, rake["test:web"], web_live_step],
  "ci"          => ci_steps,
  # End-to-end completion sweep: cover every owned tree as well as the MASTER
  # release profile. It runs each tree's native tests, language checks and parsers.
  # Exit 3 means runtime evidence was unavailable (for example Node is missing),
  # not that the tests passed; CheckBrief preserves that as INCONCLUSIVE.
  "full"        => [*full_ci, rake["test:all_trees"], run_bin["probe", "all"], rake["audit"]],
}.freeze

check_io = format == "json" ? $stderr : $stdout
steps = PROFILES[profile]
unless steps
  Master::Trace::Dmesg.status("check0", "unknown profile #{profile}, have #{PROFILES.keys.join(", ")}", io: check_io)
  exit 64
end

if list
  puts "profile: #{profile}"
  puts "commands:"
  steps.each_with_index do |step, index|
    puts format("%2d. %s", index + 1, step.first)
    puts "    argv: #{Shellwords.join(step.drop(1))}"
    puts "    cwd: #{ROOT}"
  end
  puts "No checks executed. Use /fix [TREE] for repair and scope-aware proof."
  exit 0
end

# Hang guard, not a performance budget — see CheckRunner::SLOW_STEP_FRACTION.
# 360 was under `rake test`'s real cost the moment anything else used the CPU
# (247s measured idle, 2026-08-02), so the check reported starved-clock timeouts
# as failing unit tests. CheckRunner now warns on a *passing* step that eats
# most of its allowance, which is the signal that was missing.
timeout = Integer(ENV.fetch("MASTER_CHECK_TIMEOUT", profile == "full" ? "1200" : "900"))
run_log = ENV.fetch("MASTER_CHECK_RUN_LOG", File.join(ROOT, ".master", "check", "latest.log"))
def check_git_value(root, *arguments)
  output, status = Timeout.timeout(5) do
    Open3.capture2e("git", "-C", root, *arguments)
  end
  status.success? ? output.strip : nil
rescue Timeout::Error, SystemCallError
  nil
end

def check_git_metadata(root)
  repository_root = check_git_value(root, "rev-parse", "--show-toplevel") || root
  checked_out_sha = check_git_value(root, "rev-parse", "--verify", "HEAD")
  branch = check_git_value(root, "branch", "--show-current")
  main_ref = if check_git_value(root, "rev-parse", "--verify", "refs/heads/main")
               "refs/heads/main"
             elsif check_git_value(root, "rev-parse", "--verify", "refs/remotes/origin/main")
               "refs/remotes/origin/main"
             end
  main_sha = main_ref && check_git_value(root, "rev-parse", "--verify", main_ref)
  worktree = check_git_value(root, "status", "--porcelain", "--untracked-files=all")
  remote = check_git_value(root, "config", "--get", "remote.origin.url")
  repository_candidate = remote.to_s.sub(%r{\A(?:git@github\.com:|https://github\.com/)}, "").sub(/\.git\z/, "")
  repository = repository_candidate if repository_candidate.match?(/\A[a-zA-Z0-9_.-]+\/[a-zA-Z0-9_.-]+\z/)

  {
    repository: repository || File.basename(repository_root),
    branch: branch,
    main_sha: main_sha,
    main_ref: main_ref,
    checked_out_sha: checked_out_sha,
    clean_checkout: worktree.nil? ? nil : worktree.empty?,
    environment: "ruby #{RUBY_VERSION}",
  }
end

def check_relative_log(root, path)
  return unless path

  expanded_root = File.expand_path(root) + File::SEPARATOR
  expanded_path = File.expand_path(path, root)
  return unless expanded_path.start_with?(expanded_root)

  expanded_path.delete_prefix(expanded_root)
end

if format == "json" && check_relative_log(ROOT, run_log).nil?
  warn "check0: JSON reports require the combined log to stay inside the repository"
  exit 64
end

metadata = check_git_metadata(ROOT) if format == "json"
started_at = Time.now.utc
started_clock = Process.clock_gettime(Process::CLOCK_MONOTONIC)
runner = Operator::CheckRunner.new(
  prefix: "check:#{profile}", root: ROOT, timeout:,
  quiet: format != "human", log_path: run_log
)

steps.each { |step| runner.run(*step) }
finished_at = Time.now.utc
duration_s = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_clock
failures = runner.results.reject { |r| r.success }.map(&:name)
exit_status = failures.empty? ? 0 : 1

if format == "json"
  receipt_id = SecureRandom.uuid
  operation_id = SecureRandom.uuid
  relative_receipt_path = ".master/check/receipts/#{receipt_id}.json"
  receipt = JSON.parse(Operator::CheckBrief.render_json(
    profile:, results: runner.results, metadata:,
    started_at: started_at.iso8601(3), finished_at: finished_at.iso8601(3),
    duration_s:, exit_status:,
    command: "MASTER/bin/check --profile=#{profile} --format=json",
    log_path: check_relative_log(ROOT, runner.log_path),
    log_artifact: Operator::CheckBrief.file_evidence(root: ROOT, path: runner.log_path),
    receipt_id:, operation_id:, receipt_path: relative_receipt_path,
    receipt_persisted: true
  ))
  exit_status = case receipt.fetch("status")
                when "PASS" then 0
                when "TIMEOUT" then 124
                else 1
                end
  receipt["exit_status"] = exit_status
  json = JSON.pretty_generate(receipt) << "\n"

  begin
    Operator::CheckBrief.write_json_receipt(root: ROOT, receipt:)
  rescue IOError, SystemCallError => error
    receipt["status"] = "DELIVERY_FAILED"
    receipt["exit_status"] = 1
    receipt["receipt_path"] = nil
    receipt["receipt_output"] = "stdout"
    receipt["evidence"]["receipt_persisted"] = false
    receipt["evidence"]["receipt_write_error"] = error.class.name
    json = JSON.pretty_generate(receipt) << "\n"
    warn "checkreceipt0: unable to persist receipt (#{error.class})"
    exit_status = 1
  end

  puts json
else
  body = if format == "brief"
           Operator::CheckBrief.render(profile:, results: runner.results)
         elsif failures.empty?
           "clean"
         else
           "#{failures.size} failure(s), #{failures.join(", ")}"
         end
  Master::Trace::Dmesg::Report.print("check0", body, parent: "master0")
  Master::Trace::Dmesg.status("check0", "combined log: #{runner.log_path}") if runner.log_path
end
exit(exit_status)
