#!/bin/sh
# dev-bootstrap — a suitable Ruby for this checkout, on any host, without root.
#
# bin/ruby probes the Rubies a macOS workstation already has. A constrained
# environment — a Linux container, a VPS without a dev package manager, an
# agent sandbox with no sudo — has nothing to probe, and the operator's
# answer ("compile one") arrived only as tribal knowledge: which libyaml,
# which configure flags, where it may write. This script is that knowledge,
# written down and executable. It is the same path the 2026-11-08 container
# /fix run walked, by hand, twice.
#
# Usage:
#   bin/dev-bootstrap                # build if needed, print the receipt
#   bin/dev-bootstrap [args...]      # ensure a Ruby, then exec it with args
#
# Order of preference:
#   1. $PUB5_RUBY                       (the operator's explicit compatible override)
#   2. the generic Ruby already selected by PATH (>= 3.2)
#   3. another compatible installed Ruby, only if generic Ruby is too old
#   4. a Ruby this script built earlier (MASTER/.tools/ruby)
#   5. build one only when no compatible interpreter exists
#
# MASTER_DEV_BOOTSTRAP_BUILD=0 refuses step 5 (use it where the network is
# unavailable and the honest answer is a named failure, not a hang).
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(dirname -- "$SCRIPT_DIR")
TOOLS="$ROOT/.tools"
PREFIX="$TOOLS/ruby"
# The supporting libraries install into the Ruby's own prefix, not a sibling
# directory. mkmf searches that prefix by default, so a later `bundle install`
# can build fiddle (libffi), psych (libyaml) and friends without a pkg-config
# path handed to it, and without any dev package from the host.
YAML_PREFIX="$PREFIX"
ZLIB_PREFIX="$PREFIX"
LIBRESSL_PREFIX="$PREFIX"
LIBRESSL_VER=4.3.3
FFI_PREFIX="$PREFIX"
MIN_MAJOR=3
MIN_MINOR=2
# Must satisfy the Gemfile floor (`ruby ">= 3.2"`). A 3.1.x build here produced an
# interpreter this script and Bundler both reject under the previous floor; the current floor accepts 3.2+ so the no-root fallback can
# never boot MASTER. The RAILS apps declare `ruby ">= 3.4"`, and they boot under
# the same interpreter MASTER runs on, so the fallback builds a 3.4 release: a
# 3.3.x prefix bundles MASTER and then refuses every app.
RUBY_VER=3.4.7

say() { printf 'dev-bootstrap: %s\n' "$*"; }

version_key() {
  # "3.2.6" -> 3*1000000+3*1000+6 ; unsuitable versions print nothing.
  version=$1
  case $version in
    *.*.*) ;;
    *) return 1 ;;
  esac
  major=${version%%.*}
  rest=${version#*.}
  minor=${rest%%.*}
  patch=${rest#*.}
  case $major in *[!0-9]*|'') return 1 ;; esac
  case $minor in *[!0-9]*|'') return 1 ;; esac
  case $patch in *[!0-9]*|'') return 1 ;; esac
  [ "$major" -lt "$MIN_MAJOR" ] && return 1
  [ "$major" -eq "$MIN_MAJOR" ] && [ "$minor" -lt "$MIN_MINOR" ] && return 1
  printf '%d\n' $((major * 1000000 + minor * 1000 + patch))
}

# Before Ruby is available, use a POSIX watchdog rather than a platform-specific
# timeout utility. A temp file prevents a forked child holding stdout from
# keeping command substitution open after the interpreter has been killed.
probe_with_deadline() (
  output=$(mktemp "${TMPDIR:-/tmp}/master-ruby-probe.XXXXXXXX") || exit 1
  trap 'rm -f "$output"' 0
  "$@" >"$output" 2>/dev/null &
  probe_pid=$!
  (
    timer=
    trap '[ -z "$timer" ] || kill "$timer" 2>/dev/null || :; exit 0' TERM
    sleep 5 & timer=$!
    wait "$timer" || exit 0
    kill -KILL "$probe_pid" 2>/dev/null || :
  ) </dev/null >/dev/null 2>&1 &
  watchdog=$!
  status=0
  wait "$probe_pid" 2>/dev/null || status=$?
  kill "$watchdog" 2>/dev/null || :
  wait "$watchdog" 2>/dev/null || :
  [ "$status" -eq 0 ] || exit "$status"
  cat "$output"
)

best_on_path() {
  best_key=-1
  best_ruby=

  # Hermetic test seam; production always checks generic PATH Ruby first.
  if [ -n "${MASTER_RUBY_CANDIDATES+x}" ]; then
    set -- $(printf '%s' "$MASTER_RUBY_CANDIDATES" | tr ':' ' ')
    for candidate in "$@"; do
      [ -n "$candidate" ] || continue
      [ -x "$candidate" ] || continue
      version=$(probe_with_deadline "$candidate" -e 'print RUBY_VERSION') || continue
      key=$(version_key "$version") || continue
      [ "$key" -gt "$best_key" ] || continue
      best_key=$key
      best_ruby=$candidate
    done
    [ -n "$best_ruby" ] && printf '%s\n' "$best_ruby"
    return
  fi

  generic=$(command -v ruby 2>/dev/null || true)
  if [ -n "$generic" ] && [ -x "$generic" ]; then
    if version=$(probe_with_deadline "$generic" -e 'print RUBY_VERSION') &&
      key=$(version_key "$version"); then
      printf '%s\n' "$generic"
      return
    fi
  fi

  for candidate in "$HOME"/.rubies/*/bin/ruby "$HOME"/.rbenv/versions/*/bin/ruby; do
    [ -x "$candidate" ] || continue
    version=$(probe_with_deadline "$candidate" -e 'print RUBY_VERSION') || continue
    key=$(version_key "$version") || continue
    [ "$key" -gt "$best_key" ] || continue
    best_key=$key
    best_ruby=$candidate
  done

  old_ifs=$IFS
  IFS=:
  for directory in $PATH; do
    [ -d "$directory" ] || continue
    for candidate in "$directory"/ruby[0-9]*; do
      [ -x "$candidate" ] || continue
      version=$(probe_with_deadline "$candidate" -e 'print RUBY_VERSION') || continue
      key=$(version_key "$version") || continue
      [ "$key" -gt "$best_key" ] || continue
      best_key=$key
      best_ruby=$candidate
    done
  done
  IFS=$old_ifs
  [ -n "$best_ruby" ] && printf '%s\n' "$best_ruby"
}

fetch() {
  url=$1
  out=$2
  if command -v curl >/dev/null 2>&1; then
    curl --connect-timeout 15 --max-time 300 -fsSLo "$out" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget --timeout=30 --tries=2 -qO "$out" "$url"
  else
    say "no curl or wget to fetch $url"
    exit 1
  fi
}

# LibreSSL's openssldir is set to $PREFIX/ssl, where Ruby reads
# OpenSSL::X509::DEFAULT_CERT_FILE. A container has no bundle there, so HTTPS
# calls from RubyGems and model lanes fail verification despite working network.
# Install the host bundle, or fetch Mozilla's with the host curl/wget.
install_ca_bundle() {
  bundle="$PREFIX/ssl/cert.pem"
  if [ -s "$bundle" ]; then
    return 0
  fi
  mkdir -p "$PREFIX/ssl"
  for candidate in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem; do
    if [ -s "$candidate" ]; then
      cp "$candidate" "$bundle"
      say "installed the host CA bundle at $bundle"
      return 0
    fi
  done
  say "fetching the Mozilla CA bundle for $bundle"
  fetch https://curl.se/ca/cacert.pem "$bundle"
}

build() {
  say "no suitable Ruby found; building $RUBY_VER into $PREFIX (no root needed)"
  mkdir -p "$TOOLS"
  cd "$TOOLS"

  # A .built marker attests a build, not an install. $PREFIX is the install
  # target and the documented path a session wipes when it wants a fresh
  # interpreter; wiping it leaves the source markers behind, and a guard that
  # trusts them then rebuilds Ruby against an empty prefix — configure skips
  # ext/openssl, ext/psych and ext/fiddle silently, and the interpreter boots
  # but cannot load OpenSSL ("cannot load such file -- openssl" at first
  # bundle). Each dep therefore re-installs whenever its installed artifact is
  # missing, marker or no marker.
  dep_ready() {
    [ -f "$1/.built" ] && [ -e "$2" ]
  }

  if ! dep_ready yaml-0.2.5 "$YAML_PREFIX/lib/libyaml.a"; then
    say "fetching libyaml 0.2.5"
    fetch https://pyyaml.org/download/libyaml/yaml-0.2.5.tar.gz yaml.tar.gz
    rm -rf yaml-0.2.5
    tar xzf yaml.tar.gz
    (cd yaml-0.2.5 && CC=${CC:-cc} ./configure --prefix="$YAML_PREFIX" \
      --disable-shared --with-pic >/dev/null && make -j2 >/dev/null && make install >/dev/null)
    touch yaml-0.2.5/.built
  fi
  say "libyaml ready at $YAML_PREFIX"

  # zlib and LibreSSL are built from source for the same reason libyaml is: a
  # container with no dev packages has no headers, and Ruby needs SSL support
  # for RubyGems to fetch gems over HTTPS.
  if ! dep_ready zlib-1.3.1 "$ZLIB_PREFIX/lib/libz.a"; then
    say "fetching zlib 1.3.1"
    fetch https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz zlib.tar.gz
    rm -rf zlib-1.3.1
    tar xzf zlib.tar.gz
    (cd zlib-1.3.1 && CC=${CC:-cc} ./configure --prefix="$ZLIB_PREFIX" >/dev/null \
      && make -j2 >/dev/null && make install >/dev/null)
    touch zlib-1.3.1/.built
  fi
  say "zlib ready at $ZLIB_PREFIX"

  if ! dep_ready "libressl-$LIBRESSL_VER" "$LIBRESSL_PREFIX/lib/libssl.so"; then
    say "fetching LibreSSL $LIBRESSL_VER"
    fetch "https://ftp.openbsd.org/pub/OpenBSD/LibreSSL/libressl-$LIBRESSL_VER.tar.gz" \
      libressl.tar.gz
    rm -rf "libressl-$LIBRESSL_VER"
    tar xzf libressl.tar.gz
    (cd "libressl-$LIBRESSL_VER" && CC=${CC:-cc} ./configure \
      --prefix="$LIBRESSL_PREFIX" --with-openssldir="$LIBRESSL_PREFIX/ssl" \
      --enable-shared --disable-static >/dev/null \
      && make -j2 >/dev/null && make install >/dev/null)
    touch "libressl-$LIBRESSL_VER/.built"
  fi
  say "LibreSSL ready at $LIBRESSL_PREFIX"
  install_ca_bundle

  # libffi is what the fiddle gem (a default gem Ruby rebuilds) needs to build.
  # It must be shared: fiddle links it into a shared object, and a static-only
  # archive without PIC cannot be linked there.
  if ! dep_ready libffi-3.4.6 "$FFI_PREFIX/lib/libffi.so"; then
    say "fetching libffi 3.4.6"
    fetch https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz \
      libffi.tar.gz
    rm -rf libffi-3.4.6
    tar xzf libffi.tar.gz
    (cd libffi-3.4.6 && CC=${CC:-cc} ./configure --prefix="$FFI_PREFIX" >/dev/null \
      && make -j2 >/dev/null && make install >/dev/null)
    touch libffi-3.4.6/.built
  fi
  say "libffi ready at $FFI_PREFIX"

  # The same marker-vs-install rule for the interpreter itself: a .built marker
  # beside an interpreter whose ext/openssl never built (deps were missing at
  # configure time) must not survive. The dep guards above have re-installed
  # whatever was absent, so re-running configure and make here picks the
  # extensions up; the probe is the only honest check.
  if [ ! -f ruby-$RUBY_VER/.built ] || \
     ! LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
       "$PREFIX/bin/ruby" -e 'require "openssl"' >/dev/null 2>&1; then
    say "fetching ruby $RUBY_VER (this is the long step; re-running resumes)"
    if [ ! -d ruby-$RUBY_VER ]; then
      # The series directory tracks RUBY_VER; a hard-coded one fetched a tarball
      # whose name never matched the version the build then looked for.
      series=$(printf '%s' "$RUBY_VER" | cut -d. -f1,2)
      fetch "https://cache.ruby-lang.org/pub/ruby/$series/ruby-$RUBY_VER.tar.gz" ruby.tar.gz
      tar xzf ruby.tar.gz
    fi
    (cd ruby-$RUBY_VER \
      && CPPFLAGS="-I$YAML_PREFIX/include -I$ZLIB_PREFIX/include -I$LIBRESSL_PREFIX/include -I$FFI_PREFIX/include" \
         LDFLAGS="-L$YAML_PREFIX/lib -L$ZLIB_PREFIX/lib -L$LIBRESSL_PREFIX/lib -L$FFI_PREFIX/lib" \
         CC=${CC:-cc} ./configure --prefix="$PREFIX" --disable-install-doc \
           --with-yaml-dir="$YAML_PREFIX" --with-openssl-dir="$LIBRESSL_PREFIX" \
           --with-libffi-dir="$FFI_PREFIX" \
           --without-gmp --enable-shared >/dev/null \
      && make -j2 >/dev/null && make install >/dev/null)
    touch ruby-$RUBY_VER/.built
  fi
  say "built: $PREFIX/bin/ruby"
}

# 1 and 2: an explicit compatible override, or the generic/available host Ruby.
if [ -n "${PUB5_RUBY:-}" ]; then
  [ -x "$PUB5_RUBY" ] || { say "PUB5_RUBY is not executable: $PUB5_RUBY"; exit 1; }
  version=
  if ! version=$(probe_with_deadline "$PUB5_RUBY" -e 'print RUBY_VERSION') || ! version_key "$version" >/dev/null; then
    say "PUB5_RUBY must be Ruby >= $MIN_MAJOR.$MIN_MINOR (found ${version:-unreadable})"
    exit 1
  fi
  exec "$PUB5_RUBY" "$@"
fi

if chosen=$(best_on_path) && [ -n "$chosen" ]; then
  exec "$chosen" "$@"
fi

# 3: a Ruby this script built before, when it still meets the floor. A build
# left by an older RUBY_VER must not be trusted blind: a 3.1.x build answered
# here and then failed Bundler's own `ruby ">= 3.2"` check.
if [ -x "$PREFIX/bin/ruby" ]; then
  built=
  if built=$(LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    probe_with_deadline "$PREFIX/bin/ruby" -e 'print RUBY_VERSION') && version_key "$built" >/dev/null; then
    install_ca_bundle
    LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
    exec "$PREFIX/bin/ruby" "$@"
  fi
  say "ignoring $PREFIX/bin/ruby: expected Ruby >= $MIN_MAJOR.$MIN_MINOR (found ${built:-unreadable})"
fi

# 4: build one, then answer through it.
if [ "${MASTER_DEV_BOOTSTRAP_BUILD:-1}" = "0" ]; then
  say "no Ruby >= $MIN_MAJOR.$MIN_MINOR on this host, and building is disabled (MASTER_DEV_BOOTSTRAP_BUILD=0)"
  say "install a compatible Ruby, set PUB5_RUBY explicitly, or allow the fallback build"
  exit 1
fi

build
LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
if [ "$#" -gt 0 ]; then
  exec "$PREFIX/bin/ruby" "$@"
fi

say "receipt: $PREFIX/bin/ruby ($(probe_with_deadline "$PREFIX/bin/ruby" -e 'print RUBY_VERSION'))"
say "support libraries: $PREFIX (static, private to this checkout)"
say "use: bin/dev-bootstrap [args...] runs args on it"
say "  or: export LD_LIBRARY_PATH=$PREFIX/lib and PATH=$PREFIX/bin:\$PATH"
