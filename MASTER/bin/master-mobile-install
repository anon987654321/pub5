#!/usr/bin/env sh
# Provision and launch MASTER in Ubuntu or Debian under Termux PRoot-Distro.
# POSIX sh: this entrypoint runs before the guest Ruby exists.
set -eu

repo="${MASTER_REPO_URL:-https://github.com/anon987654321/pub5.git}"
dir="${MASTER_INSTALL_DIR:-$HOME/pub5}"
branch="${MASTER_BRANCH:-main}"
requested_distro="auto"
expected_repo="https://github.com/anon987654321/pub5.git"
demo=0
launch=1

fail() { printf 'mobile0: BLOCKED: %s\n' "$*" >&2; exit 1; }
usage() {
  printf '%s\n' \
    "usage: master-mobile-install [--auto|--ubuntu|--debian] [--demo] [--no-launch] [-- ARGS...]" \
    "  --auto       reuse Ubuntu, else Debian; install Ubuntu when neither exists (default)" \
    "  --ubuntu     install or reuse the Ubuntu PRoot-Distro guest" \
    "  --debian     install or reuse the Debian PRoot-Distro guest" \
    "  --demo       print the plan without changing the device" \
    "  --no-launch  provision the selected guest but leave the CLI stopped" \
    "  --proot      compatibility alias for --auto"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --demo) demo=1; shift ;;
    --auto|--proot) requested_distro=auto; shift ;;
    --ubuntu) requested_distro=ubuntu; shift ;;
    --debian) requested_distro=debian; shift ;;
    --launch) launch=1; shift ;;
    --no-launch) launch=0; shift ;;
    --) shift; break ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1 (use --help)" ;;
  esac
done

# --demo is portable and read-only: no package manager, Git, Ruby or PRoot call.
if [ "$demo" -eq 1 ]; then
  printf 'mobile0: DEMO only; no commands run, packages installed, files written, or Git state changed\n'
  printf 'mobile0: repository %s\n' "$repo"
  printf 'mobile0: install directory %s\n' "$dir"
  printf 'mobile0: branch %s\n' "$branch"
  [ "$repo" = "$expected_repo" ] || {
    printf 'mobile0: would BLOCK: only the canonical HTTPS repository is allowed\n'
    exit 2
  }
  [ -n "$branch" ] || { printf 'mobile0: would BLOCK: MASTER_BRANCH must not be empty\n'; exit 2; }
  case "$dir" in "$HOME"/*) ;; *) printf 'mobile0: would BLOCK: install directory must be below Termux HOME\n'; exit 2 ;; esac
  [ "$dir" != "$HOME" ] || { printf 'mobile0: would BLOCK: install directory cannot be HOME itself\n'; exit 2; }
  [ ! -L "$dir" ] || { printf 'mobile0: would BLOCK: install directory must not be a symbolic link\n'; exit 2; }
  if [ -e "$dir" ] && [ ! -d "$dir/.git" ]; then
    printf 'mobile0: would BLOCK: %s exists but is not a Git checkout\n' "$dir"
    exit 2
  fi
  printf 'mobile0: plan 1/5 - require maintained Termux, expected PREFIX, non-root account and private HOME path (not checked in demo)\n'
  printf 'mobile0: plan 2/5 - install or verify git, curl and proot-distro on the Termux host\n'
  printf 'mobile0: plan 3/5 - verify or fast-forward the canonical checkout; reuse Ubuntu or Debian, otherwise install Ubuntu\n'
  printf 'mobile0: plan 4/5 - bind the checkout at /pub5; install Linux build libraries and the guest's packaged compatible Ruby\n'
  printf 'mobile0: plan 5/5 - install/check the locked bundle with the packaged Ruby, prove the CLI boot in the selected guest, and install the Termux launcher\n'
  printf 'mobile0: DEMO complete; device, guest and repository checks remain unmeasured\n'
  exit 0
fi

command -v pkg >/dev/null 2>&1 || fail "run this inside Termux, installed from a maintained source."
case "${PREFIX:-}" in
  /data/data/com.termux/files/usr|/data/user/0/com.termux/files/usr) ;;
  *) fail "unexpected Termux PREFIX; refusing to install into an unverified environment." ;;
esac
[ "$(id -u)" != "0" ] || fail "refusing to install as root."
[ "$repo" = "$expected_repo" ] || fail "only the canonical HTTPS repository is allowed: $expected_repo"
[ -n "$branch" ] || fail "MASTER_BRANCH must not be empty."
case "$dir" in "$HOME"/*) ;; *) fail "install directory must be below Termux HOME." ;; esac
[ "$dir" != "$HOME" ] || fail "install directory cannot be HOME itself."
[ ! -L "$dir" ] || fail "install directory must not be a symbolic link."

if [ -e "$dir" ] && [ ! -d "$dir/.git" ]; then
  fail "$dir exists but is not a Git checkout; move it aside and retry."
fi

if ! command -v git >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 ||
   ! command -v proot-distro >/dev/null 2>&1; then
  printf 'mobile0: installing Termux host tools\n'
  pkg update -y
  pkg install -y git curl proot-distro
fi
command -v git >/dev/null 2>&1 || fail "git is still unavailable after pkg install."
command -v proot-distro >/dev/null 2>&1 || fail "proot-distro is still unavailable after pkg install."

if [ -d "$dir/.git" ]; then
  actual_origin="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
  [ "$actual_origin" = "$expected_repo" ] || fail "existing checkout origin must be the canonical HTTPS URL (found ${actual_origin:-<none>})."
  dirty="$(git -C "$dir" status --porcelain 2>/dev/null || true)"
  [ -z "$dirty" ] || fail "checkout has local or untracked changes; refusing to pull or execute it."
  current_branch="$(git -C "$dir" branch --show-current 2>/dev/null || true)"
  [ "$current_branch" = "$branch" ] || fail "checkout branch is $current_branch; expected $branch."
  printf 'mobile0: fast-forwarding the clean checkout to %s\n' "$branch"
  git -C "$dir" pull --ff-only origin "$branch"
else
  printf 'mobile0: cloning canonical pub5 branch %s\n' "$branch"
  git clone --depth 1 --branch "$branch" "$repo" "$dir"
fi

actual_origin="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
[ "$actual_origin" = "$expected_repo" ] || fail "checkout origin changed or is not canonical after clone/update."
git -C "$dir" rev-parse --verify HEAD >/dev/null 2>&1 || fail "checkout has no verifiable commit."
dirty="$(git -C "$dir" status --porcelain 2>/dev/null || true)"
[ -z "$dirty" ] || fail "checkout changed during update; refusing to execute it."

installed_distros="$(proot-distro list --quiet)" || fail "could not inventory installed PRoot-Distro guests."
case "$requested_distro" in
  auto)
    if printf '%s\n' "$installed_distros" | grep -Fxq ubuntu; then
      distro=ubuntu
    elif printf '%s\n' "$installed_distros" | grep -Fxq debian; then
      distro=debian
    else
      distro=ubuntu
    fi
    ;;
  ubuntu|debian) distro="$requested_distro" ;;
  *) fail "unsupported PRoot-Distro guest: $requested_distro" ;;
esac

if ! printf '%s\n' "$installed_distros" | grep -Fxq "$distro"; then
  printf 'mobile0: installing %s guest (existing guests are never reset)\n' "$distro"
  proot-distro install "$distro"
else
  printf 'mobile0: reusing existing %s guest\n' "$distro"
fi

guest_ready() {
  proot-distro login --bind "$dir:/pub5" "$distro" -- \
    env MASTER_RUNTIME_DISTRO="$distro" bash -lc '
      set -eu
      command -v ruby >/dev/null
      ruby -e '\''require "rubygems"; abort "Ruby >= 3.3 required" if Gem::Version.new(RUBY_VERSION) < Gem::Version.new("3.3")'\''
      actual="$(ruby -e "print RUBY_VERSION")"
      grep -Fx "$MASTER_RUNTIME_DISTRO $actual" /etc/master-mobile-runtime >/dev/null
    ' >/dev/null 2>&1
}

if guest_ready; then
  printf 'mobile0: %s guest and packaged Ruby are ready\n' "$distro"
else
  printf 'mobile0: provisioning %s with its packaged Ruby\n' "$distro"
  proot-distro login --bind "$dir:/pub5" "$distro" -- \
    env MASTER_RUNTIME_DISTRO="$distro" bash -s <<'PRootSetup'
set -eu
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends \
  ca-certificates git curl build-essential pkg-config zsh \
  ruby ruby-dev ruby-bundler \
  libssl-dev libreadline-dev zlib1g-dev libffi-dev libyaml-dev \
  libsqlite3-dev libvips-dev libxml2-dev libxslt1-dev \
  libgdbm-dev libdb-dev libncurses-dev libgmp-dev uuid-dev liblzma-dev

command -v ruby >/dev/null
ruby -e 'require "rubygems"; abort "Ruby >= 3.3 required; installed #{RUBY_VERSION}" if Gem::Version.new(RUBY_VERSION) < Gem::Version.new("3.3")'
ruby_version="$(ruby -e 'print RUBY_VERSION')"

cd /pub5/MASTER
printf 'mobile0: installing the locked MASTER bundle in %s with Ruby %s\n' "$MASTER_RUNTIME_DISTRO" "$ruby_version"
ruby bin/deps install
printf 'mobile0: checking the locked MASTER bundle in %s\n' "$MASTER_RUNTIME_DISTRO"
ruby bin/deps check
printf 'mobile0: proving the normal MASTER CLI boot path in %s\n' "$MASTER_RUNTIME_DISTRO"
ruby bin/deps boot
printf '%s %s\n' "$MASTER_RUNTIME_DISTRO" "$ruby_version" > /etc/master-mobile-runtime
chmod 644 /etc/master-mobile-runtime
printf 'mobile0: %s guest setup and CLI boot PASS; Android device capabilities remain unmeasured\n' "$MASTER_RUNTIME_DISTRO"
PRootSetup
fi

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\''/g"
}
launcher="$HOME/.local/bin/master"
mkdir -p "$HOME/.local/bin"
quoted_dir="$(shell_quote "$dir")"
{
  printf '%s\n' '#!/data/data/com.termux/files/usr/bin/bash' 'set -eu'
  printf 'ROOT=%s\n' "$quoted_dir"
  printf 'DISTRO=%s\n' "$(shell_quote "$distro")"
  cat <<'LauncherBody'
command -v proot-distro >/dev/null 2>&1 || {
  printf 'master0: proot-distro is unavailable; run the installer again.\n' >&2
  exit 78
}
if ! proot-distro list --quiet | grep -Fxq "$DISTRO"; then
  exec sh "$ROOT/MASTER/bin/master-mobile-install" "--$DISTRO" --launch -- "$@"
fi
if ! proot-distro login --bind "$ROOT:/pub5" "$DISTRO" -- \
  env MASTER_RUNTIME_DISTRO="$DISTRO" bash -lc '
    set -eu
    ruby -e '\''require "rubygems"; abort if Gem::Version.new(RUBY_VERSION) < Gem::Version.new("3.3")'\''
    actual="$(ruby -e "print RUBY_VERSION")"
    grep -Fx "$MASTER_RUNTIME_DISTRO $actual" /etc/master-mobile-runtime >/dev/null
  ' >/dev/null 2>&1; then
  exec sh "$ROOT/MASTER/bin/master-mobile-install" "--$DISTRO" --launch -- "$@"
fi
exec proot-distro login --bind "$ROOT:/pub5" "$DISTRO" -- bash -lc '
  set -eu
  command -v ruby >/dev/null
  ruby -e '\''require "rubygems"; abort if Gem::Version.new(RUBY_VERSION) < Gem::Version.new("3.3")'\''
  cd /pub5/MASTER
  exec bin/master "$@"
' master "$@"
LauncherBody
} > "$launcher"
chmod 700 "$launcher"

printf 'mobile0: %s guest is ready. The launcher is %s\n' "$distro" "$launcher"
printf 'mobile0: reload your shell or run %s/master\n' "$HOME/.local/bin"

if [ "$launch" -eq 1 ]; then
  exec "$launcher" "$@"
fi
