#!/usr/bin/env zsh
# Workstation deploy entrypoint — one command, hands-off by default.
#
#   MASTER/bin/redeploy                 # full production deploy: mirror + MASTER + active RAILS
#   MASTER/bin/redeploy rails           # every active RAILS app, serially
#   MASTER/bin/redeploy brgen           # one app
#   MASTER/bin/redeploy --follow        # attach to the box tmux session
#   MASTER/bin/redeploy --detach        # start and return immediately
#
# Requires: clean origin/main, SSH as dev@brgen.no. doas is nopass on vm23.
# Survives SSH drop via tmux session pub5-deploy. Log: ~/vps-deploy.log.
# Target names are checked against RAILS/apps.yml before SSH; do not keep a second app list here.
set -euo pipefail
bin_dir=$(cd -- "$(dirname "$0")" && pwd)
app=all
mode=()
for arg in "$@"; do
  case $arg in
    --follow) mode=(--follow) ;;
    --detach) mode=(--detach) ;;
    -h|--help)
      print -r -- "usage: MASTER/bin/redeploy [all|GROUP|APP] [--follow|--detach]"
      print -r -- "  rails: every active RAILS app, serially; all: mirror + MASTER + active RAILS"
      print -r -- "  default: wait for deploy, print progress, run state + public canary"
      exit 0
      ;;
    *)
      case $arg in
        ''|[!a-z]*|*[!a-z0-9_-]*)
          print -u2 "redeploy: invalid target: $arg"
          print -u2 -- "usage: MASTER/bin/redeploy [all|GROUP|APP] [--follow|--detach]"
          exit 2
          ;;
        *) app=$arg ;;
      esac
      ;;
  esac
done
exec "$bin_dir/operator" vps deploy "$app" --remote "${mode[@]}"
