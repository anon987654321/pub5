#!/usr/bin/env ruby
# frozen_string_literal: true
# Run the focused MASTER acceptance regressions, including /fix lifecycle, on compatible Ruby.
# Usage (from MASTER/): bin/verify-focused
# Exit 0 only if every listed file reports 0 failures and 0 errors.

require "rbconfig"
require_relative "../lib/operator/ruby_runner"
require "open3"

ROOT = File.expand_path("..", __dir__)
Dir.chdir(ROOT)

begin
  ruby = Operator::RubyRunner.ruby_cmd
  bundle = Operator::RubyRunner.bundle_cmd
rescue StandardError => e
  warn "BLOCKED: compatible Ruby/Bundler selection failed: #{e.class}: #{e.message}"
  exit 127
end

selected_version = Operator::RubyRunner.version_for(ruby)
puts "ruby=#{selected_version || "unknown"} path=#{ruby} runner_ruby=#{RUBY_VERSION}"
puts "cwd=#{ROOT}"

begin
  bundler_output, bundler_status = Open3.capture2e(bundle, "--version", chdir: ROOT)
rescue SystemCallError => e
  warn "BLOCKED: selected Bundler is unavailable (#{bundle}): #{e.class}: #{e.message}"
  exit 127
end
unless bundler_status.success?
  warn "BLOCKED: selected Bundler preflight failed (exit #{bundler_status.exitstatus}): #{bundler_output.to_s.lines.last(3).join.strip}"
  exit(bundler_status.exitstatus || 127)
end
puts bundler_output.to_s.strip

dependencies_output, dependencies_status = Open3.capture2e(bundle, "check", chdir: ROOT)
unless dependencies_status.success?
  warn "BLOCKED: selected Bundler dependencies are incomplete."
  warn dependencies_output.to_s.lines.last(12).join
  exit(dependencies_status.exitstatus || 127)
end

tests = %w[
  test/test_final_cleanup.rb
  test/test_fix_loop_observability.rb
  test/test_law_parity.rb
  test/test_fix_kernel_lifecycle.rb
  test/test_recovery_gates.rb
  test/test_fix_convergence.rb
  test/test_fix_convergence_wiring.rb
  test/test_fix_mission.rb
  test/test_core_no_lib_backedges.rb
  test/test_fix_interruption_restart.rb
  test/test_fix_loop_committer.rb
  test/test_candidate_threads.rb
  test/test_io_git_operations.rb
  test/test_core_world.rb
  test/test_master_boot.rb
  test/test_task_steward.rb
  test/test_core_bridge.rb
  test/test_fix_plan.rb
  test/test_fix_protocol.rb
  test/test_backlog.rb
  test/test_task_contract.rb
  test/test_artifact_preservation.rb
  test/test_fix_model_phase_guards.rb
  test/test_stream_stage.rb
  test/test_ast_fixer_transforms.rb
  test/test_ast_fixer_safety.rb
  test/test_autofix_guard.rb
  test/test_autofix_safety_tier.rb
  test/test_scan_autofix.rb
  test/test_semantic_budget.rb
  test/test_fix_transaction.rb
  test/test_reliability_second_tranche.rb
  test/test_fix_crash_leaves_tree.rb
  test/test_fix_hardening.rb
  test/test_fix_loop_priorities.rb
  test/test_conflict_resolver_priority.rb
  test/test_conflict_resolver_log_rotation.rb
  test/test_soul.rb
  test/test_replay_reader.rb
  test/test_media_lanes.rb
  test/test_tools_media.rb
  test/test_law_registry_audit.rb
  test/test_boot_checks.rb
  test/test_provider_config.rb
  test/test_runtime_catalogue_validation.rb
  test/test_master_loop.rb
  test/test_yaml_registries.rb
  test/test_visual_pass.rb
  test/test_visual_ghost_stack.rb
  test/test_visual_completion.rb
  test/test_rendered_visual_convergence.rb
  test/test_assessment_matrix_rendered_evidence.rb
  test/test_fix_loop_oscillation.rb
  test/test_fix_run_budget.rb
  test/test_fix_model_gate.rb
  test/test_fix_watchdog.rb
  test/test_llm_stage_failure.rb
  test/test_run_ledger_per_run.rb
  test/test_reachability_scope.rb
  test/test_repair_loop_per_fix_commit.rb
  test/test_ingress_jobs.rb
  test/test_security_audit.rb
  test/test_io_atomic_write.rb
  test/test_security_headers_source_check.rb
  test/test_check_runner_registry.rb
  test/test_turn_router.rb
  test/test_command_registry_dispatch.rb
  test/test_architecture_exploration.rb
  test/test_run_journal_lifecycle.rb
  test/test_fix_kernel.rb
  test/test_check_chain.rb
  test/test_strict_mode.rb
  test/test_ecosystem_features.rb
  test/test_compute_pool.rb
  test/test_provider_concurrency.rb
  test/test_keyless_routing.rb
  test/test_llm_dispatcher.rb
  test/test_event_privacy.rb
  test/test_trace_log_append_jsonl.rb
  test/test_trace_metrics_log.rb
  test/test_trace_telemetry.rb
  test/test_trace_recorder_storage.rb
  test/test_dom_surface_seo_metadata.rb
  test/test_cli_boot_e2e.rb
]

missing = tests.reject { |t| File.file?(t) }
if missing.any?
  warn "MISSING test files:\n#{missing.join("\n")}"
end

results = []
tests.each do |t|
  next unless File.file?(t)
  cmd = [bundle, "exec", ruby, "-Ilib:test", t]
  puts "\n## #{t}"
  status_code = nil
  test_summary = nil
  begin
    Open3.popen2e(*cmd) do |stdin, stdout, wait_thread|
      stdin.close
      stdout.each_line do |line|
        $stdout.write(line)
        $stdout.flush
        test_summary = line if line.match?(/\b\d+ runs?,\s+\d+ assertions?,\s+\d+ failures?,\s+\d+ errors?\b/)
      end
      status_code = wait_thread.value.exitstatus
    end
  rescue SystemCallError => e
    warn "runner_error=#{e.class}: #{e.message}"
    status_code = 127
  end
  if status_code == 0
    run_count = test_summary.to_s[/\b(\d+) runs?\b/, 1]&.to_i
    if run_count.nil?
      warn "runner_error=missing Minitest summary; a zero exit alone is not acceptance evidence"
      status_code = 1
    elsif run_count.zero?
      warn "runner_error=Minitest executed zero tests"
      status_code = 1
    end
  end
  puts "exit=#{status_code.inspect}"
  results << [t, status_code]
end

failed = results.reject { |_, code| code == 0 }
puts "\n== summary =="
puts "ran=#{results.size} failed=#{failed.size} missing=#{missing.size}"
failed.each { |t, code| puts "FAIL #{t} exit=#{code.inspect}" }
exit(failed.empty? && missing.empty? ? 0 : 1)
