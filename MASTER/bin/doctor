#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/boot/entrypoint"

ROOT = File.expand_path("..", __dir__)
Master::Boot::Entrypoint.prepare!(root: ROOT)

require_relative "../lib/io/exec"
require "socket"
require "yaml"
require_relative "../lib/trace/dmesg"

REPO = File.expand_path("..", ROOT)
$LOAD_PATH.unshift File.join(ROOT, "lib")
require "ground/env_loader"
Master::Ground::EnvLoader.load!

# A check has three answers, not two.
#
# `ok` was a boolean, so a check that could not measure anything had to lie in
# one direction or the other, and both lies were in the file. model-quota and
# cache-efficiency returned `ok: true, detail: "module not loaded"` — printing
# OK for a check nobody ran, which is the green line that means nobody looked.
# content-dedup went the other way: it raised into `ok: false`, so a crashed
# instrument was indistinguishable from a real finding.
#
# `state` is :pass, :fail or :unmeasured. Unmeasured never fails the exit
# code — an absent optional module is not a sick host — but it is printed as
# its own word and counted in its own line, which is the whole point. The
# check runner already works this way: "2 check(s) measured nothing, and why".
#
# ok stays as a reader so nothing downstream breaks on the shape change.
Check = Struct.new(:name, :state, :detail, keyword_init: true) do
  def ok = state != :fail
  def unmeasured? = state == :unmeasured
  def label = { pass: "OK", fail: "FAIL", unmeasured: "SKIP" }.fetch(state, "FAIL")
end

def fail_check(name, detail) = Check.new(name:, state: :fail, detail:)
def unmeasured(name, detail) = Check.new(name:, state: :unmeasured, detail:)

def run(*argv, chdir: ROOT)
  stdout, stderr, status = Master::Io::Exec.capture3(*argv, chdir: chdir)
  [status.success?, stdout.strip, stderr.strip]
rescue Errno::ENOENT => e
  [false, "", e.message]
end

def check_ruby
  ok, out, err = run("ruby", "--version")
  version = out[/ruby (\d+\.\d+\.\d+)/, 1]
  good = ok && version && Gem::Version.new(version) >= Gem::Version.new("3.3.0")
  Check.new(name: "ruby", state: (good) ? :pass : :fail, detail: out.empty? ? err : out)
end

def check_command(name, *cmd)
  ok, out, err = run(*cmd, chdir: REPO)
  Check.new(name:, state: ok ? :pass : :fail, detail: ok ? out.lines.first.to_s.strip : err)
end

def check_dependencies
  require_relative "../lib/boot/dependency_manager"
  status = Master::Boot::DependencyManager.new(root: ROOT).status
  ok = status[:bundle_ok]
  detail = if ok
             "bundle #{status[:bundler].empty? ? "unversioned" : status[:bundler]} ready"
           else
             status[:bundle_output].to_s.lines.first.to_s.strip
           end
  Check.new(name: "dependencies", state: ok ? :pass : :fail, detail: detail)
rescue StandardError => e
  Check.new(name: "dependencies", state: :fail, detail: "#{e.class}: #{e.message}")
end

def check_yaml
  errors = Dir.glob(File.join(ROOT, "data", "**", "*.yml")).filter_map do |path|
    YAML.safe_load_file(path, aliases: true, permitted_classes: [Date, Time])
    nil
  rescue Psych::Exception => e
    "#{path.sub(ROOT + '/', '')}: #{e.message.lines.first.to_s.strip}"
  end
  Check.new(name: "yaml", state: (errors.empty?) ? :pass : :fail, detail: errors.empty? ? "ok" : errors.join("; "))
end

# Advisory only, matching LawMapRepair's dangling-reference check --
# which duplicate is "correct" when two differ even slightly isn't safe to
# guess, so this reports rather than fixes (see ContentDedupScan's header).
def check_content_dedup
  require "fix/content_dedup_scan"
  dups = Master::Fix::ContentDedupScan.scan(root: ROOT)
  detail = dups.empty? ? "no duplicate lines" : "#{dups.size} duplicate line(s), top: #{dups.first.text[0, 50]} (x#{dups.first.count})"
  # ok: true unconditionally -- advisory only, never fails doctor's exit code.
  Check.new(name: "content-dedup", state: :pass, detail:)
rescue StandardError => e
  # An advisory check cannot fail the host by crashing when its finding never can.
  Check.new(name: "content-dedup", state: :unmeasured, detail: "#{e.class}: #{e.message}")
end

def check_api_keys
  keys = %w[XAI_API_KEY OPENROUTER_API_KEY ANTHROPIC_API_KEY OPENAI_API_KEY DEEPSEEK_API_KEY GEMINI_API_KEY]
  present = keys.select { |var| ENV[var].to_s.length >= 16 }
  if present.any?
    return Check.new(name: "api-keys", state: :pass, detail: present.join(", "))
  end
  # The route now discovers anonymous hosted APIs before browser chat. This is
  # configuration evidence only; --keyless performs the real completion probe.
  Check.new(name: "api-keys", state: :pass, detail: "no API key; hosted keyless catalogue and browser fallback are eligible")
end

def check_tts_socket
  speech = Master::Voice::Speech.available?
  playback = Master::Voice::Playback.available?
  return Check.new(name: "tts-socket", state: :pass, detail: "local speech/playback ready") if speech && playback

  path = File.join(ROOT, ".master", "tts.sock")
  alive = File.socket?(path) && (UNIXSocket.open(path, &:close); true)
  Check.new(name: "tts-socket", state: alive ? :pass : :fail,
            detail: alive ? path : "no local audio path and no TTS socket")
rescue StandardError => e
  Check.new(name: "tts-socket", state: :fail, detail: e.message)
end

# The ear check the 2026-11-08 operator transcript left open: tts-socket only
# proves the wiring loads, while "voice0: audio playback failed" reached the
# terminal and no sound reached the operator. This check speaks one synchronous
# utterance through the real chain and records the receipt the transcript asked
# for - player, engine, the utterance's outcome, and the first failure line if
# the chain degraded on its way. A host with no output path, a pipe or a CI run
# measured nothing: sound through a speaker is the one thing a container cannot
# verify about itself, so the honest answer is skip, not a guess in either
# direction.
def check_voice_utterance
  reason =
    if !Master::Voice::Playback.available?
      "no audio output on this host (looked for #{Master::Voice::Playback::PLAYERS.keys.join(', ')} and native speech)"
    elsif ENV["CI"] || ENV["MASTER_SKIP_TTS"] == "1" || !$stdout.tty?
      "sound through a speaker cannot be verified from a pipe or CI run"
    end
  if reason
    return Check.new(name: "voice-utterance", state: :unmeasured,
                     detail: "#{reason}; INCONCLUSIVE by construction")
  end

  spoken = Master::Voice::Playback.speak_now("MASTER voice check. If you can hear this, the ear row is closed.")
  player = Master::Voice::Playback.player&.first || "native speech"
  engine = Master::Voice::Speech.last_engine || "none"
  synth_failure = Master::Voice::Speech.last_error
  play_failure = Master::Voice::Playback.last_error
  unless spoken
    first = [synth_failure, play_failure].compact.first || "speak_now reported failure without naming one"
    return Check.new(name: "voice-utterance", state: :fail,
                     detail: "no sound reached the ear, first failure: #{first.lines.first.to_s.strip}")
  end

  detail = "player=#{player}, engine=#{engine}, utterance played"
  detail += "; degraded chain, first failure: #{synth_failure.lines.first.to_s.strip}" if synth_failure
  Check.new(name: "voice-utterance", state: :pass, detail:)
rescue StandardError => e
  Check.new(name: "voice-utterance", state: :fail, detail: "#{e.class}: #{e.message.lines.first.to_s.strip}")
end

# The face's ear: whisper.cpp and a model, else Gemini. A phone with neither
# fails, and says where its setup stands; any other host without one measured
# nothing, because the deploy box has no microphone to hear with.
def check_face_stt
  words = Master::CLI::Face::Transcriber.new
  detail = words.describe
  return Check.new(name: "face-stt", state: :pass, detail:) if words.lane
  return unmeasured("face-stt", "#{detail}; the face types instead") unless Master::Device.android?

  fail_check("face-stt", "#{detail}; setup: #{Master::Device::Setup.new.progress}")
rescue NameError, LoadError => e
  unmeasured("face-stt", "#{e.class}: #{e.message}")
end

def check_web_token
  web_requested = ENV["MASTER_WEB_LIVE"] == "1" ||
                  ENV["MASTER_WEB_CHAT"] == "1" ||
                  File.file?(File.join(ROOT, ".master", "web.pid"))
  unless web_requested
    return unmeasured("web-token", "web surface not enabled")
  end

  cfg_path = File.join(ROOT, ".master", "config.yml")
  cfg = begin
    YAML.safe_load_file(cfg_path, aliases: true, permitted_classes: [Symbol])
  rescue Psych::Exception, SystemCallError => e
    return fail_check("web-token", "#{cfg_path.sub(ROOT + '/', '')}: #{e.class}: #{e.message.lines.first.to_s.strip}")
  end
  tok = cfg["web_token"].to_s
  Check.new(name: "web-token", state: tok.length >= 8 ? :pass : :fail,
            detail: tok.empty? ? "unset in .master/config.yml" : "configured")
end

def check_key_rotator
  count = Master::Io::KeyRotator.keys.size
  Check.new(name: "key-rotator", state: (count.positive?) ? :pass : :fail, detail: "#{count} OpenRouter key(s)")
rescue NameError
  keys = %w[OPENROUTER_API_KEY OPENROUTER_API_KEY_2 OPENROUTER_API_KEY_3]
  count = keys.count { |var| ENV[var].to_s.length >= 16 }
  Check.new(name: "key-rotator", state: (count.positive?) ? :pass : :fail, detail: "#{count} OpenRouter key(s)")
end

def check_model_quota
  require "io/model_quota" unless defined?(Master::Io::ModelQuota)
  snap = Master::Io::ModelQuota.snapshot
  models = snap[:models].is_a?(Hash) ? snap[:models] : {}
  provider = snap[:provider]
  provider_measured = provider.is_a?(Hash) && provider[:fresh] == true &&
                     provider[:remaining].is_a?(Numeric)
  exhausted = Array(snap[:exhausted])
  exhausted << "openrouter:free" if provider_measured && provider[:remaining].zero?
  exhausted.uniq!

  if models.empty? && !provider_measured && exhausted.empty?
    return Check.new(
      name: "model-quota", state: :unmeasured,
      detail: "no quota observations for tracked lanes",
    )
  end

  detail = if exhausted.any?
             "exhausted: #{exhausted.join(', ')}"
           elsif models.any?
             "ok (#{models.size} tracked)"
           else
             "ok (OpenRouter reports #{provider[:remaining]} remaining)"
           end
  Check.new(name: "model-quota", state: exhausted.empty? ? :pass : :fail, detail:)
rescue NameError
  Check.new(name: "model-quota", state: :unmeasured, detail: "Io::ModelQuota did not load")
end

def check_cache_efficiency
  snap = Master::Trace::CacheEfficiency.snapshot
  Check.new(name: "cache-efficiency", state: :pass,
            detail: "#{snap[:efficiency_pct]}% (#{snap[:cached_tokens]}/#{snap[:input_tokens]} tokens)")
rescue NameError
  Check.new(name: "cache-efficiency", state: :unmeasured, detail: "Trace::CacheEfficiency did not load")
end

def check_provider_catalog
  path = File.join(ROOT, "bin", "provider-catalog")
  Check.new(name: "provider-catalog", state: (File.exist?(path)) ? :pass : :fail, detail: File.exist?(path) ? path : "missing")
end

require "master"

# A deliberate, small completion probe. It clears configured hosted-provider
# keys for this process only, forces the anonymous lane policy, and restores the
# environment on every exit. This proves POST /chat/completions, not GET /models.
def check_keyless_completion
  return fail_check("keyless-probe", "MASTER_NO_KEYLESS=1 explicitly disables anonymous lanes") if ENV["MASTER_NO_KEYLESS"].to_s != ""

  rows = Master.models_config(root: ROOT).fetch("openai_compatible", {})
  key_names = rows.values.grep(Hash).flat_map { |row| Array(row["key_env"]) }.uniq
  saved = key_names.to_h { |name| [name, ENV.delete(name)] }
  old_free_only = ENV["MASTER_FREE_ONLY"]
  old_model = ENV["MASTER_MODEL"]
  ENV["MASTER_FREE_ONLY"] = "1"
  ENV.delete("MASTER_MODEL")
  Master::Io::LaneSelection.reset_hosted_resolver!

  resolver = Master::CLI::Routing::ModelRouter.hosted_resolver(root: ROOT)
  candidates = Array(resolver.hosted_models).reject { |id| Master::Io::ModelQuota.over_quota?(id) }
  return fail_check("keyless-probe", "no eligible anonymous hosted model is currently listed") if candidates.empty?

  Master::Soul.load!
  runtime = Master::Builder.build(root: ROOT)
  agent = runtime[:agent]
  return fail_check("keyless-probe", "agent builder returned no Review::Agent") unless agent

  previous_tools = Fiber[:master_no_tools]
  Fiber[:master_no_tools] = true
  failures = []
  candidates.first(3).each do |model|
    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    begin
      answer = Timeout.timeout(18) do
        agent.ask_once("Reply with exactly OK.", model:, law: false, temperature: 0.0, failover: false)
      end
      elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
      return Check.new(name: "keyless-probe", state: :pass,
                       detail: "#{model} answered in #{format('%.2f', elapsed)}s (#{answer.to_s.strip[0, 24]})") unless answer.to_s.strip.empty?

      failures << "#{model}: empty completion"
    rescue StandardError => e
      failures << "#{model}: #{e.class}: #{e.message.to_s.lines.first.to_s.strip[0, 120]}"
    end
  end
  fail_check("keyless-probe", failures.join("; "))
rescue StandardError => e
  fail_check("keyless-probe", "#{e.class}: #{e.message.to_s.lines.first.to_s.strip}")
ensure
  Fiber[:master_no_tools] = previous_tools
  Master::Io::LaneSelection.reset_hosted_resolver! if defined?(Master::Io::LaneSelection)
  key_names&.each { |name| saved&.fetch(name, nil) ? ENV[name] = saved[name] : ENV.delete(name) }
  old_free_only.nil? ? ENV.delete("MASTER_FREE_ONLY") : ENV["MASTER_FREE_ONLY"] = old_free_only
  old_model.nil? ? ENV.delete("MASTER_MODEL") : ENV["MASTER_MODEL"] = old_model
end

if ARGV.delete("--keyless")
  check = check_keyless_completion
  puts "#{check.label} keyless-probe: #{check.detail}"
  exit(check.ok ? 0 : 1)
end

if ARGV.include?("--fix")
  require "fileutils"
  require "set"
  require "fix/law_map_repair"
  fixed = Master::Fix::LawMapRepair.fix!(root: ROOT)
  if fixed.any?
    Master::Trace::Dmesg.status("doctor0", "removed #{fixed.size} dangling law reference(s) from laws.yml#law_map")
    fixed.each { |id, rid| Master::Trace::Dmesg.status("doctor0", "#{id}, removed #{rid}") }
  else
    Master::Trace::Dmesg.status("doctor0", "laws.yml law_map ids clean, nothing to repair")
  end
end

checks = [
  check_ruby,
  check_command("git", "git", "--version"),
  check_command("sqlite3", "ruby", "-e", "require 'sqlite3'; puts SQLite3::SQLITE_VERSION"),
  check_dependencies,
  check_yaml,
  check_content_dedup,
  check_api_keys,
  check_tts_socket,
  check_voice_utterance,
  check_face_stt,
  check_web_token,
  check_key_rotator,
  check_model_quota,
  check_cache_efficiency,
  check_provider_catalog,
]

Master::Trace::Dmesg.attach("doctor0", "master0", "MASTER doctor, #{checks.size} checks")
checks.each_with_index do |check, index|
  Master::Trace::Dmesg.attach("doctor#{index}", "doctor0", "#{check.name}, #{check.label.downcase}")
  Master::Trace::Dmesg.status("doctor#{index}", check.detail)
end

# The receipt, under the probes rather than instead of them. doctor answers
# "is this host well"; the receipt answers "what did this process boot with",
# and the second question had no answer anywhere.
begin
  require "master"
  require "review/scan/law_tree"
  Master::Trace::Dmesg::Report.print("receipt0", Master::Ground::BootReceipt.lines.join("\n"), parent: "doctor0")
  Master::Trace::Dmesg.status("doctor0", Master::Ground::MaturityScorecard.load.summary_line)
rescue StandardError => e
  Master::Trace::Dmesg.status("receipt0", "unavailable, #{e.class}: #{e.message.lines.first.to_s.strip}")
end

# Named, not skipped. A host with three unmeasured checks is not the same host
# as one with none, and the exit code cannot say so — so the line does.
unmeasured_checks = checks.select(&:unmeasured?)
if unmeasured_checks.any?
  Master::Trace::Dmesg.attach("doctor0", "master0", "#{unmeasured_checks.size} checks measured nothing")
  unmeasured_checks.each { |check| Master::Trace::Dmesg.status("doctor0", "#{check.name}, #{check.detail}") }
end

failed = checks.reject(&:ok)
exit(failed.empty? ? 0 : 1)
