when "visual"
  # seed|unseed|status load local development content; approve blesses.
  exec(RbConfig.ruby, File.join(ROOT, "MASTER", "tools", "rails", "visual_seed.rb"), *ARGV) if %w[seed unseed status].include?(ARGV.first)
  # Blesses a parked chrome-geometry baseline; the /fix loop never does this itself.
  require File.join(ROOT, "MASTER", "lib", "fix", "visual_drift_budget")
  if ARGV.first == "sweep"
    # Raw captures are revision-stamped outside the repo, in temp; the curated
    # review shots land flat in RAILS/. --one-page is the quick rendering smoke;
    # the full /fix lane retains every declared width/page.
    require "json"
    require File.join(ROOT, "MASTER", "lib", "fix", "screenshot_sweep")
    args = ARGV.drop(1)
    one_page = args.delete("--one-page")
    no_dialogs = args.delete("--no-dialogs")
    unknown = args.grep(/\A--/)
    abort("visual sweep: unknown option(s): #{unknown.join(", ")}") unless unknown.empty?
    apps = args
    abort("usage: bin/operator visual sweep APP --one-page") if one_page && apps.size != 1

    sweep = Master::Fix::ScreenshotSweep.new(root: ROOT, widths: one_page ? [390] : nil)
    summary = sweep.run(
      apps:, dialogs: !no_dialogs && !one_page,
      max_pages: one_page ? 1 : Master::Fix::ScreenshotSweep::MAX_PAGES,
    )
    puts JSON.pretty_generate(summary.except("rows"))
    puts "screenshots0: #{summary["directory"]}"
    exit(summary["error"] ? 1 : 0)
  end
  if ARGV.first == "review"
    require "master"
    require "operator/visual_review"
    exit Operator::VisualReview.main(ARGV.drop(1), root: ROOT)
  end
  sub, surface = ARGV
  if sub == "taste"
    # The operator's verdict on a rendered layout; the loop never writes one.
    verdict, id = ARGV[1], ARGV[2]
    note = ARGV[(ARGV.index("--note").to_i + 1)..].first if ARGV.include?("--note")
    abort("usage: visual taste approve|reject <app/label/viewport> [--note TEXT]") unless %w[approve reject].include?(verdict) && id
    entry = Master::Fix::TasteMemory.operator(root: ROOT, surface: id, verdict: verdict == "approve" ? "approved" : "rejected", note:)
    puts "visual: #{id} #{entry["verdict"]} (#{entry["role"]}, #{entry["selectors"].size} selector(s))"
    exit
  end
  pending = Master::Fix::VisualDriftBudget.pending(ROOT)
  abort("usage: visual approve <surface>   (pending: #{pending.empty? ? "none" : pending.join(", ")})") unless sub == "approve" && surface
  blessed = Master::Fix::VisualDriftBudget.approve(surface, root: ROOT)
  abort("visual: nothing pending for #{surface}") unless blessed
  puts "visual: #{surface} baseline now #{blessed} chrome box(es)"
