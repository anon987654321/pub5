def operator_runtime_config
  @operator_runtime_config ||= begin
    path = File.join(OPENBSD_OPS, "data", "operator.yml")
    data = YAML.safe_load(File.read(path, encoding: "UTF-8"), aliases: false)
    raise "OPENBSD/data/operator.yml must contain a mapping" unless data.is_a?(Hash)
    meta = data.fetch("meta")
    raise "OPENBSD/data/operator.yml meta must contain vps and ssh_identity_file" unless
      meta.is_a?(Hash) && meta["vps"].is_a?(String) && meta["ssh_identity_file"].is_a?(String)
    data
  end
end

def ssh_host
  ENV.fetch("PUB5_SSH_HOST") { operator_runtime_config.fetch("meta").fetch("vps") }
end

def ssh_key
  configured = operator_runtime_config.fetch("meta").fetch("ssh_identity_file")
  File.expand_path(ENV.fetch("PUB5_SSH_KEY", configured))
end

# Fail locally and clearly before asking OpenSSH to connect. Never chmod or
# replace an operator's identity automatically.
def ssh_access_refusal
  ssh_found = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |directory|
    path = File.join(directory, "ssh")
    File.file?(path) && File.executable?(path)
  end
  return "OpenSSH client 'ssh' is not available on PATH" unless ssh_found

  target = ssh_host
  unless target.match?(/\A[A-Za-z0-9_.-]+@[A-Za-z0-9.-]+\z/)
    return "invalid vm23 SSH target in OPENBSD/data/operator.yml: #{target.inspect}"
  end
  configured_user = operator_runtime_config.fetch("meta").fetch("vps").split("@", 2).first
  target_user = target.split("@", 2).first
  unless target_user == configured_user
    return "vm23 SSH login must remain #{configured_user}; refusing target user #{target_user}"
  end

  key = ssh_key
  stat = File.lstat(key)
  return "SSH identity is not a regular file: #{key}" unless stat.file?
  return "SSH identity must be owned by the current operator (uid #{Process.uid}): #{key}" unless stat.uid == Process.uid
  if (stat.mode & 0o077) != 0
    return format("SSH identity permissions are too open (%04o): run chmod 600 %s", stat.mode & 0o777, key)
  end
  return "SSH identity is not readable: #{key}" unless File.readable?(key)

  nil
rescue Errno::ENOENT
  "SSH identity not found at #{ssh_key}; check OPENBSD/data/operator.yml or PUB5_SSH_KEY"
rescue SystemCallError => error
  "SSH identity cannot be checked (#{error.class}: #{error.message})"
rescue StandardError => error
  "vm23 SSH configuration cannot be read (#{error.class}: #{error.message})"
end

def ssh_log_path
  File.expand_path(ENV.fetch("PUB5_SSH_LOG", "~/.pub5/ssh-connections.log"))
end

def ssh_log(event, detail = nil)
  path = ssh_log_path
  FileUtils.mkdir_p(File.dirname(path))
  line = "#{Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")} host=#{ssh_host} event=#{event}"
  line += " #{detail}" if detail && !detail.empty?
  File.open(path, "a") { |f| f.puts(line) }
rescue StandardError => e
  warn "ssh-log: #{e.message}"
end

# A command for the box that runs a Ruby script with whatever Ruby the box has.
# The resolution happens there, through OPENBSD/lib/ruby_select.sh, never here.
def remote_ruby(*argv)
  resolver = %q(. OPENBSD/lib/ruby_select.sh && exec "$RUBY" "$@")
  "cd /home/dev/pub5 && #{Shellwords.join(["sh", "-c", resolver, "sh", *argv])}"
end

def ssh_base_argv
  log = ssh_log_path
  FileUtils.mkdir_p(File.dirname(log))
  [
    "ssh",
    "-o", "BatchMode=yes",
    "-o", "IdentitiesOnly=yes",
    "-o", "StrictHostKeyChecking=yes",
    "-o", "ConnectTimeout=#{ENV.fetch("PUB5_SSH_CONNECT_TIMEOUT", "15")}",
    "-o", "ConnectionAttempts=#{ENV.fetch("PUB5_SSH_CONNECTION_ATTEMPTS", "3")}",
    "-o", "ServerAliveInterval=15",
    "-o", "ServerAliveCountMax=8",
    "-o", "LogLevel=#{ENV.fetch("PUB5_SSH_LOG_LEVEL", "INFO")}",
    "-E", log, # OpenSSH appends protocol diagnostics here
    "-i", ssh_key,
    ssh_host,
  ]
end

# Direct Open3/exec SSH calls bypass Io::Shell, so the operator's one
# transport boundary asks the same OpenBSD admission law before connecting.
def ssh_manual_preflight_refusal(remote_cmd)
  contract = Master::Fix::TaskContract.current ||
    Master::Fix::TaskContract.build(
      intent: "functional_change", scope: ["OPENBSD/**"], preserve: [], proof: []
    )
  Master::Fix::OpenBSDManualPreflight.refusal_for_ssh_argv(
    ssh_argv: ssh_base_argv, remote_command: remote_cmd,
    contract:, repo_root: ROOT
  )
rescue Master::Fix::TaskContract::Invalid => error
  "RTFM_FIRST blocked: #{error.message}"
end

# Replace the process with ssh (no local retry — ConnectionAttempts covers
# handshake retries). Log intent before exec; the -E file records the session.
def ssh_run(remote_cmd)
  require "fileutils"
  if (reason = ssh_access_refusal)
    die("vps", reason, 78)
  end
  if (reason = ssh_manual_preflight_refusal(remote_cmd))
    die("vps", reason, 78)
  end
  summary = remote_cmd.to_s.gsub(/\s+/, " ")[0, 120]
  ssh_log("connect", "cmd=#{summary.inspect}")
  cmd = ssh_base_argv + [remote_cmd]
  exec(*cmd)
end

# Capture mode with explicit retries for read-only probes (state, canary).
def ssh_capture(remote_cmd, attempts: Integer(ENV.fetch("PUB5_SSH_RETRIES", "3")))
  require "fileutils"
  require "open3"
  if (reason = ssh_access_refusal)
    return ["SSH preflight blocked: #{reason}", false]
  end
  if (reason = ssh_manual_preflight_refusal(remote_cmd))
    return ["RTFM_FIRST blocked: #{reason}", false]
  end
  summary = remote_cmd.to_s.gsub(/\s+/, " ")[0, 120]
  delay = 2
  last_err = nil
  attempts.times do |i|
    ssh_log("attempt", "n=#{i + 1}/#{attempts} cmd=#{summary.inspect}")
    out, status = Open3.capture2e(*ssh_base_argv, remote_cmd)
    if status.success?
      ssh_log("ok", "n=#{i + 1} bytes=#{out.bytesize}")
      return [out, true]
    end
    last_err = out.to_s.lines.last(5).join.strip
    ssh_log("fail", "n=#{i + 1} exit=#{status.exitstatus} err=#{last_err[0, 160].inspect}")
    if i < attempts - 1
      sleep delay
      delay = [delay * 2, 30].min
    end
  end
  [last_err.to_s, false]
rescue SystemCallError => error
  ["SSH transport could not start (#{error.class}: #{error.message})", false]
end

# vps-deploy keeps its output in the remote tmux pane only. This workstation
# collector streams that in-memory scrollback into a private local file, so an
# SSH interruption does not force a production transcript onto vm23's disk.
def remote_deploy_capture_command(session)
  target = "#{session}:0.0"
  "if tmux has-session -t #{Shellwords.escape(session)} 2>/dev/null; then " \
    "tmux capture-pane -p -J -S - -t #{Shellwords.escape(target)}; " \
    "else print __PUB5_DEPLOY_NO_SESSION__; fi"
end

# The tmux pane outlives the deploy by a day so the collector can still read
# its exit marker after an SSH drop; the collector kills the session itself.
DEPLOY_PANE_HOLD_SECONDS = 86_400
DEPLOY_PANE_HISTORY_LINES = 100_000

# The deploy as tmux runs it: vps-deploy, then its exit printed into the pane.
def remote_deploy_tmux_command(remote_command, log_ref)
  inner = [
    "set +e",
    "export VPS_DEPLOY_LOG=/dev/null",
    "export VPS_DEPLOY_RUN_LOG=/dev/null",
    "export VPS_DEPLOY_LOGGING=1",
    "export VPS_DEPLOY_LOG_REF=#{Shellwords.escape(log_ref)}",
    remote_command,
    "ec=$?",
    "print -r -- \"PUB5_DEPLOY_EXIT=$ec\"",
    "sleep #{DEPLOY_PANE_HOLD_SECONDS}",
  ].join("; ")
  "zsh -lc #{Shellwords.escape(inner)}"
end

# The one remote launch script: start that deploy in a fresh tmux session.
# Release admission declares this exact text.
def remote_deploy_launch_command(remote_command, log_ref:, session:)
  tmux_command = remote_deploy_tmux_command(remote_command, log_ref)

  remote_script = <<~ZSH
    set -euo pipefail
    cd /home/dev/pub5
    session=#{Shellwords.escape(session)}

    if ! command -v tmux >/dev/null 2>&1; then
      print -u2 "vps-deploy: BLOCKED - tmux is required; nothing was started"
      exit 69
    fi
    if tmux has-session -t "$session" 2>/dev/null; then
      print -u2 "vps-deploy: session $session already exists; inspect or resume it before starting another deploy"
      exit 75
    fi

    tmux new-session -d -x 200 -y 50 -s "$session" #{Shellwords.escape(tmux_command)}
    tmux set-option -w -t "$session:0" history-limit #{DEPLOY_PANE_HISTORY_LINES}
    print "vps-deploy: started in tmux session $session"
    print "vps-deploy: output will be collected locally"
  ZSH
  Shellwords.join(["zsh", "-fc", remote_script])
end

# Every remote command a release sends after admission, in the exact shapes the
# RTFM gate parses. The SHAs are placeholders: they change no command or page.
def release_remote_commands(app)
  pin = "0" * 40
  remote_command = "cd /home/dev/pub5 && VPS_DEPLOY_SHA=#{pin} VPS_DEPLOY_PREFLIGHT_SHA=#{pin} " \
                   "VPS_DEPLOY_CI_SHA=#{pin} zsh OPENBSD/bin/vps-deploy #{Shellwords.escape(app)}"
  [
    remote_deploy_launch_command(remote_command, log_ref: "local://deploys/receipt", session: "pub5-deploy"),
    remote_deploy_capture_command("pub5-deploy"),
    Shellwords.join(["tmux", "kill-session", "-t", "pub5-deploy"]),
    remote_ruby("OPENBSD/bin/vps-state"),
  ]
end

# RTFM_FIRST admits a release only on a fresh, exact-HEAD receipt. Build it
# here when it is missing, expired or stale: the reads are the manual reader
# and the identity probe, the two bootstrap exceptions, and the validator
# still judges the result before anything else reaches vm23.
def ensure_openbsd_receipt(app)
  require "operator/canary"
  require_relative "../lib/fix/openbsd_receipt_builder"
  _identity, reason = Operator::DeployPreflight.openbsd_target_identity(root: ROOT)
  return unless reason

  puts "rtfm0: receipt not admissible: #{reason.sub(/\ARTFM_FIRST (?:blocked: )?/, "")}"
  puts "rtfm0: rebuilding from #{ssh_host}: tracked OPENBSD sources, target manuals via read-only uname and man"
  hostname = operator_runtime_config.fetch("host_scope").fetch("canonical_hosts").first
  envelope = Master::Fix::OpenBSDReceiptBuilder.build(
    root: ROOT, hostname:, commands: release_remote_commands(app),
    reader: ->(command) { ssh_capture(command, attempts: 2) }
  )
  report_openbsd_receipt(envelope)
rescue Master::Fix::TaskContract::Invalid => error
  die("vps", "RTFM_FIRST receipt could not be built: #{error.message}; nothing was deployed", 78)
end

def report_openbsd_receipt(envelope)
  preflight = envelope.fetch("openbsd_preflight")
  path = Master::Fix::OpenBSDReceiptBuilder.write(envelope, root: ROOT).delete_prefix("#{ROOT}/")
  target = "OpenBSD #{preflight.fetch("os_release")} #{preflight.fetch("architecture")}"
  puts "rtfm0: #{path}: #{preflight.fetch("source_reads").size} sources, " \
       "#{preflight.fetch("manual_pages").size} manuals, #{target}"
end

def append_post_deploy_checks(log, remote_status)
  code = remote_status
  if code.zero?
    state, ok = ssh_capture(remote_ruby("OPENBSD/bin/vps-state"), attempts: 2)
    log.append("\npost-deploy vps-state (#{ok ? 'captured' : 'unavailable'}):\n#{state}\n")
    begin
      output, status = Master::Io::Exec.capture2e(
        RUBY, File.join(OPENBSD_OPS, "bin", "canary"), "--public",
        timeout: 600, raise_on_timeout: true
      )
      log.append("\n#{Operator::DeployLog::PUBLIC_CANARY} (#{status.success? ? 'PASS' : 'FAIL'}):\n#{output}\n")
      code = 1 unless status.success?
    rescue StandardError => error
      log.append("\n#{Operator::DeployLog::PUBLIC_CANARY} (ERROR): #{error.class}: #{error.message}\n")
      code = 1
    end
  end
  code
end

def collect_remote_deploy(session:, app:, sha:, log:)
  exit_code = nil
  consecutive_transport_failures = 0
  loop do
    output, ok = ssh_capture(remote_deploy_capture_command(session), attempts: 1)
    unless ok
      if output.start_with?("RTFM_FIRST blocked:")
        log.append("capture: RTFM admission refused further SSH capture: #{output}\n")
        exit_code = 1
        break
      end
      consecutive_transport_failures += 1
      if (consecutive_transport_failures % 6).zero?
        log.append("transport: SSH capture still unavailable after #{consecutive_transport_failures} attempts; retrying\n")
      end
      sleep 5
      next
    end
    consecutive_transport_failures = 0
    if output.include?("__PUB5_DEPLOY_NO_SESSION__")
      log.append("capture: remote tmux session disappeared before an exit status was observed\n")
      exit_code = 1
      break
    end

    chunk = log.append_snapshot(output)
    $stdout.write(chunk) unless chunk.empty?
    $stdout.flush unless chunk.empty?
    match = output.match(/PUB5_DEPLOY_EXIT=(\d{1,3})/)
    unless match
      sleep 3
      next
    end

    exit_code = Integer(match[1], 10)
    sleep 1
    final_output, final_ok = ssh_capture(remote_deploy_capture_command(session), attempts: 1)
    if final_ok && !final_output.include?("__PUB5_DEPLOY_NO_SESSION__")
      final_chunk = log.append_snapshot(final_output)
      $stdout.write(final_chunk) unless final_chunk.empty?
      $stdout.flush unless final_chunk.empty?
    end
    break
  end

  ssh_capture(Shellwords.join(["tmux", "kill-session", "-t", session]), attempts: 1)
  exit_code = append_post_deploy_checks(log, exit_code)
  log.finish(status: exit_code.zero? ? "success" : "failure", exit_code:)
  exit_code
rescue StandardError => error
  log.append("collector: #{error.class}: #{error.message}\n") rescue nil
  log.finish(status: "failure", exit_code: 1) rescue nil
  1
end

def tail_local_deploy_log(log_path, waiter)
  offset = 0
  status = nil
  loop do
    File.open(log_path, "rb") do |file|
      file.seek(offset)
      chunk = file.read.to_s
      unless chunk.empty?
        $stdout.write(chunk)
        $stdout.flush
        offset += chunk.bytesize
      end
    end
    status = Operator::DeployLog.read_status(log_path)
    break unless status.nil?

    unless waiter.alive?
      sleep 0.2
      status = Operator::DeployLog.read_status(log_path)
      break unless status.nil?
      File.open(log_path, "ab") { |file| file.write("collector: worker exited without a terminal status receipt\n"); file.fsync }
      return 1
    end
    sleep 1
  end
  File.open(log_path, "rb") do |file|
    file.seek(offset)
    chunk = file.read.to_s
    $stdout.write(chunk)
    $stdout.flush
  end
  status || 1
end

def launch_local_deploy_collector(session:, log_path:, app:, sha:)
  pid = Process.spawn(
    RbConfig.ruby, File.expand_path(__FILE__), "vps", "deploy-capture",
    session, log_path, app, sha,
    in: File::NULL, out: File::NULL, err: File::NULL, pgroup: true
  )
  [pid, Process.detach(pid)]
end

command = ARGV.shift
case command
when "check"
  # The repo-wide maintenance ladder. This is not MASTER/bin/check's profile
  # runner and not the everyday /fix repair command; it combines scanners,
  # autofix stages, tree checks and ratchets in one separate operator pass.
  # The stages and their order live in lib/operator/check_chain.rb.
  #
  # It writes by default; --scan-only measures without writing.
  # --scan-only measures and writes nothing; every stage says which files it
  # changed, under its own name, so a bad fix is attributable to the stage that
  # made it rather than to the diff as a whole.
  require "operator/check_chain"
  release = !ARGV.delete("--release").nil?
  ENV["MASTER_STRICT"] = "deploy" if release
  fix_proof = !ARGV.delete("--fix-proof").nil?
  scan_only = !ARGV.delete("--scan-only").nil? || ENV["MASTER_CHECK_SCAN_ONLY"] == "1"
  # --explain is the same question people actually ask before starting an hour
  # of checks: what is this going to run.
  list = !ARGV.delete("--list").nil? || !ARGV.delete("--explain").nil?
  only = ARGV.filter_map { |arg| arg[/\A--only=(.+)\z/, 1] }.flat_map { |value| value.split(",") }
  # --tree is the common case made cheap: working inside one tree, the other
  # four trees' suites and checks prove nothing about the change and cost most of
  # the wall clock. It drops whole stages rather than shrinking them; the
  # reasoning is in lib/operator/check_chain.rb.
  trees = ARGV.filter_map { |arg| arg[/\A--tree=(.+)\z/, 1] }
  trees << ARGV[ARGV.index("--tree") + 1].to_s if ARGV.include?("--tree")
  if fix_proof
    selected = Operator::CheckChain.normalise_trees(trees)
    statuses = selected.map { |target| Operator::CheckChain.verify_cached_fix(target:).first }
    exit(statuses.max || 0)
  end
  exit Operator::CheckChain.run(scan_only:, only:, list:, trees:)
when "status", nil
  json = ARGV.include?("--json")
  output = Operator::StatusReport.new(root: ROOT).render(json:)
  json ? puts(output) : Master::Trace::Dmesg::Report.print("/status", output)
when "rtfm"
  options = {
    host: ENV.fetch("PUB5_SSH_HOST", "dev@brgen.no"),
    key: File.expand_path(ENV.fetch("PUB5_SSH_KEY", "~/.ssh/id_ed25519_brgen")),
    source: nil,
    receipt: nil,
    local: false,
  }
  OptionParser.new do |parser|
    parser.on("--host HOST") { |value| options[:host] = value }
    parser.on("--key PATH") { |value| options[:key] = File.expand_path(value) }
    parser.on("--source PATH") { |value| options[:source] = value }
    parser.on("--receipt PATH") { |value| options[:receipt] = File.expand_path(value) }
    parser.on("--local") { options[:local] = true }
  end.parse!(ARGV)
  die("rtfm", "usage: bin/operator rtfm [--host USER@HOST] [--key PATH] [--source PATH] [--receipt PATH] [--local] -- <native command>", 64) if ARGV.empty?
  native_command = ARGV.join(" ").strip
  die("rtfm", "native command is empty", 64) if native_command.empty?
  contract = Master::Fix::TaskContract.current ||
    Master::Fix::TaskContract.build(
      intent: "functional_change", scope: ["OPENBSD/**"], preserve: [], proof: []
    )
  preflight = Master::Fix::OpenBSDManualPreflight
  if options[:local]
    reason = if options[:source]
               preflight.refusal_for_path(
                 path: File.expand_path(options[:source], ROOT), contract:,
                 repo_root: ROOT, receipt_path: options[:receipt]
               )
             end
    reason ||= preflight.refusal_for_command(
      command: native_command, contract:, repo_root: ROOT, receipt_path: options[:receipt]
    )
  else
    ssh_argv = [
      "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
      "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=8"
    ]
    ssh_argv.concat(["-i", options[:key]]) if File.file?(options[:key])
    ssh_argv << options[:host]
    wire_command = Shellwords.join(ssh_argv + [native_command])
    unless preflight.bootstrap_command?(wire_command)
      reason = preflight.refusal_for_path(
        path: File.expand_path(options[:source], ROOT), contract:,
        repo_root: ROOT, receipt_path: options[:receipt]
      ) if options[:source]
    end
    reason ||= preflight.refusal_for_ssh_argv(
      ssh_argv: ssh_argv, remote_command: native_command, contract:,
      repo_root: ROOT, receipt_path: options[:receipt]
    )
  end
  die("rtfm", "BLOCKED: #{reason}", 78) if reason
  Master::Trace::Dmesg.status("rtfm0", "PASS, source + target manuals + command scope admitted")
  exit 0
when "fix"
  # Read-only: /fix itself is started with bin/master "/fix <tree...>" (trees run
  # in the order typed) or bin/fix-here. This only reports on what it wrote.
  # `fix tail` defaults to the newest human /fix log; `--transcript` selects
  # the newest run's detailed NDJSON evidence instead. The main checkout is
  # searched too, because a /fix child writes its transcript there and not in its worktree.
  sub = ARGV.shift
  die("fix", "usage, bin/operator fix status [--trees=A,B] [--detail|--json] | fix tail [--tail[=N]] [--transcript] [--once]", 64) unless %w[tail status].include?(sub)
  following = sub == "tail" || ARGV.any? { |arg| arg == "--transcript" || arg.start_with?("--tail") }
  if following
    require "operator/fix_tail"
    common = Master::Io::Exec.capture2e("git", "-C", ROOT, "rev-parse", "--path-format=absolute", "--git-common-dir").first.strip
    roots = [File.join(ROOT, "MASTER"), File.join(File.dirname(common), "MASTER")].uniq
    exit Operator::FixTail.run(ARGV, roots:)
  end

  require "operator/fix_status"
  json = !ARGV.delete("--json").nil?
  detail = !ARGV.delete("--detail").nil?
  trees = ARGV.filter_map { |arg| arg[/\A--trees=(.+)\z/, 1] }.flat_map { |value| value.split(",") }
  trees << ARGV[ARGV.index("--trees") + 1].to_s if ARGV.include?("--trees")
  output = Operator::FixStatus.new(root: ROOT, trees: trees).render(json:, detail:)
  json ? puts(output) : Master::Trace::Dmesg::Report.print("/fix status", output)
when "affiliate"
  require_relative "../lib/finance/tradedoubler"
  affiliate = Master::Finance::Tradedoubler.new(root: ROOT, master_root: File.join(ROOT, "MASTER"))
  begin
    action = ARGV.shift.to_s
    case action
    when "status"
      die("affiliate", "usage: bin/operator affiliate status") unless ARGV.empty?
      puts JSON.pretty_generate(affiliate.status)
    when "grant", "revoke"
      scope = ARGV.shift
      confirmation = nil
      OptionParser.new do |options|
        options.on("--confirm VALUE") { |value| confirmation = value }
      end.parse!(ARGV)
      die("affiliate", "usage: bin/operator affiliate #{action} <scope> --confirm <exact-phrase>") unless
        scope && confirmation && ARGV.empty?
      report = if action == "grant"
                 affiliate.grant_scope(scope, confirmation:)
               else
                 affiliate.revoke_scope(scope, confirmation:)
               end
      puts JSON.pretty_generate(report)
    when "claims"
      operation = ARGV.shift.to_s
      case operation
      when "list"
        options = {}
        OptionParser.new do |parser|
          parser.on("--source KEY") { |value| options[:source] = value }
          parser.on("--program KEY") { |value| options[:program_key] = value }
          parser.on("--status-id VALUE") { |value| options[:status_id] = value }
          parser.on("--since DATE") { |value| options[:since] = value }
          parser.on("--until DATE") { |value| options[:until_date] = value }
        end.parse!(ARGV)
        die("affiliate", "unknown arguments: #{ARGV.join(' ')}") unless ARGV.empty?
        puts JSON.pretty_generate(affiliate.list_claims(**options))
      when "prepare"
        path = ARGV.shift
        die("affiliate", "usage: bin/operator affiliate claims prepare <claim.json>") unless path && ARGV.empty?
        puts JSON.pretty_generate(affiliate.prepare_claim(path:))
      when "submit"
        sha256 = ARGV.shift
        confirmation_hash = nil
        OptionParser.new do |parser|
          parser.on("--confirm-hash HASH") { |value| confirmation_hash = value }
        end.parse!(ARGV)
        die("affiliate", "usage: bin/operator affiliate claims submit <sha256> --confirm-hash <same-sha256>") unless
          sha256 && confirmation_hash && ARGV.empty?
        puts JSON.pretty_generate(affiliate.submit_claim(sha256, confirmation_hash:))
      else
        die("affiliate", "usage: bin/operator affiliate claims <list|prepare|submit>")
      end
    else
      die("affiliate", "usage: status | grant <scope> --confirm PHRASE | revoke <scope> --confirm PHRASE | claims <list|prepare|submit>", 64)
    end
    exit 0
  rescue Master::Finance::Tradedoubler::Error, ArgumentError, JSON::ParserError => e
    die("affiliate", e.message)
  end
when "measure"
  # Every ratchet in the repo, current beside recorded. Non-zero when any is over
  # its ceiling OR slack beneath it, because a ceiling above the real number is
  # room the next change grows into without failing anything.
  #
  # --why names the files behind a number and --since names the ceilings that
  # moved, because neither question can be answered from the table: "OVER +826"
  # is not something a session can act on or disclaim.
  require_relative "../lib/operator/ratchets"
  deep = !ARGV.delete("--deep").nil?
  # --stale-ok lets a cached group answer from a receipt whose trees have since
  # changed, tagged stale in every row note. /fix's pre-repair measure asks for
  # this: its answer is a starting baseline, and the closing measure after the
  # last repair runs without the flag and pays the fresh census. (Johann 2026-11-07:
  # a cold law audit burned ~20 minutes of scaffolding before any repair.)
  stale_ok = !ARGV.delete("--stale-ok").nil?
  why = ARGV.filter_map { |arg| arg[/\A--why(?:=(.*))?\z/, 1] }.first
  why ||= ARGV[ARGV.index("--why") + 1].to_s if ARGV.include?("--why")
  since = ARGV.filter_map { |arg| arg[/\A--since(?:=(.*))?\z/, 1] }.first
  since ||= ARGV[ARGV.index("--since") + 1] if ARGV.include?("--since")
  die("measure", "usage, bin/operator measure --since <ref>", 64) if ARGV.include?("--since") && since.to_s.empty?
  if since
    Master::Trace::Dmesg::Report.print("measure", Operator::Ratchets.since(since))
    exit 0
  end
  trees = ARGV.filter_map { |arg| arg[/\A--trees=(.+)\z/, 1] }.flat_map { |value| value.split(",") }
  rows = Operator::Ratchets.all(deep:, trees: trees.empty? ? nil : trees, stale_ok:)
  require_relative "../lib/review/council/inter_model_contract"
  Master::Trace::Dmesg.status(
    "intermodel0",
    Master::Review::Council::InterModelContract.measure_line(root: ROOT),
    io: $stderr
  )
  if why
    Master::Trace::Dmesg::Report.print("measure", Operator::Ratchets.why(rows, why))
    exit 0
  end
  if ARGV.include?("--json")
    puts Operator::Ratchets.json(rows)
  else
    Master::Trace::Dmesg::Report.print("measure", Operator::Ratchets.render(rows))
  end
  exit(Operator::Ratchets.ok?(rows) ? 0 : 1)
when "lint"
  # Inheritance made mechanical. The same deterministic rules MASTER runs on
  # itself — every lexical and AST rule plus law/, no model, no autofix — judge
  # whatever files an agent touched, so claude, grok or codex can run it on a
  # diff before committing and be held to the constitution regardless of which
  # tool typed the change. Paths given are scanned as named; with none, the diff
  # against HEAD is. Operator::Lint says what --staged and --changed-lines read.
  require "master"
  require "fix/scanner"
  require "operator/lint"
  changed_only = !ARGV.delete("--changed-lines").nil?
  staged = !ARGV.delete("--staged").nil?
  scanner = Master::Fix::Scanner.build(root: ROOT, agent: nil)
  lint = Operator::Lint.new(root: ROOT, scanner:, staged:, changed_only:)
  files = lint.targets(ARGV)
  findings = lint.findings(files)
  if findings.empty?
    Master::Trace::Dmesg.status("lint0", "clean, #{files.size} files, no law broken")
    exit 0
  end
  Master::Trace::Dmesg.attach("lint0", "master0", "#{findings.size} finding(s) across #{findings.map(&:first).uniq.size} files")
  findings.sort_by { |path, finding| [path, finding[:line].to_i] }.each do |path, finding|
    Master::Trace::Dmesg.status("lint0", "#{path.sub("#{ROOT}/", "")}:#{finding[:line]}, #{finding[:message]}")
  end
  exit 1
when "land"
  # Commit, rebase onto origin/main, re-check, push — in that order, because the
  # order is where it goes wrong.
  #
  # Every landing is the same five steps, and the two that get
  # skipped are the two that matter. Rebasing onto a main that moved can
  # invalidate a green run, so the checks run again AFTER the rebase and not
  # only before it. And `git push` sends every commit beneath yours, so this
  # prints what is going before it goes.
  #
  # Path-scoped by construction: with no paths it commits nothing, rather than
  # sweeping up whatever else is in a shared checkout.
  message = nil
  message_file = nil
  OptionParser.new do |o|
    o.on("-m MSG") { |v| message = v }
    o.on("-F FILE") { |v| message_file = v }
  end.parse!(ARGV)
  paths = ARGV
  die("land", "usage, bin/operator land -m <message> <path>...", 64) if paths.empty?
  die("land", "usage, bin/operator land needs -m <message> or -F <file>", 64) unless message || message_file

  def run!(*cmd, chdir: ROOT)
    out, status = Master::Io::Exec.capture2e(*cmd, chdir: chdir)
    [out.strip, status.success?]
  end

  measure_out, measure_ok = run!(File.join(__dir__, "operator"), "measure")
  unless measure_ok
    Master::Trace::Dmesg::Report.print("measure", measure_out, io: $stderr)
    die("land", "ratchet is off before you started")
  end
  Master::Trace::Dmesg.status("land0", "ratchets clean")

  commit = ["git", "commit", "-q"]
  commit += message_file ? ["-F", message_file] : ["-m", message]
  _, ok = run!(*commit, "--", *paths)
  die("land", "nothing committed, paths matched no changes?") unless ok

  run!("git", "fetch", "-q", "origin")
  current_branch, branch_ok = run!("git", "branch", "--show-current")
  die("land", "detached HEAD has no destination branch; switch to main or a named topic branch") unless branch_ok && !current_branch.empty?

  if current_branch == "main"
    # main is the only branch pushed directly to origin/main.
    _, current = run!("git", "merge-base", "--is-ancestor", "origin/main", "HEAD")
    unless current
      rebase_out, rebased = run!("git", "rebase", "-q", "origin/main")
      abort("land: rebase onto origin/main failed; resolve and rerun land\n#{rebase_out}") unless rebased
    end
  else
    remote_ref = "origin/#{current_branch}"
    _, remote_exists = run!("git", "show-ref", "--verify", "--quiet", "refs/remotes/#{remote_ref}")
    if remote_exists
      # Never rewrite a published topic branch. Bring its remote commits in, then
      # merge main if needed so the push remains fast-forward-only.
      _, includes_remote = run!("git", "merge-base", "--is-ancestor", remote_ref, "HEAD")
      unless includes_remote
        merge_out, merged = run!("git", "merge", "--no-edit", remote_ref)
        abort("land: merging #{remote_ref} failed; resolve and rerun land\n#{merge_out}") unless merged
      end
      _, includes_main = run!("git", "merge-base", "--is-ancestor", "origin/main", "HEAD")
      unless includes_main
        merge_out, merged = run!("git", "merge", "--no-edit", "origin/main")
        abort("land: merging origin/main into #{current_branch} failed; resolve and rerun land\n#{merge_out}") unless merged
      end
    else
      # An unpublished topic can be rebased onto current main before first push.
      _, includes_main = run!("git", "merge-base", "--is-ancestor", "origin/main", "HEAD")
      unless includes_main
        rebase_out, rebased = run!("git", "rebase", "-q", "origin/main")
        abort("land: rebase onto origin/main failed; resolve and rerun land\n#{rebase_out}") unless rebased
      end
    end
  end

  # The same measurement again. A rebase brings other people's commits under
  # yours, and theirs can put a ceiling over the edge that yours did not.
  after_out, after_ok = run!(File.join(__dir__, "operator"), "measure")
  unless after_ok
    Master::Trace::Dmesg::Report.print("measure", after_out, io: $stderr)
    die("land", "green before rebase, off after it, origin/main moved under you")
  end

  # Booting reaches only the files the boot requires; a file that does not parse
  # anywhere else waits for whoever loads it next. Prism answers for all of them.
  require "operator/parse_sweep"
  broken = Operator::ParseSweep.failures(ROOT)
  unless broken.empty?
    Master::Trace::Dmesg::Report.print("parse", Operator::ParseSweep.render(broken.first(10)), io: $stderr)
    die("land", "#{broken.size} tracked Ruby file(s) do not parse; nothing pushed")
  end
  Master::Trace::Dmesg.status("land0", "every Ruby file parses")

  # And the runtime itself. Green ratchets say nothing about a require that the
  # rebase left dangling (core/capabilities, twice in one day): only booting does.
  smoke_out, smoke_ok = run!(File.join(__dir__, "ruby"), File.join(ROOT, "MASTER", "tools", "boot_smoke.rb"))
  unless smoke_ok
    Master::Trace::Dmesg::Report.print("boot_smoke", smoke_out, io: $stderr)
    die("land", "the runtime does not boot after the rebase; nothing pushed")
  end
  Master::Trace::Dmesg.status("land0", "runtime boots")

  ahead, = run!("git", "log", "--oneline", "origin/main..HEAD")
  Master::Trace::Dmesg.attach("land0", "master0", "publishing to origin/#{current_branch}")
  ahead.each_line { |line| Master::Trace::Dmesg.status("land0", line.chomp) }
  push_out, pushed = run!("git", "push", "origin", "HEAD:#{current_branch}")
  abort("land: push refused to origin/#{current_branch}; no force push was attempted\n#{push_out}") unless pushed
  Master::Trace::Dmesg.status("land0", "on origin/#{current_branch}")
when "push"
  # land's rebase refuses a dirty shared tree; this replays instead and touches
  # the working tree only after origin confirms the push. Operator::ReplayPush.
  require "operator/replay_push"
  exit(Operator::ReplayPush.new(root: ROOT).run ? 0 : 1)
