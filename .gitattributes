# Force LF line endings for scripts (fixes shebang \r warning on Unix)
*.rb text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.py text eol=lf
bin/* text eol=lf
# Source snapshots are verbatim mirrors; their payload may intentionally retain source trailing whitespace or CRLF.
snapshot_*.md whitespace=-trailing-space
# Fixtures and media are binary inventory: quiet diffs, no text mangling.
*.png -diff
*.jpg -diff
*.jpeg -diff
*.webp -diff
*.gif -diff
*.pdf -diff
*.woff2 -diff
*.ico -diff
