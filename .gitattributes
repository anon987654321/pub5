# Force LF line endings for scripts (fixes shebang \r warning on Unix)
*.rb text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.py text eol=lf
bin/* text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.erb text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.zsh text eol=lf
*.ksh text eol=lf
# Source snapshots are verbatim mirrors; their payload may intentionally retain source trailing whitespace or CRLF.
snapshot_*.md -text whitespace=-trailing-space
# Fixtures and media are binary inventory: quiet diffs, no text mangling.
*.png -diff
*.jpg -diff
*.jpeg -diff
*.webp -diff
*.gif -diff
*.pdf -diff
*.woff2 -diff
*.ico -diff

# GitHub language statistics: generated projections are not handwritten source.
MASTER/web/public/face.runtime.js linguist-generated=true
MASTER/web/public/face.css linguist-generated=true
RAILS/__shared/design_tokens.yml linguist-generated=true

# Third-party source is retained for reproducibility, but is not project code.
**/vendor/** linguist-vendored=true
