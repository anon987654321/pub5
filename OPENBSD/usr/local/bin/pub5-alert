#!/bin/ksh
# pub5-alert - the one place a recurring symptom becomes a durable, actionable line.
#
#   pub5-alert raise KEY MESSAGE...   record an alert, once per quiet window per KEY
#   pub5-alert watch                  disk, swap, sustained load, failed services, stale backup
#   pub5-alert show [N]               the last N alerts (default 20)
#
# Why it exists. relayd-watchdog restarts relayd, resource_guard sheds apps and
# uptime-check logs DOWN lines, and each healed or noted its symptom into a log
# nobody reads: config-drift-check wrote the same three amber.brgen.no lines every
# fifteen minutes into a 30 KB file, and the root mailbox was last written in
# October 2025. A healer that succeeds quietly hides the fault that makes it run
# again, so the repeat is what gets recorded, here, and `vps-state` prints it.
#
# raise is rate-limited per KEY (PUB5_ALERT_QUIET seconds, six hours by default),
# so a fault that persists for a week is a handful of lines, not ten thousand, and
# each line still says what to do. The record is /var/log/pub5-alerts.log
# (rotated by newsyslog) plus one daemon.crit syslog line.
#
# watch is bounded: it runs five reads (df, swapctl, sysctl, rcctl, one marker
# file) and changes nothing. Run it from root's crontab.
# PUB5_ALERT_PATH_PREFIX lets the test put fake df, swapctl, sysctl and rcctl first.
PATH=${PUB5_ALERT_PATH_PREFIX:+$PUB5_ALERT_PATH_PREFIX:}/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin

LOG=${PUB5_ALERT_LOG:-/var/log/pub5-alerts.log}
STATE=${PUB5_ALERT_STATE:-/var/db/pub5/alerts}
QUIET=${PUB5_ALERT_QUIET:-21600}
DISK_MAX=${PUB5_ALERT_DISK_MAX:-90}
SWAP_MAX=${PUB5_ALERT_SWAP_MAX:-92}
BACKUP_MARKER=${PUB5_DR_MARKER:-/home/dev/.dr_pull_ok}
BACKUP_MAX_AGE=${PUB5_ALERT_BACKUP_MAX_AGE:-172800}
# brgen_jobs is failed by design: no resident Solid Queue worker fits in 1 GB, and
# drain-jobs.sh runs the queue from cron (etc/crontab.vm23 says so).
ALLOW_FAILED=${PUB5_ALERT_ALLOW_FAILED:-brgen_jobs}
# The one symptom nothing else owned, measured from Mischa's letter 2026-11-08:
# vm23 sat above 80% CPU for six hours with healthy swap, disk and services, so
# every other watch was silent and the host provider had to be the one to tell
# us. resource_guard.sh sheds on memory and crit load but its own history log is
# a log nobody reads, so sustained saturation gets the raise treatment here.
# Load is stored x100 to stay in ksh integer arithmetic. Eight 15-minute
# ticks is two hours of sustained breach; a deploy's minutes-long preflight
# storm never reaches it, which is the point.
LOAD_MAX=${PUB5_ALERT_LOAD_MAX:-200}
LOAD_STRIKES=${PUB5_ALERT_LOAD_STRIKES:-8}

now() { date +%s; }

raise() {
  key=$1
  shift
  case $key in
  *[!A-Za-z0-9._-]*|'') print -u2 "pub5-alert: key must be letters, digits, . _ -"; return 2 ;;
  esac
  mkdir -p "$STATE" 2>/dev/null
  stamp=$STATE/$key
  t=$(now)
  last=0
  [[ -f $stamp ]] && read last < "$stamp"
  case $last in *[!0-9]*|'') last=0 ;; esac
  if (( t - last < QUIET )); then
    return 0
  fi
  print -r -- "$t" > "$stamp"
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) $key $*"
  print -r -- "$line" >> "$LOG"
  ${PUB5_ALERT_LOGGER:-logger} -p daemon.crit -t pub5-alert "$key: $*" 2>/dev/null
  return 0
}

# "/home" -> home, "/usr/local" -> usr_local, "/" -> root; pdksh has no ${var//a/b}.
slug() {
  s=${1#/}
  out=
  while [[ $s == */* ]]; do
    out=$out${s%%/*}_
    s=${s#*/}
  done
  out=$out$s
  [[ -n $out ]] || out=root
  print -r -- "$out"
}

watch_disk() {
  df -P 2>/dev/null | while read -r fs blocks used avail cap mount; do
    case $cap in
    [0-9]*%) ;;
    *) continue ;;
    esac
    pct=${cap%\%}
    if (( pct >= DISK_MAX )); then
      raise "disk-$(slug "$mount")" "$mount is ${pct}% full (limit ${DISK_MAX}%) - find the growth with: doas /usr/local/sbin/pub5-admin disk-usage $mount; logs rotate in /etc/newsyslog.conf"
    fi
  done
}

watch_swap() {
  # OpenBSD 7.8, as observed on vm23: "total: 2588672 512-blocks allocated, 2003000 used, 585672 available"
  out=$(swapctl -s 2>/dev/null) || return 0
  set -- $out
  alloc= used=
  while (( $# )); do
    case $1 in
    allocated|allocated,) alloc=$prev2 ;;
    used|used,) used=$prev ;;
    esac
    prev2=$prev
    prev=$1
    shift
  done
  alloc=${alloc%k}
  used=${used%k}
  case $alloc$used in *[!0-9]*|'') return 0 ;; esac
  (( alloc > 0 )) || return 0
  pct=$(( used * 100 / alloc ))
  if (( pct >= SWAP_MAX )); then
    raise swap "swap is ${pct}% used (limit ${SWAP_MAX}%) - the box is paging; run: doas ksh /usr/local/bin/resource_guard.sh and read /var/log/resource_guard_history.log"
  fi
}

watch_load() {
  avg=$(sysctl -n vm.loadavg 2>/dev/null) || return 0
  set -- $avg
  a=$1
  case $a in
  *.*) ip=${a%%.*} fp=${a#*.} ;;
  *[!0-9]*|'') return 0 ;;
  *) ip=$a fp=0 ;;
  esac
  case $ip$fp in *[!0-9]*|'') return 0 ;; esac
  while (( ${#fp} > 2 )); do fp=${fp%?}; done
  case $fp in '') fp=0 ;; ?) fp=${fp}0 ;; esac
  load1=$(( ip * 100 + fp ))
  sf=$STATE/load.strikes
  strikes=0
  [[ -f $sf ]] && read strikes < "$sf"
  case $strikes in *[!0-9]*|'') strikes=0 ;; esac
  if (( load1 >= LOAD_MAX )); then
    strikes=$(( strikes + 1 ))
    mkdir -p "$STATE" 2>/dev/null
    if (( strikes >= LOAD_STRIKES )); then
      offender=$(ps -axr -o pcpu,time,args 2>/dev/null | head -2 | tail -1)
      raise load-sustained "1-minute load ${ip}.${fp} for ${strikes} recorded ticks (limit $(( LOAD_MAX / 100 )).$(( LOAD_MAX % 100 ))) - the box has been saturated for hours with nothing shedding; top cpu: ${offender:-unknown}; history: /var/log/resource_guard_history.log; zombies: ps -axr -o pcpu,time,state,args"
      strikes=0
    fi
    print -r -- "$strikes" > "$sf"
  elif [[ -f $sf ]]; then
    print -r -- 0 > "$sf"
  fi
  return 0
}

watch_services() {
  rcctl ls failed 2>/dev/null | while read -r svc; do
    [[ -n $svc ]] || continue
    case " $ALLOW_FAILED " in *" $svc "*) continue ;; esac
    raise "failed-$svc" "$svc is in rcctl failed - read /var/log/daemon, then: doas rcctl restart $svc (an amber or bsdports failure may be resource_guard shedding: check /var/db/resource_guard_shed)"
  done
}

watch_backup() {
  t=$(now)
  if [[ ! -f $BACKUP_MARKER ]]; then
    raise backup-unreported "no pull has reported to $BACKUP_MARKER - run ruby OPENBSD/bin/dr-pull on the operator Mac and check ~/pub5-dr/dr-pull.log"
    return 0
  fi
  read last < "$BACKUP_MARKER"
  case $last in *[!0-9]*|'') last=0 ;; esac
  age=$(( t - last ))
  if (( age > BACKUP_MAX_AGE )); then
    raise backup-stale "the newest dr-pull reported $(( age / 3600 )) hours ago (limit $(( BACKUP_MAX_AGE / 3600 ))) - on the operator Mac: ruby OPENBSD/bin/dr-pull, then read ~/pub5-dr/dr-pull.log; launchd job no.brgen.pub5-dr"
  fi
}

case ${1:-} in
raise)
  shift
  (( $# >= 2 )) || { print -u2 "usage: pub5-alert raise KEY MESSAGE..."; exit 2; }
  raise "$@"
  ;;
watch)
  watch_disk
  watch_swap
  watch_load
  watch_services
  watch_backup
  ;;
show)
  n=${2:-20}
  [[ -f $LOG ]] || { print "pub5-alert: no alerts recorded ($LOG)"; exit 0; }
  total=0
  while read -r _; do total=$(( total + 1 )); done < "$LOG"
  skip=$(( total - n ))
  i=0
  while read -r line; do
    i=$(( i + 1 ))
    (( i > skip )) && print -r -- "$line"
  done < "$LOG"
  ;;
*)
  print -u2 "usage: pub5-alert raise KEY MESSAGE... | watch | show [N]"
  exit 2
  ;;
esac
