#!/usr/bin/env ruby
# frozen_string_literal: true

# Turn structured vps-deploy log lines into a stage timeline.
# Usage: deploy-story [log path]
# Default: /var/log/pub5/vps-deploy.log or /home/dev/vps-deploy.log or stdin.
#
# Prefer lines that carry stage= (structured logger). Fall back to ==> markers.
# The formatting, the field extraction and the 80-line window match the awk
# version this replaced, line for line; the shell law (SHELL_DISCIPLINE) asks
# for Ruby, zsh builtins or the dedicated tools instead of awk.

log = ARGV[0]
unless log
  log = ["/var/log/pub5/vps-deploy.log", "/home/dev/vps-deploy.log",
         File.join(ENV["HOME"].to_s, "vps-deploy.log")].find { |path| File.file?(path) }
end

if log && File.file?(log)
  puts "deploy-story: #{log}"
  source = File.read(log)
else
  puts "deploy-story: stdin"
  source = $stdin.read
end

TIMESTAMP = /[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:,Z+\-]+/.freeze

timeline = source.each_line.filter_map do |line|
  stripped = line.chomp
  if stripped.include?("stage=")
    ts = stripped[TIMESTAMP]
    app = stripped[/app=[^ ]+/]
    stage = stripped[/stage=[^ ]+/]
    format("%s  %-10s  %s\n", ts || "?", app ? app[4..] : "-", stage ? stage[6..] : "?")
  elsif stripped.match?(/vps-deploy:.*enter|==> vps-deploy/)
    +stripped
  end
end

timeline.last(80).each { |line| puts line }
