#!/usr/bin/env ruby
# frozen_string_literal: true

# deploy — the one Ruby deploy entrypoint for the vm23 tree (the pub5 port's
# Phase 2 seam: "one Ruby deploy tool"). It validates the target the way the
# shell entrypoint does and hands off to the proven serial stages in
# OPENBSD/bin/vps-deploy (sync, CI, restart, health, deploy stamp). The stages
# themselves are carried from pub4 unchanged; rewriting live deploy zsh
# without a host to run it on would have been a claim, not a port.
#
#   OPENBSD/bin/deploy [all|brgen|amber|bsdports|mrdamascy|master] [--follow|--detach]
#
# Workstation one-command deploys keep using the root ./redeploy, which routes
# through MASTER/bin/operator; this entrypoint names the same stages directly.

APPS = %w[all brgen amber bsdports mrdamascy master].freeze

def usage
  warn "usage: OPENBSD/bin/deploy [#{APPS.join('|')}] [--follow|--detach]"
end

app = "all"
modes = []

ARGV.each do |arg|
  case arg
  when "--follow", "--detach"
    modes << arg
  when "-h", "--help"
    usage
    exit 0
  else
    unless APPS.include?(arg)
      warn "deploy: unknown argument: #{arg}"
      usage
      exit 64
    end
    app = arg
  end
end

stages = File.expand_path("vps-deploy", __dir__)
unless File.file?(stages) && File.executable?(stages)
  warn "deploy: vps-deploy stages are missing or not executable: #{stages}"
  exit 66
end

# vps-deploy is a zsh script with its own shebang; exec it directly so its
# stages run exactly as every caller in pub4 ran them.
exec(stages, app, *modes)
