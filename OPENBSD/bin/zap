#!/usr/bin/env ruby
# frozen_string_literal: true

# Stop processes by executable name. Uses OpenBSD ps for discovery and Ruby's
# Process.kill for signalling; no third-party zap binary or shell interpolation.
require "optparse"

class Zap
  PROTECTED_PIDS = [0, 1, Process.pid, Process.ppid].freeze
  GRACE_SECONDS = 2.0
  POLL_SECONDS = 0.05

  def initialize(argv, out: $stdout, err: $stderr, input: $stdin)
    @out, @err, @input = out, err, input
    @force = false
    @name = nil
    parse(argv)
  end

  def run
    unless RUBY_PLATFORM.include?("openbsd")
      @err.puts "zap: OpenBSD only"
      return 1
    end

    matches = processes.select do |process|
      process[:name] == @name || process[:name].start_with?("#{@name}:")
    end
    if matches.empty?
      @out.puts "zap: no process named #{@name}"
      return 0
    end

    matches.each { |process| @out.puts "#{process[:pid]}  #{process[:name]}" }
    return 1 unless @force || confirm?

    failures = matches.filter_map { |process| stop(process[:pid]) }
    failures.each { |message| @err.puts "zap: #{message}" }
    failures.empty? ? 0 : 1
  rescue OptionParser::ParseError, ArgumentError => e
    @err.puts "zap: #{e.message}"
    @err.puts "usage: zap [-f|--force] process-name"
    2
  rescue SystemCallError => e
    @err.puts "zap: #{e.message}"
    1
  rescue StandardError => e
    @err.puts "zap: #{e.message}"
    1
  end

  private

  def parse(argv)
    parser = OptionParser.new do |opts|
      opts.banner = "usage: zap [-f|--force] process-name"
      opts.on("-f", "--force", "Skip confirmation") { @force = true }
      opts.on("-h", "--help", "Show this help") { @out.puts opts; exit 0 }
    end
    args = parser.parse(argv.dup)
    raise ArgumentError, "expected one process name" unless args.length == 1

    @name = args.first
    raise ArgumentError, "invalid process name" unless @name.match?(/\A[A-Za-z0-9_.:-]+\z/)
  end

  def processes
    output, status = IO.popen(["/bin/ps", "-ax", "-o", "pid=", "-o", "comm="], &:read), $?
    raise "ps failed (#{status.exitstatus})" unless status&.success?

    output.each_line.filter_map do |line|
      match = line.match(/\A\s*(\d+)\s+(.+?)\s*\z/)
      next unless match

      pid = Integer(match[1], 10)
      name = File.basename(match[2])
      next if PROTECTED_PIDS.include?(pid)

      { pid: pid, name: name }
    end
  end

  def confirm?
    @out.print "Terminate #{@name}? [y/N] "
    answer = @input.gets
    answer && answer.strip.match?(/\A(?:y|yes)\z/i)
  end

  def stop(pid)
    Process.kill("TERM", pid)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + GRACE_SECONDS
    while Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
      return nil unless alive?(pid)

      sleep POLL_SECONDS
    end
    return nil unless alive?(pid)

    Process.kill("KILL", pid)
    nil
  rescue Errno::ESRCH
    nil
  rescue Errno::EPERM => e
    "cannot signal pid #{pid}: #{e.message}"
  end

  def alive?(pid)
    Process.kill(0, pid)
    true
  rescue Errno::ESRCH
    false
  rescue Errno::EPERM
    true
  end
end

exit Zap.new(ARGV).run if $PROGRAM_NAME == __FILE__
