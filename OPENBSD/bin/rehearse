#!/usr/bin/env ruby
# frozen_string_literal: true

# Rehearses a workstation release checkout with fast static deployment checks.
# It runs the CI lints, dialect check and source contracts: named repo paths exist,
# the production copy-tree matches the Gemfiles, and test files keep calls inside
# their classes. It does not boot Rails or replace the selected apps' full bin/ci
# suites, which the workstation operator runs before contacting vm23.
#
# vm23 does not run Rails suites, repository scans, dependency installs or asset
# builds. It only receives the pinned release and checks preinstalled bundles.
#
# Usage: OPENBSD/bin/rehearse   (exit 0 only when every check passes)

require "open3"
require "rbconfig"

ROOT = File.expand_path("../..", __dir__)
RUBY = RbConfig.ruby

LINTS = %w[
  MASTER/tools/rhythm_lint.rb
  MASTER/tools/rails/operator/fallback_drift_lint.rb
  MASTER/tools/empty_state_lint.rb
  MASTER/tools/adhoc_empty_lint.rb
  MASTER/tools/chrome_i18n_lint.rb
  MASTER/tools/rails/operator/dialect_token_drift_check.rb
].freeze

CONTRACTS = %w[
  OPENBSD/test/test_deploy_paths_exist.rb
  OPENBSD/test/test_vps_deploy_contract.rb
  OPENBSD/test/test_ci_mirror_contract.rb
  OPENBSD/test/test_ruby_select.rb
  RAILS/test/require_relative_targets_test.rb
  RAILS/test/no_top_level_test_calls_test.rb
  RAILS/test/coverage_layout_test.rb
  RAILS/test/erb_container_balance_test.rb
  RAILS/test/test_path_idioms_test.rb
  RAILS/test/typography_lint_test.rb
].freeze

FAILURE_OUTPUT_LIMIT = 32_768

def run(label, *argv, chdir: ROOT)
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  out, status = Open3.capture2e(*argv, chdir: chdir)
  secs = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
  puts format("%-4s %5.1fs  %s", status.success? ? "ok" : "FAIL", secs, label)
  unless status.success?
    detail = out.to_s
    if detail.bytesize > FAILURE_OUTPUT_LIMIT
      half = FAILURE_OUTPUT_LIMIT / 2
      head = detail.byteslice(0, half).to_s.scrub
      tail = detail.byteslice(-half, half).to_s.scrub
      omitted = detail.bytesize - head.bytesize - tail.bytesize
      detail = "#{head}\n... failure output truncated; omitted #{omitted} bytes ...\n#{tail}"
    end
    detail.lines.each { |line| puts "       #{line.rstrip}" }
  end
  status.success?
end

results = []
LINTS.each do |tool|
  results << run(tool, RUBY, File.join(ROOT, tool), chdir: File.join(ROOT, "MASTER"))
end
CONTRACTS.each do |test|
  dir = test.split("/").first
  results << run(test, RUBY, "-Itest", "-I#{File.join(ROOT, 'MASTER', 'lib')}", File.join(ROOT, test), "--verbose", chdir: File.join(ROOT, dir))
end

failed = results.count(false)
puts failed.zero? ? "rehearsal: all #{results.size} checks passed" : "rehearsal: #{failed} of #{results.size} failed - fix these before vps-deploy"
exit(failed.zero? ? 0 : 1)
