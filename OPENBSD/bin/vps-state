#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "open3"
require "yaml"
require_relative "../lib/dmesg"

ROOT = File.expand_path("../..", __dir__)
require_relative "../lib/environment"
require_relative "../lib/pid_probe"

STAMP_DIR = ENV.fetch("PUB4_STAMP_DIR", "/var/db/pub4")
# pub4-alert's record: what a healed or noted symptom left behind when it recurred.
ALERT_LOG = ENV.fetch("PUB4_ALERT_LOG", "/var/log/pub4-alerts.log")

def git_short(path)
  return "missing" unless File.directory?(path)
  out, status = Open3.capture2e("git", "-C", path, "rev-parse", "--short", "HEAD")
  return out.strip if status.success?

  "no-git"
rescue StandardError
  "unknown"
end

def service_state(service)
  broker = "/usr/local/sbin/pub5-admin"
  return "unknown (pub5-admin missing)" unless File.file?(broker) && !File.symlink?(broker) && File.executable?(broker)

  out, status = Open3.capture2e("doas", "-n", broker, "service", "check", service)
  return "ok" if status.success? && out.include?("(ok)")

  out.strip.empty? ? "failed" : out.strip
rescue StandardError
  "unknown"
end

def port_listening?(port)
  Deploy::Environment.port_open?(port) ? "listening" : "closed"
end

# The TTS socket is the half of master a green service and an open port do not
# prove: a worker that dies on EACCES or at Bundler.setup leaves /health up and
# checks.tts true while no socket answers. /health already reports it, so read
# it rather than inferring.
def master_tts_socket(port)
  http = Net::HTTP.new("127.0.0.1", port)
  http.open_timeout = 2
  http.read_timeout = 5
  response = http.get("/health")
  return "unknown" unless response.is_a?(Net::HTTPSuccess)

  value = JSON.parse(response.body).dig("deploy", "tts_socket")
  value.nil? ? "unknown" : value.to_s
rescue StandardError
  "unknown"
end

def deploy_stamp(app)
  path = File.join(STAMP_DIR, "last_deploy_#{app}.json")
  return nil unless File.file?(path)

  JSON.parse(File.read(path))
rescue StandardError => e
  # A stamp that exists and will not parse is a deploy that wrote half a file,
  # not a deploy that never happened, so it says so rather than reading as nil.
  { "sha" => "CORRUPT", "at" => "#{path}: #{e.class}" }
end

# In-progress deploy status (RAILS/_core.sh's deploy_status, written by both
# the SKIP_CI=1 path and vps_ci.sh). "running" with a pid that no longer
# exists means a deploy died mid-step rather than finishing -- surface that
# distinctly from a genuinely live one so it doesn't read as still-in-flight.
def deploy_in_progress(app)
  path = File.join(STAMP_DIR, "deploy_status", "#{app}.json")

  # /var/db/pub4/deploy_status is root-only by design. On vm23 read through the
  # fixed broker instead of treating denied direct reads as "no deploy". A
  # custom stamp directory remains directly readable for tests and local drills.
  if Deploy::Environment.on_vps? && File.expand_path(STAMP_DIR) == "/var/db/pub4"
    broker = "/usr/local/sbin/pub5-admin"
    unless File.file?(broker) && !File.symlink?(broker) && File.executable?(broker)
      return unavailable_deploy_status(path, "pub5-admin missing or untrusted")
    end

    output, result = Open3.capture2e("doas", "-n", broker, "deploy-status-read", app)
    return unavailable_deploy_status(path, "status broker failed (exit #{result.exitstatus})") unless result.success?

    begin
      record = JSON.parse(output)
    rescue JSON::ParserError => e
      return corrupt_deploy_status(path, e.class.to_s)
    end
  else
    return nil unless File.file?(path)

    begin
      record = JSON.parse(File.read(path))
    rescue JSON::ParserError => e
      return corrupt_deploy_status(path, e.class.to_s)
    rescue SystemCallError => e
      return unavailable_deploy_status(path, e.class.to_s)
    end
  end

  return nil if record.nil?
  unless record.is_a?(Hash) && %w[running done failed].include?(record["state"])
    return corrupt_deploy_status(path, "invalid status schema")
  end
  return nil if record["state"] != "running"

  record["stale"] = !pid_alive?(record["pid"])
  record
rescue SystemCallError => e
  unavailable_deploy_status(path, e.class.to_s)
rescue StandardError => e
  unavailable_deploy_status(path, e.class.to_s)
end

def corrupt_deploy_status(path, reason)
  {
    "state" => "CORRUPT",
    "corrupt" => true,
    "stale" => true,
    "step" => "status metadata corrupt (#{reason})",
    "pid" => nil,
    "error" => "#{path}: #{reason}",
  }
end

def unavailable_deploy_status(path, reason)
  {
    "state" => "UNAVAILABLE",
    "unavailable" => true,
    "stale" => true,
    "step" => "status read unavailable (#{reason})",
    "pid" => nil,
    "error" => "#{path}: #{reason}",
  }
end

def pid_alive?(pid)
  Deploy::PidProbe.alive?(pid)
end

# Fleet receipts are root-private under /var/db/pub5. On the real VPS read
# them only through the fixed broker; custom stamp roots are local test/drill
# fixtures and use the same bounded response contract.
DEPLOY_RUN_SCAN_LIMIT = 500
DEPLOY_RUN_PENDING_LIMIT = 100
DEPLOY_RUN_APPS = %w[master brgen amber bsdports mrdamascy].freeze
DEPLOY_RUN_SERVICES = %w[master brgen amber bsdports mrdamascy brgen_jobs amber_jobs bsdports_jobs].freeze

def validate_pending_deploy_records!(records)
  raise "deploy-run-pending-list pending field is not an array" unless records.is_a?(Array)
  records.each do |record|
    raise "invalid deploy-run record" unless record.is_a?(Hash)
    raise "invalid deploy-run ID" unless record["run_id"].is_a?(String) &&
      record["run_id"].match?(/\A\d{8}T\d{6}Z-[a-z0-9_-]{1,32}-\d+\z/)
    raise "invalid deploy-run target" unless %w[master brgen amber bsdports mrdamascy all rails].include?(record["target"])
    raise "invalid deploy-run status" unless %w[running failed].include?(record["status"])
    raise "invalid deploy-run recovery state" unless record["recovery_state"] == "pending"
    raise "invalid deploy-run PID" unless record["pid"].is_a?(Integer) && record["pid"].positive?
    raise "invalid deploy-run stage" unless record["stage"].is_a?(String) &&
      record["stage"].match?(/\A[A-Za-z0-9_.:+\/-]{1,160}\z/)
    raise "invalid deploy-run snapshot marker" unless [true, false].include?(record["snapshot_recorded"])
    services = record["started_services"]
    raise "invalid deploy-run service snapshot" unless services.is_a?(Array) &&
      services.length <= DEPLOY_RUN_SERVICES.length && services.uniq == services &&
      services.all? { |service| DEPLOY_RUN_SERVICES.include?(service) }
    ports = record["ports"]
    raise "invalid deploy-run port map" unless ports.is_a?(Hash) &&
      ports.all? { |service, port| DEPLOY_RUN_APPS.include?(service) && port.is_a?(Integer) && (1..65_535).cover?(port) }
    order = record["restore_order"]
    raise "invalid deploy-run restore order" unless order.is_a?(Array) &&
      order.length <= DEPLOY_RUN_APPS.length && order.uniq == order &&
      order.all? { |service| DEPLOY_RUN_APPS.include?(service) }
    %w[pinned_sha previous_sha].each do |field|
      value = record[field]
      raise "invalid deploy-run #{field}" unless value.nil? || value == "unknown" ||
        (value.is_a?(String) && value.match?(/\A[0-9a-f]{7,40}\z/i))
    end
    raise "invalid deploy-run log path" unless record["run_log"].is_a?(String) &&
      record["run_log"].match?(/\A\/[A-Za-z0-9_.\/-]{1,2048}\z/)
  end
  records
end

def deploy_run_records
  if Deploy::Environment.on_vps? && File.expand_path(STAMP_DIR) == "/var/db/pub4"
    broker = "/usr/local/sbin/pub5-admin"
    unless File.file?(broker) && !File.symlink?(broker) && File.executable?(broker)
      return [nil, "pub5-admin missing or untrusted", false, 0]
    end

    output, result = Open3.capture2e("doas", "-n", broker, "deploy-run-pending-list")
    return [nil, "deploy-run-pending-list broker failed (exit #{result.exitstatus})", false, 0] unless result.success?
    document = JSON.parse(output)
  else
    directory = File.join(STAMP_DIR, "deploy_runs")
    return [[], nil, false, 0] unless File.exist?(directory) || File.symlink?(directory)
    raise "corrupt deploy-run directory is a symlink: #{directory}" if File.symlink?(directory)
    raise "#{directory} is not a directory" unless File.directory?(directory)

    names = Dir.children(directory).grep(/\A\d{8}T\d{6}Z-[a-z0-9_-]{1,32}-\d+\.json\z/).sort.reverse
    scanned = names.length
    truncated = scanned > DEPLOY_RUN_SCAN_LIMIT
    names = names.first(DEPLOY_RUN_SCAN_LIMIT)
    records = names.map do |name|
      path = File.join(directory, name)
      raise "#{path} is a symlink; refusing deploy-run read" if File.symlink?(path)
      raise "#{path} is not a regular file" unless File.file?(path)
      JSON.parse(File.read(path))
    end.select do |record|
      record.is_a?(Hash) && record["recovery_state"] == "pending" && %w[running failed].include?(record["status"])
    end
    truncated = true if records.length > DEPLOY_RUN_PENDING_LIMIT
    records = records.first(DEPLOY_RUN_PENDING_LIMIT)
    return [validate_pending_deploy_records!(records), nil, truncated, scanned]
  end

  raise "deploy-run-pending-list response is not an object" unless document.is_a?(Hash)
  raise "invalid deploy-run-pending-list truncated marker" unless [true, false].include?(document["truncated"])
  scanned = document["scanned"]
  returned = document["returned"]
  raise "invalid deploy-run-pending-list counts" unless
    scanned.is_a?(Integer) && scanned >= 0 &&
    returned.is_a?(Integer) && returned >= 0 &&
    returned <= DEPLOY_RUN_PENDING_LIMIT
  records = validate_pending_deploy_records!(document["pending"])
  raise "deploy-run-pending-list returned count mismatch" unless returned == records.length
  [records, nil, document["truncated"], scanned]
rescue JSON::ParserError => e
  [nil, "CORRUPT: deploy-run-pending-list JSON (#{e.class})", false, 0]
rescue StandardError => e
  category = e.message.match?(/\A(?:invalid deploy-run|deploy-run-pending-list response|deploy-run-pending-list pending|deploy-run-pending-list truncated|deploy-run-pending-list counts|deploy-run-pending-list returned|corrupt deploy-run|.*symlink; refusing deploy-run|.*is not a regular file)/) ? "CORRUPT" : "UNAVAILABLE"
  [nil, "#{category}: #{e.class}: #{e.message}", false, 0]
end

def deploy_recovery_status
  records, error, truncated, scanned = deploy_run_records
  if error
    state = error.start_with?("CORRUPT:") ? "corrupt" : "unavailable"
    return { state: state, count: 0, pending: [], truncated: false, scanned: scanned, error: error }
  end

  pending = records.sort_by { |record| record.fetch("started_at", "") }.reverse.map do |record|
    {
      run_id: record.fetch("run_id"),
      target: record.fetch("target"),
      status: record.fetch("status"),
      stage: record.fetch("stage"),
      pid: record.fetch("pid"),
      pid_state: pid_alive?(record["pid"]) ? "present" : "gone",
      snapshot: record["snapshot_recorded"] ? "complete" : "incomplete",
      started_services: record.fetch("started_services"),
      restore_order: record.fetch("restore_order"),
      ports: record.fetch("ports"),
      pinned_sha: record["pinned_sha"] || "unknown",
      run_log: record.fetch("run_log"),
      updated_at: record["updated_at"],
    }
  end

  { state: truncated ? "truncated" : (pending.empty? ? "none" : "pending"),
    count: pending.length, pending: pending, truncated: truncated, scanned: scanned }
end

def app_row(name, port)
  dev_sha = git_short(ROOT)
  deployed_root = Deploy::Environment.deployed_app_root(name)
  stamp = deploy_stamp(name)
  deployed_sha = if File.directory?(deployed_root)
                   short = git_short(deployed_root)
                   short == "no-git" && stamp ? stamp["sha"].to_s : short
                 else
                   "missing"
                 end
  {
    app: name,
    dev_sha: dev_sha,
    deployed_sha: deployed_sha,
    drift: dev_sha != deployed_sha,
    service: service_state(name),
    port: port,
    port_state: port_listening?(port),
    last_deploy: deploy_stamp(name),
    deploy_in_progress: deploy_in_progress(name),
  }
end

# Newest first, at most `limit`. An unreadable log is reported as a line of its own:
# silence here would read as "no alerts", the one thing it cannot be sure of.
def recent_alerts(limit = 5)
  return [] unless File.file?(ALERT_LOG)

  File.readlines(ALERT_LOG, chomp: true, encoding: "UTF-8").last(limit).reverse
rescue SystemCallError => e
  ["alert log unreadable (#{e.class}): #{ALERT_LOG}"]
end

def print_deploy_in_progress(status)
  return unless status

  flag = status["stale"] ? "STALE (pid #{status['pid']} gone -- deploy likely crashed mid-step)" : "pid #{status['pid']}"
  puts "           DEPLOY IN PROGRESS: #{status['step']} (since #{status['started_at']}, #{flag})"
end

if ARGV.intersect?(%w[-h --help])
  puts "usage: ruby OPENBSD/bin/vps-state [--json]"
  puts "  master and every apps.yml app: service, port, deployed SHA and last deploy stamp"
  exit 0
end

unless Deploy::Environment.on_vps?
  warn "vps-state: skip - not on VPS (use: bin/operator vps state --remote)"
  exit 0
end

apps_yml = YAML.safe_load(File.read(File.join(ROOT, "RAILS", "apps.yml")))
ports = apps_yml.fetch("apps").reject { |_, m| m["deployed"] == false }.transform_values { |m| m.fetch("port").to_i }
# The names come from the same read as the ports. They were a frozen
# %w[brgen amber bsdports] twelve lines above this, which is a second fleet
# inventory sitting beside the file that is the first one — a fourth app would
# have shown its port here and never its row. master is not in apps.yml because
# it is not under /home/*/app, so it keeps the block of its own below.
apps = ports.keys

master_port = Integer(ENV.fetch("MASTER_WEB_PORT", "53187"))

payload = {
  host: `hostname`.strip,
  dev_repo: ROOT,
  dev_sha: git_short(ROOT),
  master: {
    service: service_state("master"),
    port: master_port,
    port_state: port_listening?(master_port),
    tts_socket: master_tts_socket(master_port),
    last_deploy: deploy_stamp("master"),
    deploy_in_progress: deploy_in_progress("master"),
  },
  apps: apps.map { |name| app_row(name, ports.fetch(name)) },
  deploy_recovery: deploy_recovery_status,
  alerts: recent_alerts,
}

if ARGV.include?("--json")
  puts JSON.pretty_generate(payload)
else
  puts Deploy::Dmesg.line("vps0", "host", "name=#{payload[:host]}")
  puts Deploy::Dmesg.line("git0", "repo", "path=#{payload[:dev_repo]} sha=#{payload[:dev_sha]}")
  m = payload[:master]
  puts Deploy::Dmesg.line(
    "service0",
    "master",
    "state=#{m[:service]} port=#{m[:port]} port_state=#{m[:port_state]} tts=#{m[:tts_socket]}",
  )
  if m[:last_deploy]
    puts Deploy::Dmesg.line("deploy0", "master", "sha=#{m[:last_deploy]['sha']} at=#{m[:last_deploy]['at']} status=#{m[:last_deploy]['status']}")
  end
  if m[:deploy_in_progress]
    status = m[:deploy_in_progress]

    state = status["corrupt"] ? "corrupt" : status["unavailable"] ? "unavailable" : status["stale"] ? "stale" : "running"
    puts Deploy::Dmesg.line("deploy0", "master", "state=#{state} step=#{status['step']} pid=#{status['pid']}")
  end
  payload[:apps].each do |row|
    drift = row[:drift] ? "drift" : "sync"
    puts Deploy::Dmesg.line(
      "service0",
      row[:app],
      "state=#{row[:service]} port=#{row[:port]} port_state=#{row[:port_state]} deployment=#{drift}",
    )
    if row[:last_deploy]
      puts Deploy::Dmesg.line(
        "deploy0",
        row[:app],
        "sha=#{row[:last_deploy]['sha']} at=#{row[:last_deploy]['at']} status=#{row[:last_deploy]['status']}",
      )
    end
    if row[:deploy_in_progress]
      status = row[:deploy_in_progress]
      state = status["corrupt"] ? "corrupt" : status["unavailable"] ? "unavailable" : status["stale"] ? "stale" : "running"
      puts Deploy::Dmesg.line(
        "deploy0",
        row[:app],
        "state=#{state} step=#{status['step']} pid=#{status['pid']}",
      )
    end
  end
  recovery = payload[:deploy_recovery]
  if %w[unavailable corrupt].include?(recovery[:state])
    puts Deploy::Dmesg.line("recovery0", "fleet", "state=#{recovery[:state]} error=#{recovery[:error]}")
  else
    suffix = recovery[:truncated] ? " truncated=true scanned=#{recovery[:scanned]} (run recover --plan for complete list)" : ""
    puts Deploy::Dmesg.line("recovery0", "fleet", "state=#{recovery[:state]} pending=#{recovery[:count]}#{suffix}")
    recovery[:pending].each do |run|
      puts Deploy::Dmesg.line(
        "recovery0",
        run[:run_id],
        "target=#{run[:target]} status=#{run[:status]} owner_pid_state=#{run[:pid_state]} snapshot=#{run[:snapshot]} started=#{run[:started_services].join(",")} order=#{run[:restore_order].join(",")} stage=#{run[:stage]} pid=#{run[:pid]} sha=#{run[:pinned_sha]}",
      )
      puts Deploy::Dmesg.line("recovery0", run[:run_id], "log=#{run[:run_log]} inspect=zsh OPENBSD/bin/vps-deploy recover --plan")
    end
  end
  payload[:alerts].each { |line| puts Deploy::Dmesg.line("alert0", "pub4", line) }
end
