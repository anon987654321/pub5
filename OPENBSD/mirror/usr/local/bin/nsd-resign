#!/usr/bin/env ruby
# frozen_string_literal: true

# Maintain signatures for the pregenerated NSD zone inventory.
# Run by daily.local or the single OPERATOR.sh apply transaction.
# Usage: nsd-resign [--force] [--no-reload]
# --force re-signs all zones after tracked zone/config changes.
# --no-reload defers activation to the caller.
# NSD_ZONES_DIR defaults to /var/nsd/zones/master.
#
# The active DNSKEY set is authoritative. A new key on disk is not adopted
# automatically: KSK rollover needs parent-side DS work, and ZSK rollover needs
# a deliberate pre-publication sequence.

require "base64"
require "date"
require "open3"

ZONES_DIR = ENV.fetch("NSD_ZONES_DIR", "/var/nsd/zones/master")
RESIGN_DAYS = 14
VALIDITY_DAYS = 30
FORCE = ARGV.include?("--force")
NO_RELOAD = ARGV.include?("--no-reload")
UNKNOWN_OPTIONS = ARGV - %w[--force --no-reload]

unless UNKNOWN_OPTIONS.empty?
  warn "usage: nsd-resign [--force] [--no-reload]"
  exit 64
end

def log(msg) = $stdout.puts("nsd-resign: #{msg}")

def expiry_date(signed_zone)
  File.read(signed_zone).scan(/RRSIG\s+\S+\s+\d+\s+\d+\s+\d+\s+(\d{14})/).flatten.map { |s|
    Date.strptime(s, "%Y%m%d%H%M%S")
  }.min
rescue StandardError => e
  log "cannot read expiry from #{signed_zone} (#{e.class}: #{e.message}) - resigning"
  nil
end

def dnskey_records(path)
  return [] unless File.file?(path)

  File.readlines(path, encoding: "UTF-8").filter_map do |line|
    match = line.match(/^\S+\s+(?:\d+\s+)?IN\s+DNSKEY\s+(\d+)\s+(\d+)\s+(\d+)\s+([A-Za-z0-9+\/=]+)\s*(?:;.*)?$/)
    next unless match

    flags, protocol, algorithm, encoded = match.captures
    rdata = [Integer(flags, 10), Integer(protocol, 10), Integer(algorithm, 10)].pack("nCC")
    rdata += Base64.decode64(encoded)
    accumulator = rdata.bytes.each_with_index.sum { |byte, index| index.even? ? byte << 8 : byte }
    accumulator += (accumulator >> 16) & 0xFFFF
    { flags: Integer(flags, 10), tag: accumulator & 0xFFFF }
  end
rescue SystemCallError, EncodingError, ArgumentError
  []
end

def key_files_for(zone)
  Dir[File.join(ZONES_DIR, "K#{zone}.+*.key")].sort.filter_map do |path|
    next if File.symlink?(path) || !File.file?(path)

    record = dnskey_records(path).first
    next unless record && [256, 257].include?(record[:flags])

    { path:, flags: record[:flags], tag: record[:tag], mtime: File.mtime(path) }
  rescue SystemCallError
    next
  end
end

# Preserve DNSKEYs already published by this zone. A new key file is not
# automatically adopted. On first signing, exactly one KSK and one ZSK are
# accepted; ambiguity is a deployment failure, not a guess by mtime.
def keys_for(zone, signed_zone)
  candidates = key_files_for(zone)
  active = dnskey_records(signed_zone)
  selected = []

  [257, 256].each do |flags|
    published = active.select { |record| record[:flags] == flags }.map { |record| record[:tag] }.uniq
    if published.empty?
      matching = candidates.select { |entry| entry[:flags] == flags }
      return [] unless matching.one?
      selected << matching.first
      next
    end

    published.each do |tag|
      matching = candidates.select { |entry| entry[:flags] == flags && entry[:tag] == tag }
      return [] if matching.empty?
      selected << matching.max_by { |entry| entry[:mtime] }
    end
  end

  selected.map { |entry| entry[:path].delete_suffix(".key") }
end

def sign(zone, zone_file, keys, expiry)
  exp = expiry.strftime("%Y%m%d000000")
  _out, err, status = Open3.capture3("ldns-signzone", "-e", exp, zone_file, *keys, chdir: ZONES_DIR)
  unless status.success?
    log "FAIL #{zone}: #{err.to_s.strip}"
    return false
  end

  signed = "#{zone_file}.signed"
  unless File.file?(signed) && !File.symlink?(signed) && File.size?(signed)
    log "FAIL #{zone}: signer returned success without a regular non-empty signed zone"
    return false
  end
  log "signed #{zone} -> expires #{expiry}"
  true
rescue SystemCallError => e
  log "FAIL #{zone}: ldns-signzone #{e.class}: #{e.message}"
  false
end

return unless $PROGRAM_NAME == __FILE__

zones = Dir[File.join(ZONES_DIR, "*.zone")].sort
if zones.empty?
  log "FAIL no zones under #{ZONES_DIR}"
  exit 1
end

changed = []
failed = []
keyed = 0

zones.each do |zone_file|
  zone = File.basename(zone_file, ".zone")
  signed = "#{zone_file}.signed"
  keys = keys_for(zone, signed)
  if keys.empty?
    log "FAIL #{zone}: missing, ambiguous or unpublished active KSK/ZSK key material"
    failed << zone
    next
  end

  keyed += 1
  needs_sign = FORCE
  unless needs_sign
    exp = expiry_date(signed) if File.file?(signed)
    needs_sign = exp.nil? || (exp - Date.today) < RESIGN_DAYS
    next unless needs_sign
    log "#{zone} expires #{exp || "unknown"} - resigning"
  end

  unless sign(zone, zone_file, keys, Date.today + VALIDITY_DAYS)
    failed << zone
    next
  end
  changed << zone
end

if keyed.zero?
  log "FAIL no signable zones: no complete KSK/ZSK pairs under #{ZONES_DIR}"
  exit 1
end
if failed.any?
  log "FAIL #{failed.size} zone(s) not signed: #{failed.join(", ")}"
  exit 1
end

if changed.any?
  if NO_RELOAD
    log "signed #{changed.size} zone(s); activation deferred to the caller"
  else
    reload_failed = []
    changed.each do |zone|
      _out, err, status = Open3.capture3("nsd-control", "reload", zone)
      unless status.success?
        log "FAIL reload #{zone}: #{err.to_s.strip}"
        reload_failed << zone
      end
    end
    unless reload_failed.empty?
      log "FAIL #{reload_failed.size} zone reload(s): #{reload_failed.join(", ")}"
      exit 1
    end
    _out, err, status = Open3.capture3("nsd-control", "notify")
    unless status.success?
      log "FAIL notify: #{err.to_s.strip}"
      exit 1
    end
    log "reloaded #{changed.size} zone(s): #{changed.join(", ")}"
  end
end
log "all #{keyed} zones valid - nothing to do" if changed.empty?
