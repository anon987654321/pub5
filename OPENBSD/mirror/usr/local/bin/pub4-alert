#!/bin/ksh
# pub4-alert - the one place a recurring symptom becomes a durable, actionable line.
#
#   pub4-alert raise KEY MESSAGE...   record an alert, once per quiet window per KEY
#   pub4-alert watch                  disk, swap, failed services, stale backup
#   pub4-alert show [N]               the last N alerts (default 20)
#
# Why it exists. relayd-watchdog restarts relayd, resource_guard sheds apps and
# uptime-check logs DOWN lines, and each healed or noted its symptom into a log
# nobody reads: config-drift-check wrote the same three amber.brgen.no lines every
# fifteen minutes into a 30 KB file, and the root mailbox was last written in
# October 2025. A healer that succeeds quietly hides the fault that makes it run
# again, so the repeat is what gets recorded, here, and `vps-state` prints it.
#
# raise is rate-limited per KEY (PUB4_ALERT_QUIET seconds, six hours by default),
# so a fault that persists for a week is a handful of lines, not ten thousand, and
# each line still says what to do. The record is /var/log/pub4-alerts.log
# (rotated by newsyslog) plus one daemon.crit syslog line.
#
# watch is bounded: it runs five reads (df, swapctl, rcctl, backup marker and
# CPU-monitor heartbeat) and changes nothing. Run it from root's crontab.
# PUB4_ALERT_PATH_PREFIX lets the test put fake df, swapctl and rcctl first.
PATH=${PUB4_ALERT_PATH_PREFIX:+$PUB4_ALERT_PATH_PREFIX:}/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin

LOG=${PUB4_ALERT_LOG:-/var/log/pub4-alerts.log}
STATE=${PUB4_ALERT_STATE:-/var/db/pub4/alerts}
QUIET=${PUB4_ALERT_QUIET:-21600}
DISK_MAX=${PUB4_ALERT_DISK_MAX:-90}
SWAP_MAX=${PUB4_ALERT_SWAP_MAX:-92}
BACKUP_MARKER=${PUB4_DR_MARKER:-/home/dev/.dr_pull_ok}
BACKUP_MAX_AGE=${PUB4_ALERT_BACKUP_MAX_AGE:-172800}
# brgen_jobs is failed by design: no resident Solid Queue worker fits in 1 GB, and
# drain-jobs.sh runs the queue from cron (etc/crontab.vm23 says so).
ALLOW_FAILED=${PUB4_ALERT_ALLOW_FAILED:-brgen_jobs}

# Root-only, bounded CPU monitoring. vmstat supplies five one-second intervals;
# the first (since-boot) row is discarded. The 5-second sample runs once a minute.
CPU_HISTORY=${PUB4_CPU_HISTORY:-/var/log/cpu-watch.log}
CPU_HEARTBEAT=${PUB4_CPU_HEARTBEAT:-$STATE/cpu-watch.seen}
CPU_STATE=${PUB4_CPU_STATE:-$STATE/cpu-watch}
CPU_PRESSURE=${PUB4_CPU_PRESSURE:-/var/db/pub4/cpu_pressure}
CPU_DEPLOY_FLAGS=${PUB4_CPU_DEPLOY_FLAGS:-/home/dev/pub5/.deploying*}
CPU_WARN=80
CPU_CRIT=95
CPU_RECOVER=60
CPU_WARN_STRIKES=3
CPU_CRIT_STRIKES=2
CPU_DEPLOY_STRIKES=${PUB4_CPU_DEPLOY_STRIKES:-15}
CPU_RECOVER_STRIKES=3
CPU_HEARTBEAT_MAX_AGE=420

now() { date +%s; }

raise() {
  key=$1
  shift
  case $key in
  *[!A-Za-z0-9._-]*|'') print -u2 "pub4-alert: key must be letters, digits, . _ -"; return 2 ;;
  esac
  mkdir -p "$STATE" 2>/dev/null
  stamp=$STATE/$key
  t=$(now)
  last=0
  [[ -f $stamp ]] && read last < "$stamp"
  case $last in *[!0-9]*|'') last=0 ;; esac
  if (( t - last < QUIET )); then
    return 0
  fi
  print -r -- "$t" > "$stamp"
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) $key $*"
  print -r -- "$line" >> "$LOG"
  ${PUB4_ALERT_LOGGER:-logger} -p daemon.crit -t pub4-alert "$key: $*" 2>/dev/null
  return 0
}

# "/home" -> home, "/usr/local" -> usr_local, "/" -> root; pdksh has no ${var//a/b}.
slug() {
  s=${1#/}
  out=
  while [[ $s == */* ]]; do
    out=$out${s%%/*}_
    s=${s#*/}
  done
  out=$out$s
  [[ -n $out ]] || out=root
  print -r -- "$out"
}

watch_disk() {
  df -P 2>/dev/null | while read -r fs blocks used avail cap mount; do
    case $cap in
    [0-9]*%) ;;
    *) continue ;;
    esac
    pct=${cap%\%}
    if (( pct >= DISK_MAX )); then
      raise "disk-$(slug "$mount")" "$mount is ${pct}% full (limit ${DISK_MAX}%) - find the growth with: doas /usr/local/sbin/pub4-admin disk-usage $mount; logs rotate in /etc/newsyslog.conf"
    fi
  done
}

watch_swap() {
  # OpenBSD 7.8, as observed on vm23: "total: 2588672 512-blocks allocated, 2003000 used, 585672 available"
  out=$(swapctl -s 2>/dev/null) || return 0
  set -- $out
  alloc= used=
  while (( $# )); do
    case $1 in
    allocated|allocated,) alloc=$prev2 ;;
    used|used,) used=$prev ;;
    esac
    prev2=$prev
    prev=$1
    shift
  done
  alloc=${alloc%k}
  used=${used%k}
  case $alloc$used in *[!0-9]*|'') return 0 ;; esac
  (( alloc > 0 )) || return 0
  pct=$(( used * 100 / alloc ))
  if (( pct >= SWAP_MAX )); then
    raise swap "swap is ${pct}% used (limit ${SWAP_MAX}%) - the box is paging; run: doas ksh /usr/local/bin/resource_guard.sh and read /var/log/resource_guard_history.log"
  fi
}

watch_services() {
  rcctl ls failed 2>/dev/null | while read -r svc; do
    [[ -n $svc ]] || continue
    case " $ALLOW_FAILED " in *" $svc "*) continue ;; esac
    raise "failed-$svc" "$svc is in rcctl failed - read /var/log/daemon, then: doas rcctl restart $svc (an amber or bsdports failure may be resource_guard shedding: check /var/db/resource_guard_shed)"
  done
}

watch_backup() {
  t=$(now)
  if [[ ! -f $BACKUP_MARKER ]]; then
    raise backup-unreported "no pull has reported to $BACKUP_MARKER - run ruby OPENBSD/mirror/bin/dr-pull on the operator Mac and check ~/pub5-dr/dr-pull.log"
    return 0
  fi
  read last < "$BACKUP_MARKER"
  case $last in *[!0-9]*|'') last=0 ;; esac
  age=$(( t - last ))
  if (( age > BACKUP_MAX_AGE )); then
    raise backup-stale "the newest dr-pull reported $(( age / 3600 )) hours ago (limit $(( BACKUP_MAX_AGE / 3600 ))) - on the operator Mac: ruby OPENBSD/mirror/bin/dr-pull, then read ~/pub5-dr/dr-pull.log; launchd job no.brgen.pub4-dr"
  fi
}

# A transition alert bypasses the ordinary six-hour quiet window. State
# transitions, not every minute of the same incident, are the unit of notice.
raise_transition() {
  typeset previous_quiet result
  previous_quiet=$QUIET
  QUIET=0
  raise "$@"
  result=$?
  QUIET=$previous_quiet
  return $result
}

# OpenBSD vmstat -c 6 -w 1 prints one since-boot summary followed by five
# one-second interval rows. CPU columns are the final us/sy/id fields.
# The five interval rows, not the lifetime average, determine this sample.
vmstat_cpu_sample() {
  vmstat -c 6 -w 1 2>/dev/null | {
    typeset rows=0 samples=0 user_sum=0 system_sum=0 idle_sum=0 field a b c
    while IFS= read -r row; do
      set -- $row
      (( $# >= 3 )) || continue
      a=""
      b=""
      c=""
      for field in "$@"; do
        a=$b
        b=$c
        c=$field
      done
      case $a$b$c in
      '' | *[!0-9]*) continue ;;
      esac
      if (( rows == 0 )); then
        rows=1
        continue
      fi
      user_sum=$(( user_sum + 10#$a ))
      system_sum=$(( system_sum + 10#$b ))
      idle_sum=$(( idle_sum + 10#$c ))
      samples=$(( samples + 1 ))
    done
    if (( samples != 5 )); then
      print -u2 "pub4-alert: vmstat returned $samples interval rows; expected 5"
      exit 1
    fi
    print -r -- "$(( (user_sum + system_sum) / samples )) $(( user_sum / samples )) $(( system_sum / samples )) $(( idle_sum / samples ))"
  }
}

# Diagnostic only: ps -c reports executable names, never full argument strings
# or process environments. Command-line arguments can contain secrets.
cpu_top_processes() {
  ps -axcr -o pcpu,pid,ppid,user,state,time,comm 2>/dev/null | {
    typeset rows=0 details="" line
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      rows=$(( rows + 1 ))
      (( rows == 1 )) && continue
      (( rows > 4 )) && break
      [[ -n $details ]] && details="$details; "
      details="$details$line"
    done
    print -r -- "${details:-unavailable}"
  }
}

cpu_deploy_in_progress() {
  typeset flag mtime stamp age
  stamp=$(now)
  for flag in $CPU_DEPLOY_FLAGS; do
    [[ -e $flag ]] || continue
    mtime=$(stat -f %m "$flag" 2>/dev/null)
    case $mtime in *[!0-9]*|'') continue ;; esac
    age=$(( stamp - mtime ))
    if (( age >= 0 && age <= 1800 )); then
      return 0
    fi
  done
  return 1
}

watch_cpu_heartbeat() {
  typeset seen stamp age
  stamp=$(now)
  seen=0
  [[ -f $CPU_HEARTBEAT ]] && read seen < "$CPU_HEARTBEAT"
  case $seen in *[!0-9]*|'') seen=0 ;; esac
  age=$(( stamp - seen ))
  if (( seen == 0 || age < 0 || age > CPU_HEARTBEAT_MAX_AGE )); then
    raise cpu-watch-stale "CPU monitor heartbeat is missing or ${age}s old (limit ${CPU_HEARTBEAT_MAX_AGE}s) - inspect root cron and /var/log/cpu-watch.log"
  fi
}

cpu_watch() {
  typeset sample busy user system idle stamp deploying state high critical clear
  typeset previous_state new_state details threshold pressure_tmp heartbeat_tmp
  mkdir -p "$STATE" || return 1
  sample=$(vmstat_cpu_sample) || {
    raise cpu-watch-sample-failed "vmstat CPU sample failed; monitor has no valid measurement - inspect /var/log/daemon and /var/log/cpu-watch.log"
    return 1
  }
  set -- $sample
  if (( $# != 4 )); then
    raise cpu-watch-sample-failed "vmstat CPU sample was malformed; monitor has no valid measurement"
    return 1
  fi
  busy=$1
  user=$2
  system=$3
  idle=$4
  stamp=$(now)
  deploying=0
  cpu_deploy_in_progress && deploying=1

  state=clear
  high=0
  critical=0
  clear=0
  if [[ -f $CPU_STATE ]]; then
    read state high critical clear < "$CPU_STATE"
  fi
  case $state in clear|warning|critical) ;; *) state=clear ;; esac
  case $high in *[!0-9]*|'') high=0 ;; esac
  case $critical in *[!0-9]*|'') critical=0 ;; esac
  case $clear in *[!0-9]*|'') clear=0 ;; esac
  previous_state=$state

  if (( busy >= CPU_WARN )); then
    high=$(( high + 1 ))
  else
    high=0
  fi
  if (( busy >= CPU_CRIT )); then
    critical=$(( critical + 1 ))
  else
    critical=0
  fi

  new_state=$state
  if [[ $state == clear ]]; then
    threshold=$CPU_WARN_STRIKES
    (( deploying )) && threshold=$CPU_DEPLOY_STRIKES
    if (( critical >= CPU_CRIT_STRIKES )); then
      new_state=critical
    elif (( high >= threshold )); then
      new_state=warning
    fi
  elif [[ $state == warning || $state == critical ]]; then
    if (( busy < CPU_RECOVER )); then
      clear=$(( clear + 1 ))
      if (( clear >= CPU_RECOVER_STRIKES )); then
        new_state=clear
        high=0
        critical=0
        clear=0
      fi
    else
      clear=0
      if (( critical >= CPU_CRIT_STRIKES )); then new_state=critical; fi
    fi
  fi

  # An active signal is refreshed every successful minute. The load-shedding
  # guard consumes it only while fresh; it never uses manual core recovery.
  if [[ $new_state == clear ]]; then
    rm -f "$CPU_PRESSURE"
  else
    pressure_tmp="$CPU_PRESSURE.tmp.$"
    if ! ( umask 077; print -r -- "$stamp $busy" > "$pressure_tmp" ) ||
       ! mv -f "$pressure_tmp" "$CPU_PRESSURE"; then
      rm -f "$pressure_tmp"
      raise cpu-watch-state-failed "could not write CPU pressure signal at $CPU_PRESSURE"
      return 1
    fi
  fi
  print -r -- "$new_state $high $critical $clear" > "$CPU_STATE" || {
    raise cpu-watch-state-failed "could not write CPU monitor state at $CPU_STATE"
    return 1
  }
  print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) busy=${busy}% user=${user}% system=${system}% idle=${idle}% state=$new_state deploy=$deploying" >> "$CPU_HISTORY" || {
    raise cpu-watch-log-failed "could not append CPU sample to $CPU_HISTORY"
    return 1
  }
  heartbeat_tmp="$CPU_HEARTBEAT.tmp.$"
  if ! print -r -- "$stamp" > "$heartbeat_tmp" ||
     ! mv -f "$heartbeat_tmp" "$CPU_HEARTBEAT"; then
    rm -f "$heartbeat_tmp"
    raise cpu-watch-state-failed "could not write CPU monitor heartbeat at $CPU_HEARTBEAT"
    return 1
  fi

  if [[ $previous_state == clear && $new_state == warning ]]; then
    details=$(cpu_top_processes)
    if (( deploying )); then
      raise_transition cpu-saturation "CPU busy ${busy}% for $high consecutive minutes during a deploy (alert threshold $CPU_DEPLOY_STRIKES minutes); top processes (names only): $details; history: $CPU_HISTORY"
    else
      raise_transition cpu-saturation "CPU busy ${busy}% for $high consecutive minutes (warning threshold $CPU_WARN%, recovery below $CPU_RECOVER% for $CPU_RECOVER_STRIKES minutes); top processes (names only): $details; history: $CPU_HISTORY"
    fi
  elif [[ $previous_state == clear && $new_state == critical ]] ||
       [[ $previous_state == warning && $new_state == critical ]]; then
    details=$(cpu_top_processes)
    raise_transition cpu-critical "CPU busy ${busy}% for $critical consecutive minutes (critical threshold $CPU_CRIT%); top processes (names only): $details; history: $CPU_HISTORY"
  elif [[ ( $previous_state == warning || $previous_state == critical ) && $new_state == clear ]]; then
    raise_transition cpu-recovered "CPU recovered to ${busy}% busy for $CPU_RECOVER_STRIKES consecutive minutes; active pressure signal cleared"
  fi
  return 0
}


case ${1:-} in
raise)
  shift
  (( $# >= 2 )) || { print -u2 "usage: pub4-alert raise KEY MESSAGE..."; exit 2; }
  raise "$@"
  ;;
watch)
  watch_disk
  watch_swap
  watch_services
  watch_backup
  watch_cpu_heartbeat
  ;;
cpu-watch)
  cpu_watch
  ;;
show)
  n=${2:-20}
  [[ -f $LOG ]] || { print "pub4-alert: no alerts recorded ($LOG)"; exit 0; }
  total=0
  while read -r _; do total=$(( total + 1 )); done < "$LOG"
  skip=$(( total - n ))
  i=0
  while read -r line; do
    i=$(( i + 1 ))
    (( i > skip )) && print -r -- "$line"
  done < "$LOG"
  ;;
*)
  print -u2 "usage: pub4-alert raise KEY MESSAGE... | watch | cpu-watch | show [N]"
  exit 2
  ;;
esac
