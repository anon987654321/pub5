#!/usr/local/bin/ruby
# frozen_string_literal: true

# Root-owned, narrow broker for the production deploy path.
# Never evaluate a command string or accept a filesystem path from argv.
require "digest"
require "etc"
require "fileutils"
require "find"
require "json"
require "securerandom"
require "socket"
require "time"

module Pub5Admin
  APPS = %w[master brgen amber bsdports mrdamascy].freeze
  SERVICES = %w[master brgen amber bsdports mrdamascy brgen_jobs amber_jobs bsdports_jobs].freeze
  SERVICE_ACTIONS = %w[check get start stop restart].freeze
  RCCTL = "/usr/sbin/rcctl"
  DU = "/usr/bin/du"
  DISK_USAGE_PATHS = %w[/home /var].freeze
  RELAYD_CONFIG = "/etc/relayd.conf"
  MASTER_WEB_ROOT = "/home/dev/pub5/MASTER/web"
  RESOURCE_GUARD = "/usr/local/bin/resource_guard.sh"
  SOLID_QUEUE_PROOF = "/usr/local/libexec/pub5/solid_queue_proof.rb"
  CI_PREPARE = "/usr/local/libexec/ci-prepare.ksh"
  CI_RUN = "/usr/local/libexec/ci-run.ksh"
  CI_SYNC = "/usr/local/libexec/ci-sync.ksh"
  RAILS_TASK = "/usr/local/libexec/rails-task.ksh"
  RAILS_SYNC = "/usr/local/libexec/rails-sync.ksh"
  # One shared, digest-verified gem CAS for both brokers: pub4-admin captured
  # these objects and rails-task.ksh hydrates from the same root (MIGRATION.md
  # keeps the pub4 installed-state names for state interfaces).
  BUNDLE_CACHE_BASE = "/var/cache/pub4/bundle"
  RAILS_APPS = %w[brgen amber bsdports mrdamascy].freeze
  RAILS_TASK_APPS = %w[master brgen amber bsdports mrdamascy].freeze
  STAMP_DIR = "/var/db/pub5"
  DEPLOY_RUN_SCAN_LIMIT = 500
  DEPLOY_RUN_PENDING_LIMIT = 100
  RUBY_CANDIDATES = %w[/usr/local/bin/ruby].freeze

  module_function

  # A closed argv protocol. Unknown verbs, services and argument shapes refuse.
  def command_for(argv)
    args = Array(argv).map(&:to_s)
    return [DU, "-xk", args[1]] if args.length == 2 && args[0] == "disk-usage" && DISK_USAGE_PATHS.include?(args[1])
    return [RCCTL, "check", "relayd"] if args == %w[service check relayd]
    return [RCCTL, "restart", "relayd"] if args == %w[service restart relayd]
    return [RCCTL, "ls", "started"] if args == %w[service list-started]

    if args.length == 3 && args[0] == "service"
      action, service = args.drop(1)
      return [RCCTL, action, service] if SERVICE_ACTIONS.include?(action) && SERVICES.include?(service)
    end

    nil
  end

  def filter_started_services(output)
    output.to_s.lines.map(&:strip).select { |service| SERVICES.include?(service) }.join("\n")
  end

  def legacy_service_name(app)
    return nil unless RAILS_APPS.include?(app)

    "#{app}_rails"
  end

  def trusted_executable?(path)
    components = File.expand_path(path).split(File::SEPARATOR).reject(&:empty?)
    current = File::SEPARATOR

    components.each_with_index do |component, index|
      current = File.join(current, component)
      stat = File.lstat(current)
      return false if stat.symlink? || !stat.uid.zero? || (stat.mode & 0o022).positive?

      if index == components.length - 1
        return stat.file? && stat.executable?
      end
      return false unless stat.directory?
    end

    false
  rescue SystemCallError
    false
  end

  def trusted_script!(path)
    return if trusted_executable?(path)

    raise "#{path} missing or not a root-owned, non-writable executable"
  end

  def ruby_path
    candidates = RUBY_CANDIDATES + Dir.glob("/usr/local/bin/ruby[0-9]*").sort
    candidates.uniq.find { |path| File.file?(path) && File.executable?(path) } ||
      raise("no system Ruby found under /usr/local/bin")
  end

  def ensure_ci_lock
    ensure_ci_lock_directory!
    path = File.join(STAMP_DIR, "ci.lock")
    ensure_ci_lock_file!(path)
    assign_ci_lock_owner!(path)
    puts path
    0
  rescue ArgumentError
    raise "account dev is missing; cannot establish CI lock ownership"
  end

  def ensure_ci_lock_directory!
    raise "#{STAMP_DIR} is a symlink; refusing root write" if File.symlink?(STAMP_DIR)

    FileUtils.mkdir_p(STAMP_DIR, mode: 0o755)
    directory = File.lstat(STAMP_DIR)
    valid = directory.directory? && directory.uid.zero? && (directory.mode & 0o022).zero?
    raise "#{STAMP_DIR} is not a root-owned, non-writable directory" unless valid
    File.chmod(0o755, STAMP_DIR) unless (directory.mode & 0o777) == 0o755
  end

  def ensure_ci_lock_file!(path)
    if File.exist?(path) || File.symlink?(path)
      lock = File.lstat(path)
      raise "#{path} is not a regular file" unless lock.file? && !lock.symlink?
    else
      File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o644) {}
    end
  end

  def assign_ci_lock_owner!(path)
    dev = Etc.getpwnam("dev")
    File.chown(dev.uid, -1, path)
    File.chmod(0o644, path)
  end

  def write_stamp(app, sha, status)
    validate_stamp_input!(app, sha, status)
    ensure_stamp_directory!
    target = File.join(STAMP_DIR, "last_deploy_#{app}.json")
    payload = {
      app: app, sha: sha, at: Time.now.utc.iso8601,
      status: status, host: Socket.gethostname,
    }
    write_stamp_atomically(target, app, sha, status, payload)
  end

  def validate_stamp_input!(app, sha, status)
    raise "unknown app: #{app}" unless APPS.include?(app)
    raise "invalid commit id" unless sha.match?(/\A(?:[0-9a-f]{7,40}|unknown)\z/i)
    raise "invalid deploy status" unless %w[ok failed ci_ok ci_attested ci_skipped].include?(status)
  end

  def ensure_stamp_directory!
    raise "#{STAMP_DIR} is a symlink; refusing root write" if File.symlink?(STAMP_DIR)

    FileUtils.mkdir_p(STAMP_DIR, mode: 0o755)
    stat = File.lstat(STAMP_DIR)
    valid = stat.directory? && stat.uid.zero? && !stat.symlink?
    raise "#{STAMP_DIR} is not a real root-owned directory" unless valid
    File.chmod(0o755, STAMP_DIR) unless (stat.mode & 0o777) == 0o755
  end

  def write_stamp_atomically(target, app, sha, status, payload)
    temporary = File.join(STAMP_DIR, ".last_deploy_#{app}.#{Process.pid}.#{SecureRandom.hex(6)}")
    begin
      File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write(JSON.generate(payload) + "\n")
        file.flush
        file.fsync
      end
      File.chmod(0o644, temporary)
      File.rename(temporary, target)
      puts "stamp0: #{target} status=#{status} sha=#{sha}"
      0
    ensure
      File.unlink(temporary) if File.exist?(temporary)
    end
  end

  # Verify an operator-approved Host route; the deploy broker never edits
  # /etc/relayd.conf. New hostnames must be installed by the operator first.
  def relayd_check(app, domain, requested_port)
    return 64 unless valid_relayd_request?(app, domain, requested_port)

    original = read_relayd_config
    verify_relayd_backend!(original, app, domain, requested_port)
    verify_relayd_host_route!(original, app, domain)
    puts "relayd0: verified root-approved route #{domain} -> #{app}:#{requested_port}"
    0
  end

  def valid_relayd_request?(app, domain, requested_port)
    return false unless RAILS_APPS.include?(app)
    return false unless domain.include?(".") &&
      domain.match?(/\A[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?\z/) && !domain.include?("..")

    requested_port.match?(/\A[0-9]{1,5}\z/) && (1..65_535).cover?(requested_port.to_i)
  end

  def read_relayd_config
    stat = File.lstat(RELAYD_CONFIG)
    valid = stat.file? && !stat.symlink? && stat.uid.zero? && (stat.mode & 0o022).zero?
    raise "#{RELAYD_CONFIG} must be a root-owned, non-writable regular file" unless valid

    File.read(RELAYD_CONFIG)
  end

  def verify_relayd_backend!(original, app, domain, requested_port)
    escaped_domain = Regexp.escape(domain)
    keypair = /^\s*tls keypair "#{escaped_domain}"\s*$/
    raise "no installed TLS keypair for #{domain}; provision it through OPERATOR first" unless original.match?(keypair)
    raise "no installed relayd table for #{app}" unless original.match?(/^\s*table <#{Regexp.escape(app)}>\s*\{/)

    ports = original.scan(/^\s*forward to <#{Regexp.escape(app)}> port ([0-9]+) check http "\/up" code 200\s*$/).flatten.uniq
    raise "no unique root-configured backend port for #{app}" unless ports.length == 1
    raise "requested port does not match the root-configured backend for #{app}" unless ports.first == requested_port
  end

  def verify_relayd_host_route!(original, app, domain)
    protocol = relayd_https_protocol(original)
    pattern = /^\s*match request header "Host" value "#{Regexp.escape(domain)}" forward to <([a-z0-9_]+)>\s*$/
    routes = protocol.lines.filter_map { |line| (match = line.match(pattern)) && match[1] }.uniq
    raise "no operator-approved Host route for #{domain}; update OPENBSD/mirror/etc/relayd.conf and run OPERATOR.sh first" if routes.empty?
    raise "#{domain} routes to #{routes.join(', ')}, not #{app}" unless routes == [app]
  end

  def relayd_https_protocol(original)
    start = original.index('http protocol "https_proxy" {')
    raise "https_proxy protocol block is missing" unless start

    finish = original.index("\n}", start)
    raise "https_proxy protocol block is unterminated" unless finish

    original[start..finish]
  end

  def app_secret_value(app)
    raise "unknown app: #{app}" unless APPS.include?(app)

    candidates = ["/etc/#{app}.env", "/etc/rails/#{app}.env"]
    candidates.each do |path|
      next unless File.exist?(path) || File.symlink?(path)
      stat = File.lstat(path)
      raise "#{path} must be a root-owned regular file" unless
        stat.file? && !stat.symlink? && stat.uid.zero? && (stat.mode & 0o022).zero?

      secret = File.foreach(path).filter_map do |line|
        match = line.match(/\ASECRET_KEY_BASE=([0-9a-fA-F]{64,256})\s*\z/)
        match && match[1]
      end.first
      return secret if secret
    end

    raise "no valid SECRET_KEY_BASE for #{app}"
  end
  # Create one allowlisted Rails Unix account and its app-owned working directory.
  # Existing paths must already have the expected owner; never chown a tree from
  # the checkout or repair a symlinked destination as root.
  def ensure_app_layout(app)
    return 64 unless RAILS_APPS.include?(app)

    account = ensure_app_account(app)
    validate_app_home!(app, account)
    ensure_app_directory!(app, account)
    puts "app0: #{app} account and app directory ready"
    0
  rescue ArgumentError => e
    raise "account #{app} could not be established: #{e.message}"
  end

  def ensure_app_account(app)
    useradd = "/usr/sbin/useradd"
    raise "useradd is not a trusted system executable" unless trusted_executable?(useradd)

    begin
      Etc.getpwnam(app)
    rescue ArgumentError
      output = IO.popen([useradd, "-m", "-L", "daemon", "-s", "/bin/ksh", app], err: [:child, :out], &:read)
      raise "useradd failed for #{app}: #{output.to_s.strip}" unless $?.success?

      Etc.getpwnam(app)
    end
  end

  def validate_app_home!(app, account)
    home = "/home/#{app}"
    raise "account #{app} has unexpected home #{account.dir}" unless account.dir == home

    stat = File.lstat(home)
    valid = stat.directory? && !stat.symlink? && stat.uid == account.uid &&
      stat.gid == account.gid && (stat.mode & 0o022).zero?
    raise "#{home} must be a real app-owned, non-writable directory" unless valid
  end

  def ensure_app_directory!(app, account)
    path = "/home/#{app}/app"
    return validate_app_directory!(path, account) if File.exist?(path) || File.symlink?(path)

    Dir.mkdir(path, 0o755)
    File.chown(account.uid, account.gid, path)
    File.chmod(0o755, path)
  end

  def validate_app_directory!(path, account)
    stat = File.lstat(path)
    valid = stat.directory? && !stat.symlink? && stat.uid == account.uid &&
      stat.gid == account.gid && (stat.mode & 0o022).zero?
    raise "#{path} must be a real app-owned directory" unless valid
  end

  def ensure_app_secret(app, emit: true)
    return 64 unless APPS.include?(app)

    candidates = ["/etc/#{app}.env", "/etc/rails/#{app}.env"]
    secret = existing_app_secret(candidates)
    if secret
      puts secret if emit
      return 0
    end

    create_app_secret(app, candidates.first, emit)
  rescue ArgumentError
    raise "account or group #{app} is missing; cannot establish app secret"
  end

  def existing_app_secret(candidates)
    candidates.each do |path|
      next unless File.exist?(path) || File.symlink?(path)

      validate_secret_file!(path)
      secret = secret_from_file(path)
      return secret if secret
    end
    nil
  end

  def validate_secret_file!(path)
    stat = File.lstat(path)
    raise "#{path} must be a root-owned regular file" unless
      stat.file? && !stat.symlink? && stat.uid.zero? && (stat.mode & 0o022).zero?
  end

  def secret_from_file(path)
    File.foreach(path).filter_map do |line|
      match = line.match(/\ASECRET_KEY_BASE=([0-9a-fA-F]{64,256})\s*\z/)
      match && match[1]
    end.first
  end

  def create_app_secret(app, target, emit)
    raise "#{target} is a symlink; refusing secret write" if File.symlink?(target)
    refuse_invalid_secret_target!(target) if File.exist?(target)

    secret = SecureRandom.hex(64)
    temporary = "/etc/.#{app}.env.#{Process.pid}.#{SecureRandom.hex(6)}"
    publish_app_secret(app, secret, temporary, target, emit)
  end

  def refuse_invalid_secret_target!(target)
    validate_secret_file!(target)
    raise "#{target} already exists without a valid SECRET_KEY_BASE; refusing to replace the environment file"
  end

  def publish_app_secret(app, secret, temporary, target, emit)
    File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
      file.write("SECRET_KEY_BASE=#{secret}\n")
      file.flush
      file.fsync
    end
    File.chown(0, Etc.getgrnam(app).gid, temporary)
    File.chmod(0o640, temporary)
    publish_secret_without_replace(temporary, target)
    puts secret if emit
    0
  ensure
    File.unlink(temporary) if File.exist?(temporary)
  end

  def publish_secret_without_replace(temporary, target)
    File.link(temporary, target)
  rescue Errno::EEXIST
    raise "#{target} appeared during secret creation; refusing to replace it"
  end

  # Read one app's root-owned progress record through this fixed broker verb.
  # The directory intentionally remains private (0700); vps-state runs as dev and
  # must not silently infer "no deploy" because direct filesystem access is denied.
  def read_deploy_status(app, root: STAMP_DIR, output: $stdout, verify_root: true)
    raise "unknown app: #{app}" unless APPS.include?(app)

    base = File.expand_path(root)
    directory = deploy_status_read_directory(base, verify_root)
    unless directory
      output.puts("null")
      return 0
    end

    path = File.join(directory, "#{app}.json")
    record = deploy_status_read_record(path, app, verify_root)
    output.puts(record ? JSON.generate(record) : "null")
    0
  end

  def deploy_status_read_directory(base, verify_root)
    raise "#{base} is a symlink; refusing status read" if File.symlink?(base)
    if File.exist?(base)
      root_stat = File.lstat(base)
      raise "#{base} must be a real directory" unless root_stat.directory? && !root_stat.symlink?
      raise "#{base} must be root-owned and non-writable by group/other" if
        verify_root && (!root_stat.uid.zero? || (root_stat.mode & 0o022).positive?)
    end

    directory = File.join(base, "deploy_status")
    raise "#{directory} is a symlink; refusing status read" if File.symlink?(directory)
    return unless File.exist?(directory)

    directory_stat = File.lstat(directory)
    raise "#{directory} must be a real directory" unless directory_stat.directory? && !directory_stat.symlink?
    raise "#{directory} must be root-owned and private" if
      verify_root && (!directory_stat.uid.zero? || (directory_stat.mode & 0o077).positive?)
    directory
  end

  def deploy_status_read_record(path, app, verify_root)
    raise "#{path} is a symlink; refusing status read" if File.symlink?(path)
    return unless File.exist?(path)

    status_stat = File.lstat(path)
    raise "#{path} must be a root-owned, private regular file" unless
      status_stat.file? && !status_stat.symlink? &&
      (!verify_root || status_stat.uid.zero?) && (status_stat.mode & 0o077).zero?
    record = JSON.parse(File.read(path))
    valid_deploy_status_record!(record, path, app)
    record
  end

  def valid_deploy_status_record!(record, path, app)
    valid = record.is_a?(Hash) && record["app"] == app &&
      %w[running done failed].include?(record["state"]) &&
      record["step"].is_a?(String) && record["pid"] &&
      record["started_at"].is_a?(String) && record["updated_at"].is_a?(String)
    raise "#{path} has invalid status schema" unless valid
  end

  def write_deploy_status(app, step, state)
    validate_deploy_status_input!(app, step, state)
    directory = prepare_deploy_status_directory
    target = deploy_status_target(directory, app)
    validate_deploy_status_target!(target)

    now = Time.now.utc.iso8601
    payload = {
      app: app, step: step, state: state, pid: Process.ppid,
      started_at: deploy_status_started_at(target, now), updated_at: now,
    }
    write_deploy_status_atomically(target, directory, app, payload, step, state)
  end

  def validate_deploy_status_input!(app, step, state)
    raise "unknown app: #{app}" unless APPS.include?(app)
    raise "invalid deploy status" unless %w[running done failed].include?(state)
    return if step.bytesize.between?(1, 160) && step.match?(/\A[A-Za-z0-9_ .:+(),\/-]+\z/)

    raise "invalid deploy step"
  end

  def prepare_deploy_status_directory
    if File.exist?(STAMP_DIR) || File.symlink?(STAMP_DIR)
      root_stat = File.lstat(STAMP_DIR)
      raise "#{STAMP_DIR} is a symlink; refusing status write" if root_stat.symlink?
    end
    FileUtils.mkdir_p(STAMP_DIR, mode: 0o755)
    root_stat = File.lstat(STAMP_DIR)
    raise "#{STAMP_DIR} must be root-owned" unless root_stat.directory? && root_stat.uid.zero?
    File.chmod(0o755, STAMP_DIR) unless (root_stat.mode & 0o777) == 0o755

    directory = File.join(STAMP_DIR, "deploy_status")
    raise "#{directory} is a symlink; refusing status write" if File.symlink?(directory)
    FileUtils.mkdir_p(directory, mode: 0o700)
    directory_stat = File.lstat(directory)
    raise "#{directory} must be a root-owned directory" unless
      directory_stat.directory? && directory_stat.uid.zero? && !directory_stat.symlink?
    File.chmod(0o700, directory) unless (directory_stat.mode & 0o777) == 0o700
    directory
  end

  def deploy_status_target(directory, app)
    File.join(directory, "#{app}.json")
  end

  def validate_deploy_status_target!(target)
    raise "#{target} is a symlink; refusing status write" if File.symlink?(target)
    return unless File.exist?(target)

    target_stat = File.lstat(target)
    raise "#{target} must be a root-owned regular file" unless
      target_stat.file? && target_stat.uid.zero? && !target_stat.symlink?
  end

  def deploy_status_started_at(target, fallback)
    return fallback unless File.file?(target)

    previous = JSON.parse(File.read(target))
    value = previous["started_at"]
    return fallback unless previous["state"] == "running" && value.is_a?(String)
    return fallback unless value.match?(/\A\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ\z/)

    value
  rescue JSON::ParserError, SystemCallError
    fallback
  end

  def write_deploy_status_atomically(target, directory, app, payload, step, state)
    temporary = File.join(directory, ".#{app}.#{Process.pid}.#{SecureRandom.hex(6)}")
    begin
      File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write(JSON.generate(payload) + "\n")
        file.flush
        file.fsync
      end
      File.rename(temporary, target)
      puts "deploy_status0: #{app} #{state} step=#{step}"
      0
    ensure
      File.unlink(temporary) if File.exist?(temporary)
    end
  end

  # Fleet-level recovery receipt. Unlike per-app deploy_status records, this
  # binds the run to its pinned commit, original service snapshot and port map.
  # The directory and files are root-private; callers never choose a path.
  def deploy_run_id?(value)
    value.is_a?(String) && value.match?(/\A\d{8}T\d{6}Z-[a-z0-9_-]{1,32}-\d+\z/)
  end

  def deploy_run_directory(root: STAMP_DIR, create: false, verify_root: true)
    base = File.expand_path(root)
    raise "#{base} is a symlink; refusing deploy-run access" if File.symlink?(base)
    unless File.exist?(base)
      return nil unless create
      FileUtils.mkdir_p(base, mode: 0o755)
    end
    base_stat = File.lstat(base)
    raise "#{base} must be a real directory" unless base_stat.directory? && !base_stat.symlink?
    raise "#{base} must be root-owned and not group/other writable" if
      verify_root && (!base_stat.uid.zero? || (base_stat.mode & 0o022).positive?)

    directory = File.join(base, "deploy_runs")
    raise "#{directory} is a symlink; refusing deploy-run access" if File.symlink?(directory)
    unless File.exist?(directory)
      return nil unless create
      Dir.mkdir(directory, 0o700)
      File.chown(0, -1, directory) if verify_root
    end
    stat = File.lstat(directory)
    raise "#{directory} must be a real directory" unless stat.directory? && !stat.symlink?
    raise "#{directory} must be root-owned and private" if
      verify_root && (!stat.uid.zero? || (stat.mode & 0o077).positive?)
    File.chmod(0o700, directory) unless (stat.mode & 0o777) == 0o700
    directory
  end

  def validate_deploy_run!(record, run_id)
    raise "invalid deploy-run record" unless record.is_a?(Hash)

    validate_deploy_run_identity!(record, run_id)
    validate_deploy_run_lifecycle!(record)
    validate_deploy_run_timestamps!(record)
    validate_deploy_run_shas!(record)
    validate_deploy_run_snapshot!(record)
    validate_deploy_run_logs!(record)
    validate_deploy_run_recovered_at!(record)
    record
  rescue ArgumentError
    raise "invalid deploy-run timestamp"
  end

  def validate_deploy_run_identity!(record, run_id)
    raise "invalid deploy-run schema" unless record["schema"] == 1 && record["run_id"] == run_id
    raise "invalid deploy-run target" unless record["target"].is_a?(String) && (APPS + %w[all rails]).include?(record["target"])
    raise "invalid deploy-run host" unless record["host"].is_a?(String) &&
      record["host"].bytesize.between?(1, 255) && !record["host"].match?(/[\x00-\x1f]/)
    raise "invalid deploy-run pid" unless record["pid"].is_a?(Integer) && record["pid"].positive?
    raise "invalid deploy-run owner identity" unless record["owner_identity"].is_a?(String) &&
      record["owner_identity"].match?(/\A[A-Za-z0-9_]{1,220}\z/)
  end

  def validate_deploy_run_lifecycle!(record)
    raise "invalid deploy-run status" unless %w[running ok failed recovered].include?(record["status"])
    raise "invalid deploy-run recovery state" unless %w[none pending complete].include?(record["recovery_state"])
    raise "invalid deploy-run stage" unless record["stage"].is_a?(String) &&
      record["stage"].bytesize.between?(1, 160) && record["stage"].match?(/\A[A-Za-z0-9_.:+\/-]+\z/)
    raise "invalid deploy-run snapshot marker" unless [true, false].include?(record["snapshot_recorded"])
  end

  def validate_deploy_run_timestamps!(record)
    %w[started_at updated_at].each do |field|
      value = record[field]
      raise "invalid deploy-run #{field}" unless valid_deploy_run_timestamp?(value)

      Time.iso8601(value)
    end
  end

  def valid_deploy_run_timestamp?(value)
    value.is_a?(String) && value.match?(/\A\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ\z/)
  end

  def validate_deploy_run_shas!(record)
    %w[pinned_sha previous_sha].each do |field|
      value = record[field]
      valid = value.nil? || value == "unknown" ||
        (value.is_a?(String) && value.match?(/\A[0-9a-f]{7,40}\z/i))
      raise "invalid deploy-run #{field}" unless valid
    end
  end

  def validate_deploy_run_snapshot!(record)
    services = record["started_services"]
    valid_services = services.is_a?(Array) && services.length <= SERVICES.length &&
      services.uniq == services && services.all? { |service| SERVICES.include?(service) }
    raise "invalid deploy-run service snapshot" unless valid_services

    ports = record["ports"]
    valid_ports = ports.is_a?(Hash) &&
      ports.all? { |service, port| APPS.include?(service) && port.is_a?(Integer) && (1..65_535).cover?(port) }
    raise "invalid deploy-run port map" unless valid_ports
    validate_deploy_run_restore_order!(record["restore_order"])
  end

  def validate_deploy_run_restore_order!(order)
    valid = order.is_a?(Array) && order.length <= APPS.length &&
      order.uniq == order && order.all? { |service| APPS.include?(service) }
    raise "invalid deploy-run restore order" unless valid
  end

  def validate_deploy_run_logs!(record)
    %w[run_log aggregate_log].each do |field|
      value = record[field]
      valid = value.is_a?(String) && value.bytesize.between?(1, 2048) &&
        value.match?(/\A\/[A-Za-z0-9_.\/-]+\z/)
      raise "invalid deploy-run #{field}" unless valid
    end
  end

  def validate_deploy_run_recovered_at!(record)
    return unless record.key?("recovered_at")

    value = record["recovered_at"]
    raise "invalid deploy-run recovered_at" unless valid_deploy_run_timestamp?(value)

    Time.iso8601(value)
  end

  def deploy_run_record(run_id, root: STAMP_DIR, verify_root: true)
    raise "invalid deploy-run id" unless deploy_run_id?(run_id)
    directory = deploy_run_directory(root:, create: false, verify_root:)
    return nil unless directory
    path = File.join(directory, "#{run_id}.json")
    raise "#{path} is a symlink; refusing deploy-run read" if File.symlink?(path)
    return nil unless File.exist?(path)

    stat = File.lstat(path)
    raise "#{path} must be a root-owned, private regular file" unless
      stat.file? && !stat.symlink? && (!verify_root || stat.uid.zero?) && (stat.mode & 0o077).zero?
    record = JSON.parse(File.read(path))
    validate_deploy_run!(record, run_id)
  rescue JSON::ParserError
    raise "#{path} contains malformed deploy-run JSON"
  end

  def write_deploy_run(run_id, payload_json, root: STAMP_DIR, verify_root: true, output: $stdout)
    raise "invalid deploy-run id" unless deploy_run_id?(run_id)

    payload = parse_deploy_run_payload(payload_json)
    directory = deploy_run_directory(root:, create: true, verify_root:)
    target = File.join(directory, "#{run_id}.json")
    raise "#{target} is a symlink; refusing deploy-run write" if File.symlink?(target)
    previous = deploy_run_record(run_id, root:, verify_root:)
    record = merge_deploy_run_payload(payload, previous, run_id)
    record["updated_at"] = Time.now.utc.iso8601
    validate_deploy_run!(record, run_id)
    write_deploy_run_record(directory, target, run_id, record, output)
  end

  def parse_deploy_run_payload(payload_json)
    payload = JSON.parse(payload_json)
    raise "deploy-run update must be a JSON object" unless payload.is_a?(Hash)

    allowed = %w[schema run_id target host pid owner_identity status recovery_state stage
      started_at updated_at pinned_sha previous_sha started_services ports restore_order
      run_log aggregate_log recovered_at snapshot_recorded]
    unknown = payload.keys - allowed
    raise "unknown deploy-run field(s): #{unknown.join(', ')}" unless unknown.empty?
    payload
  end

  def merge_deploy_run_payload(payload, previous, run_id)
    return validate_deploy_run_creation!(payload, run_id) unless previous

    validate_deploy_run_update!(payload, previous)
    previous.merge(payload)
  end

  def validate_deploy_run_creation!(payload, run_id)
    required = %w[schema run_id target host pid owner_identity status recovery_state stage started_at
      started_services ports restore_order run_log aggregate_log snapshot_recorded]
    missing = required - payload.keys
    raise "deploy-run creation missing field(s): #{missing.join(', ')}" unless missing.empty?
    payload
  end

  def validate_deploy_run_update!(payload, previous)
    terminal = %w[ok recovered].include?(previous["status"]) ||
      (previous["status"] == "failed" && previous["recovery_state"] != "pending")
    raise "terminal deploy-run receipt cannot be changed" if terminal

    validate_deploy_run_immutable_fields!(payload, previous)
    validate_deploy_run_pinned_fields!(payload, previous)
    validate_deploy_run_snapshot_fields!(payload, previous)
  end

  def validate_deploy_run_immutable_fields!(payload, previous)
    fields = %w[schema run_id target host pid owner_identity started_at run_log aggregate_log]
    fields.each do |field|
      next unless payload.key?(field)

      raise "deploy-run identity field #{field} cannot change" unless payload[field] == previous[field]
    end
  end

  def validate_deploy_run_pinned_fields!(payload, previous)
    %w[pinned_sha previous_sha].each do |field|
      next if previous[field].nil?
      next unless payload.key?(field)

      raise "deploy-run pinned field #{field} cannot change" if payload[field] != previous[field]
    end
  end

  def validate_deploy_run_snapshot_fields!(payload, previous)
    return unless previous["snapshot_recorded"]

    %w[started_services ports restore_order].each do |field|
      raise "deploy-run snapshot field #{field} cannot change" if payload.key?(field) && payload[field] != previous[field]
    end
    raise "deploy-run snapshot marker cannot be cleared" if payload["snapshot_recorded"] == false
  end

  def write_deploy_run_record(directory, target, run_id, record, output)
    temporary = File.join(directory, ".#{run_id}.#{Process.pid}.#{SecureRandom.hex(6)}")
    begin
      File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write(JSON.generate(record) + "\n")
        file.flush
        file.fsync
      end
      File.rename(temporary, target)
      File.open(directory) { |dir| dir.fsync }
      output.puts("deploy_run0: #{run_id} status=#{record.fetch('status')} recovery=#{record.fetch('recovery_state')} stage=#{record.fetch('stage')}")
      0
    ensure
      File.unlink(temporary) if File.exist?(temporary)
    end
  end

  def read_deploy_run(run_id, root: STAMP_DIR, verify_root: true, output: $stdout)
    record = deploy_run_record(run_id, root:, verify_root:)
    output.puts(record ? JSON.generate(record) : "null")
    0
  end

  def list_deploy_runs(root: STAMP_DIR, verify_root: true, output: $stdout)
    directory = deploy_run_directory(root:, create: false, verify_root:)
    records = if directory
                Dir.children(directory).grep(/\A\d{8}T\d{6}Z-[a-z0-9_-]{1,32}-\d+\.json\z/).map do |name|
                  deploy_run_record(name.delete_suffix(".json"), root:, verify_root:)
                end.compact
              else
                []
              end
    output.puts(JSON.generate(records.sort_by { |record| record.fetch("started_at") }.reverse))
    0
  end

  # Retain the lexicographically newest filenames in a min-heap. The heap's
  # root is the oldest retained name, so its size never exceeds the requested
  # window even when the receipt directory contains a long history.
  def retain_newest_deploy_run_name(names, name, limit)
    if names.length < limit
      names << name
      sift_deploy_run_heap_up(names, names.length - 1)
      return
    end
    return if name <= names[0]

    names[0] = name
    sift_deploy_run_heap_down(names, 0)
  end

  def sift_deploy_run_heap_up(names, index)
    while index.positive?
      parent = (index - 1) / 2
      break if names[parent] <= names[index]

      names[parent], names[index] = names[index], names[parent]
      index = parent
    end
  end

  def sift_deploy_run_heap_down(names, index)
    loop do
      left = index * 2 + 1
      break if left >= names.length

      right = left + 1
      child = right < names.length && names[right] < names[left] ? right : left
      break if names[index] <= names[child]

      names[index], names[child] = names[child], names[index]
      index = child
    end
  end

  # Monitoring does not need terminal receipt contents. Enumerate directory
  # entries once, retain only the newest max_scan filenames in a fixed-size
  # heap, read at most max_scan receipt files, and return at most max_pending
  # pending runs. Enumeration remains linear in directory size; retained memory
  # and the final sort are bounded by max_scan. The full list remains diagnostic.
  def list_pending_deploy_runs(root: STAMP_DIR, verify_root: true, output: $stdout,
                               max_scan: DEPLOY_RUN_SCAN_LIMIT, max_pending: DEPLOY_RUN_PENDING_LIMIT)
    validate_pending_deploy_run_limits!(max_scan, max_pending)
    directory = deploy_run_directory(root:, create: false, verify_root:)
    names, scanned = pending_deploy_run_names(directory, max_scan)
    records = pending_deploy_run_records(names, root, verify_root, max_pending)
    truncated = scanned > max_scan || records.length > max_pending
    output_pending_deploy_runs(output, records.first(max_pending), truncated, scanned)
  end

  def validate_pending_deploy_run_limits!(max_scan, max_pending)
    raise "invalid deploy-run scan limit" unless max_scan.is_a?(Integer) && max_scan.positive?
    raise "invalid deploy-run pending limit" unless max_pending.is_a?(Integer) && max_pending.positive?
  end

  def pending_deploy_run_names(directory, max_scan)
    names = []
    scanned = 0
    if directory
      Dir.each_child(directory) do |name|
        next unless name.match?(/\A\d{8}T\d{6}Z-[a-z0-9_-]{1,32}-\d+\.json\z/)

        scanned += 1
        retain_newest_deploy_run_name(names, name, max_scan)
      end
    end
    [names.sort!.reverse!, scanned]
  end

  def pending_deploy_run_records(names, root, verify_root, max_pending)
    names.map do |name|
      deploy_run_record(name.delete_suffix(".json"), root:, verify_root:)
    end.compact.select do |record|
      record["recovery_state"] == "pending" && %w[running failed].include?(record["status"])
    end.first(max_pending + 1)
  end

  def output_pending_deploy_runs(output, records, truncated, scanned)
    output.puts(JSON.generate(
      pending: records,
      truncated: truncated,
      scanned: scanned,
      returned: records.length,
    ))
    0
  end

  def valid_ruby_cache_key?(value)
    value.match?(/\Aruby(?:[0-9]{2}|[0-9]+\.[0-9]+)\z/)
  end

  # Validate existing parents without changing their modes; only the fixed cache
  # leaf requested by bundle_cache receives the leaf mode below.
  def ensure_root_parent_chain(path)
    return if path == "/"

    parent = File.dirname(path)
    ensure_root_parent_chain(parent)
    unless File.exist?(path) || File.symlink?(path)
      Dir.mkdir(path, 0o755)
      File.chown(0, Etc.getgrnam("wheel").gid, path)
      File.chmod(0o755, path)
    end
    stat = File.lstat(path)
    raise "#{path} must be a real root-owned, non-writable directory" unless
      stat.directory? && !stat.symlink? && stat.uid.zero? && (stat.mode & 0o022).zero?
  end

  def ensure_root_directory(path, mode: 0o755)
    ensure_root_parent_chain(File.dirname(path))
    unless File.exist?(path) || File.symlink?(path)
      Dir.mkdir(path, mode)
      File.chown(0, Etc.getgrnam("wheel").gid, path)
      File.chmod(mode, path)
    end
    stat = File.lstat(path)
    raise "#{path} must be a real root-owned, non-writable directory" unless
      stat.directory? && !stat.symlink? && stat.uid.zero? && (stat.mode & 0o022).zero?
    File.chmod(mode, path) unless (stat.mode & 0o777) == mode
    path
  end
  def validate_cache_source!(path, uid: 0)
    stat = File.lstat(path)
    raise "#{path} must be a regular non-symlink file owned by uid #{uid}" unless
      stat.file? && !stat.symlink? && stat.uid == uid && stat.size.between?(1, 128 * 1024 * 1024)
    stat
  end

  def bundle_cache_store_file(source, root, owner_uid: 0)
    validate_cache_source!(source, uid: owner_uid)
    digest = Digest::SHA256.file(source).hexdigest
    directory = File.join(root, digest[0, 2], digest[2, 2])
    ensure_root_directory(directory)
    target = File.join(directory, "#{digest}.gem")
    return validate_existing_bundle_cache_entry!(target, digest) if File.exist?(target) || File.symlink?(target)

    temporary = File.join(directory, ".#{digest}.#{Process.pid}.#{SecureRandom.hex(5)}")
    begin
      write_bundle_cache_temporary(source, temporary, digest)
      publish_bundle_cache_temporary(temporary, target, digest)
    ensure
      File.unlink(temporary) if File.exist?(temporary)
    end
    0
  end

  def validate_existing_bundle_cache_entry!(target, digest)
    stat = validate_cache_source!(target, uid: 0)
    validate_bundle_cache_digest!(target, digest, "entry has wrong digest")
    raise "bundle cache entry is writable: #{target}" unless (stat.mode & 0o222).zero?

    0
  end

  def write_bundle_cache_temporary(source, temporary, digest)
    File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
      File.open(source, "rb") { |input| IO.copy_stream(input, file) }
      file.flush
      file.fsync
    end
    validate_bundle_cache_digest!(temporary, digest, "source changed while copying")
  end

  def publish_bundle_cache_temporary(temporary, target, digest)
    File.chown(0, Etc.getgrnam("wheel").gid, temporary)
    File.chmod(0o444, temporary)
    begin
      File.link(temporary, target)
    rescue Errno::EEXIST
      validate_bundle_cache_collision!(target, digest)
    end
  end

  def validate_bundle_cache_collision!(target, digest)
    stat = validate_cache_source!(target, uid: 0)
    validate_bundle_cache_digest!(target, digest, "collision has wrong digest")
    raise "bundle cache collision is writable: #{target}" unless (stat.mode & 0o222).zero?
  end

  def validate_bundle_cache_digest!(path, digest, label)
    return if Digest::SHA256.file(path).hexdigest == digest

    raise "bundle cache #{label}: #{path}"
  end

  # This verb knows no caller-provided filesystem paths. It only imports from the
  # fixed system cache or the selected app's fixed Bundler cache.
  def bundle_cache(app, action, ruby_key)
    return 64 unless RAILS_APPS.include?(app) && valid_ruby_cache_key?(ruby_key)
    return 64 unless %w[prepare import capture].include?(action)

    shared = File.join(BUNDLE_CACHE_BASE, ruby_key)
    cas = File.join(shared, "cas", "sha256")
    ensure_root_directory(shared)
    ensure_root_directory(cas)
    return prepare_bundle_cache(shared, cas) if action == "prepare"

    source_dir, source_uid = bundle_cache_source(app, action, shared)
    store_bundle_cache_files(app, action, ruby_key, source_dir, cas, source_uid)
  rescue ArgumentError
    raise "unknown app or group; cannot prepare bundle cache"
  end

  def prepare_bundle_cache(shared, cas)
    ensure_root_directory(File.join(shared, "cache"))
    ensure_root_directory(cas)
    0
  end

  def bundle_cache_source(app, action, shared)
    if action == "import"
      source_dir = File.join(shared, "cache")
      ensure_root_directory(source_dir)
      return [source_dir, 0]
    end

    account = Etc.getpwnam(app)
    home = "/home/#{app}"
    bundle_dir = File.join(home, ".bundle")
    source_dir = File.join(bundle_dir, "cache")
    paths = [["/home", 0], [home, account.uid], [File.join(home, "app"), account.uid],
             [bundle_dir, account.uid], [source_dir, account.uid]]
    validate_bundle_cache_directories!(paths)
    [source_dir, account.uid]
  end

  def validate_bundle_cache_directories!(paths)
    paths.each do |directory, expected_uid|
      stat = File.lstat(directory)
      raise "#{directory} must be a real, correctly owned directory" unless
        stat.directory? && !stat.symlink? && stat.uid == expected_uid && (stat.mode & 0o022).zero?
    end
  end

  def store_bundle_cache_files(app, action, ruby_key, source_dir, cas, source_uid)
    files = Dir.glob(File.join(source_dir, "*.gem"))
    raise "bundle cache import exceeds 500 files" if files.length > 500
    files.sort.each do |source|
      next if File.symlink?(source)

      bundle_cache_store_file(source, cas, owner_uid: source_uid)
    end
    puts "bundle_cache0: #{app} #{action} #{ruby_key} files=#{files.length}"
    0
  end

  # These tasks touch only the fixed master_web tree; neither accepts a path from argv.
  def master_web_root!
    dev = Etc.getpwnam("dev")
    paths = [File::SEPARATOR]
    current = File::SEPARATOR
    MASTER_WEB_ROOT.split(File::SEPARATOR).reject(&:empty?).each do |part|
      current = File.join(current, part)
      paths << current
    end
    paths << File.join(MASTER_WEB_ROOT, "public")
    paths.each do |path|
      expected_uid = [File::SEPARATOR, "/home"].include?(path) ? 0 : dev.uid
      stat = File.lstat(path)
      raise "#{path} must be a real, correctly owned directory" unless
        stat.directory? && !stat.symlink? && stat.uid == expected_uid && (stat.mode & 0o022).zero?
    end
    [dev, File.join(MASTER_WEB_ROOT, "public")]
  rescue ArgumentError
    raise "dev account is missing; cannot prepare MASTER web paths"
  end
  def master_web_tree_paths!(root)
    paths = []
    Find.find(root) do |path|
      stat = File.lstat(path)
      raise "symlink refused in MASTER web path: #{path}" if stat.symlink?
      raise "non-file object refused in MASTER web path: #{path}" unless stat.directory? || stat.file?
      paths << [path, stat]
    end
    paths
  end

  def master_web_assets_reset
    dev, public_dir = master_web_root!
    assets = File.join(public_dir, "assets")
    if File.exist?(assets) || File.symlink?(assets)
      stat = File.lstat(assets)
      raise "#{assets} must be a real directory" unless stat.directory? && !stat.symlink?
      master_web_tree_paths!(assets)
      FileUtils.rm_rf(assets)
    end
    master_web_tree_paths!(public_dir).each do |path, _stat|
      File.chown(dev.uid, dev.gid, path)
    end
    puts "master_web0: public assets reset; public tree owned by dev"
    0
  end

  def master_web_runtime_dirs
    dev, public_dir = master_web_root!
    root = File.dirname(public_dir)
    master = Etc.getgrnam("master")
    %w[tmp log].each { |name| prepare_master_web_runtime_dir(root, name, dev, master) }
    puts "master_web0: tmp/log owned by dev:master with group write"
    0
  rescue ArgumentError
    raise "master account or group is missing; cannot prepare runtime directories"
  end

  def prepare_master_web_runtime_dir(root, name, dev, master)
    path = File.join(root, name)
    if File.exist?(path) || File.symlink?(path)
      stat = File.lstat(path)
      raise "#{path} must be a real directory" unless stat.directory? && !stat.symlink?
    else
      Dir.mkdir(path, 0o2775)
    end
    master_web_tree_paths!(path).each do |entry, stat|
      prepare_master_web_runtime_entry(entry, stat, dev, master)
    end
  end

  def prepare_master_web_runtime_entry(path, stat, dev, master)
    File.chown(dev.uid, master.gid, path)
    mode = stat.mode & 0o7777
    mode = stat.directory? ? 0o2775 : runtime_file_mode(mode, stat)
    File.chmod(mode, path)
  end

  def runtime_file_mode(mode, stat)
    mode |= 0o660
    mode |= 0o110 if (stat.mode & 0o111).positive?
    mode
  end

  def valid_ci_timeout?(value)
    value.match?(/\A[0-9]{1,4}\z/) && (1..7200).cover?(value.to_i)
  end

# Starts the helper in its own process group. With an account it drops to that UID, GID and
# only the listed groups in the child before exec: the box runs Ruby 3.4, whose spawn takes
# no groups: option. The order is groups, gid, uid, and it cannot be undone.
def spawn_helper(environment:, helper:, arguments:, account: nil, groups: nil)
  unless account
    return Process.spawn(environment, "/bin/ksh", helper, *arguments, pgroup: true, unsetenv_others: true)
  end

  fork do
    Process.setpgid(0, 0)

    Process.groups = groups
    Process::GID.change_privilege(account.gid)
    Process::UID.change_privilege(account.uid)

    exec(environment, "/bin/ksh", helper, *arguments, unsetenv_others: true)
  rescue StandardError => error
    warn "pub5-admin: cannot start #{File.basename(helper)} as #{account.name}: #{error.class}"
  ensure
    exit!(126)
  end
end

  # Supervise a single fixed helper with a bounded app name and wall-clock deadline.
  # CI execution starts as root only long enough to drop to the app via su; tree sync
  # is spawned directly with that app UID/GID and only the groups it needs.
  def supervised_helper(helper, app, duration, helper_arguments = nil)
    validate_supervised_helper!(helper, app, duration)
    arguments = supervised_helper_arguments(helper, app, duration, helper_arguments)
    trusted_script!(helper)
    secret = supervised_helper_secret(helper, app, arguments)
    environment = supervised_helper_environment(helper, app)
    environment["SECRET_KEY_BASE"] = secret if secret
    account, groups = supervised_helper_account(helper, app)
    pid = spawn_helper(environment:, helper:, arguments:, account:, groups:)
    wait_for_helper(pid, helper, duration)
  end

  def validate_supervised_helper!(helper, app, duration)
    raise "unknown helper" unless [CI_RUN, CI_SYNC, RAILS_TASK, RAILS_SYNC].include?(helper)
    known_apps = helper == RAILS_TASK ? RAILS_TASK_APPS : RAILS_APPS
    raise "unknown app" unless known_apps.include?(app)
    raise "invalid helper timeout" unless duration.is_a?(Integer) && (1..7200).cover?(duration)
  end

  def supervised_helper_arguments(helper, app, duration, extra)
    case helper
    when CI_RUN then [app, duration.to_s]
    when CI_SYNC then [app]
    when RAILS_TASK then Array(extra)
    when RAILS_SYNC then [app, *Array(extra)]
    end
  end

  def supervised_helper_secret(helper, app, arguments)
    return unless helper == RAILS_TASK
    return unless %w[db-prepare db-seed demo-seed assets-precompile schema-load ci].include?(arguments[1])

    app_secret_value(app)
  rescue RuntimeError => error
    raise unless error.message == "no valid SECRET_KEY_BASE for #{app}"

    ensure_app_secret(app, emit: false)
    app_secret_value(app)
  end

  def supervised_helper_environment(helper, app)
    sync = [CI_SYNC, RAILS_SYNC].include?(helper)
    home = sync ? "/home/#{app}" : "/root"
    environment = { "PATH" => "/usr/local/bin:/usr/bin:/bin", "HOME" => home }
    return environment unless sync

    environment.merge(
      "GIT_CONFIG_NOSYSTEM" => "1",
      "GIT_CONFIG_GLOBAL" => "/dev/null",
    )
  end

  def supervised_helper_account(helper, app)
    return [nil, nil] unless [CI_SYNC, RAILS_SYNC].include?(helper)

    account = Etc.getpwnam(app)
    groups = [account.gid, Etc.getgrnam("_pub5ci").gid].uniq
    [account, groups]
  end

  def wait_for_helper(pid, helper, duration)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + duration
    loop do
      return helper_exit_status(pid) if Process.waitpid(pid, Process::WNOHANG)
      return stop_helper_group(pid, helper, duration) if monotonic_now >= deadline

      sleep 0.25
    end
  end

  def helper_exit_status(pid)
    status = $?
    return status.exitstatus if status&.exited?
    return 128 + status.termsig if status&.signaled?

    1
  end

  def stop_helper_group(pid, helper, duration)
    warn "pub5-admin: helper #{File.basename(helper)} timed out after #{duration}s; stopping process group #{pid}"
    signal_helper_group("TERM", pid)
    grace_deadline = monotonic_now + 5
    leader_reaped = false
    while helper_group_alive?(pid)
      leader_reaped ||= reap_helper(pid)
      break if monotonic_now >= grace_deadline && signal_helper_group("KILL", pid)

      sleep 0.1
    end
    unless leader_reaped
      leader_reaped = reap_helper(pid)
      finish_reap_helper(pid) unless leader_reaped
    end
    124
  end

  def finish_reap_helper(pid)
    Process.waitpid(pid)
  rescue Errno::ECHILD
    nil
  end

  def signal_helper_group(signal, pid)
    Process.kill(signal, -pid)
    true
  rescue Errno::ESRCH
    false
  end

  def helper_group_alive?(pid)
    Process.kill(0, -pid)
    true
  rescue Errno::ESRCH
    false
  end

  def reap_helper(pid)
    !Process.waitpid(pid, Process::WNOHANG).nil?
  rescue Errno::ECHILD
    true
  end

  def monotonic_now
    Process.clock_gettime(Process::CLOCK_MONOTONIC)
  end

  def run_ci(app, duration)
    return 64 unless valid_ci_timeout?(duration.to_s)

    supervised_helper(CI_RUN, app, duration)
  end

  def run_ci_sync(app)
    supervised_helper(CI_SYNC, app, 900)
  end

  def run_rails_sync(app, mode)
    return 64 unless RAILS_APPS.include?(app)
    return 64 unless %w[app shared verticals].include?(mode)
    return 64 if mode == "verticals" && app != "brgen"

    supervised_helper(RAILS_SYNC, app, 900, [mode])
  end

  def run_rails_task(app, task, database = nil)
    return 64 unless RAILS_TASK_APPS.include?(app)
    allowed = %w[bundle-install bundle-check ci-bundle-install db-storage-migrate db-prepare db-seed demo-seed assets-precompile ci npm-cache bundle-cache-prepare bundle-cas-hydrate overlay-initializers overlay-public]
    if %w[schema-load secondary-db-check].include?(task)
      return 64 unless %w[cache queue cable].include?(database)
    elsif task == "bundle-cas-hydrate"
      return 64 unless RAILS_APPS.include?(app) && valid_ruby_cache_key?(database.to_s)
    else
      return 64 unless allowed.include?(task) && database.nil?
    end
    return 64 if task == "demo-seed" && !%w[brgen amber].include?(app)

    arguments = [app, task]
    arguments << database if %w[schema-load secondary-db-check bundle-cas-hydrate].include?(task)
    supervised_helper(RAILS_TASK, app, 7200, arguments)
  end

  def call_rcctl(action, service)
    raise "untrusted rcctl executable" unless trusted_executable?(RCCTL)
    output = IO.popen([RCCTL, action, service], err: [:child, :out], &:read)
    status = $?
    [status&.success? || false, output.to_s]
  end

  # This is the only operation allowed to pin every production service against
  # resource_guard shedding. The service set and flag path are both constants.
  def start_all_apps
    flag = "/var/db/pub5_all_apps"
    ensure_all_apps_flag!(flag)
    services = ["master", *RAILS_APPS]
    start_production_services!(services)
    puts "start_all_apps0: services=#{services.join(',')} flag=#{flag}"
    0
  end

  def ensure_all_apps_flag!(flag)
    db_stat = File.lstat("/var/db")
    valid_db = db_stat.directory? && !db_stat.symlink? && db_stat.uid.zero? && (db_stat.mode & 0o022).zero?
    raise "/var/db must be a real root-owned, non-writable directory" unless valid_db

    ensure_all_apps_flag_file!(flag)
    flag_stat = File.lstat(flag)
    validate_all_apps_flag!(flag, flag_stat, "must remain root-owned and non-writable")
    File.chmod(0o644, flag) unless (flag_stat.mode & 0o777) == 0o644
  end

  def ensure_all_apps_flag_file!(flag)
    return validate_all_apps_flag!(flag, File.lstat(flag), "must be a root-owned regular file") if
      File.exist?(flag) || File.symlink?(flag)

    File.open(flag, File::WRONLY | File::CREAT | File::EXCL, 0o644) {}
  rescue Errno::EEXIST
    validate_all_apps_flag!(flag, File.lstat(flag), "appeared as an unsafe object")
  end

  def validate_all_apps_flag!(flag, stat, message)
    valid = stat.file? && !stat.symlink? && stat.uid.zero? && (stat.mode & 0o022).zero?
    raise "#{flag} #{message}" unless valid
  end

  def start_production_services!(services)
    services.each do |service|
      call_rcctl("enable", service)
      call_rcctl("start", service)
    end
    sleep 5
    ok, output = call_rcctl("restart", "relayd")
    raise "relayd restart failed: #{output.strip}" unless ok
    verify_production_services!(services)
  end

  def verify_production_services!(services)
    failures = services.filter_map do |service|
      ok, output = call_rcctl("check", service)
      "#{service}: #{output.strip}" unless ok
    end
    raise "service checks failed: #{failures.join('; ')}" unless failures.empty?
  end

  def dispatch_setup_command(args)
    return ensure_app_secret(args[1]) if args.length == 2 && args[0] == "ensure-secret" && APPS.include?(args[1])
    return ensure_app_layout(args[1]) if args.length == 2 && args[0] == "ensure-app" && RAILS_APPS.include?(args[1])
    return relayd_check(*args.drop(1)) if args.length == 4 && args[0] == "relayd-check"
    return retire_legacy_service(args[1]) if args.length == 2 && args[0] == "retire-legacy"

    nil
  end

  def retire_legacy_service(name)
    service = legacy_service_name(name)
    raise "unknown legacy service target" unless service

    path = "/etc/rc.d/#{service}"
    return 0 unless File.exist?(path) || File.symlink?(path)

    stat = File.lstat(path)
    raise "#{path} must be a root-owned, non-writable regular file" unless
      stat.file? && !stat.symlink? && stat.uid.zero? && (stat.mode & 0o022).zero?

    exec(RCCTL, "disable", service)
  end

  def dispatch_deploy_command(args)
    return master_web_assets_reset if args == ["master-web-assets-reset"]
    return master_web_runtime_dirs if args == ["master-web-runtime-dirs"]
    return start_all_apps if args == ["start-all-apps"]
    return write_deploy_status(*args.drop(1)) if args.length == 4 && args[0] == "deploy-status"
    return read_deploy_status(args[1]) if args.length == 2 && args[0] == "deploy-status-read"
    return write_stamp(*args.drop(1)) if args.length == 4 && args[0] == "stamp"

    dispatch_deploy_run_command(args)
  end

  def dispatch_deploy_run_command(args)
    return write_deploy_run(args[1], args[2]) if args.length == 3 && args[0] == "deploy-run-write"
    return read_deploy_run(args[1]) if args.length == 2 && args[0] == "deploy-run-read"
    return list_deploy_runs if args == ["deploy-run-list"]
    return list_pending_deploy_runs if args == ["deploy-run-pending-list"]

    nil
  end

  def dispatch_ci_command(args)
    return ensure_ci_lock if args == ["ci-lock"]
    return bundle_cache(*args.drop(1)) if args.length == 4 && args[0] == "bundle-cache"
    return run_ci(args[1], args[2].to_i) if args.length == 3 && args[0] == "ci-run" &&
      RAILS_APPS.include?(args[1]) && valid_ci_timeout?(args[2])
    return run_ci_sync(args[1]) if args.length == 2 && args[0] == "ci-sync" && RAILS_APPS.include?(args[1])
    return run_rails_sync(args[1], args[2]) if args.length == 3 && args[0] == "rails-sync" && RAILS_APPS.include?(args[1])
    return run_rails_task(args[1], args[2]) if args.length == 3 && args[0] == "rails-task" && RAILS_TASK_APPS.include?(args[1])
    return run_rails_task(args[1], args[2], args[3]) if args.length == 4 && args[0] == "rails-task" && RAILS_TASK_APPS.include?(args[1])

    dispatch_fixed_script_command(args)
  end

  def dispatch_fixed_script_command(args)
    if args.length == 2 && args[0] == "ci-prepare" && RAILS_APPS.include?(args[1])
      trusted_script!(CI_PREPARE)
      exec("/bin/ksh", CI_PREPARE, args[1])
    end
    if args == ["resource-guard"]
      trusted_script!(RESOURCE_GUARD)
      exec("/bin/ksh", RESOURCE_GUARD)
    end
    if args.length == 2 && args[0] == "solid-queue-proof" && APPS.include?(args[1])
      trusted_script!(SOLID_QUEUE_PROOF)
      exec(ruby_path, SOLID_QUEUE_PROOF, args[1])
    end
    nil
  end

  def dispatch_service_command(args)
    return nil unless args == %w[service list-started]

    output = IO.popen([RCCTL, "ls", "started"], &:read)
    status = $?
    raise "rcctl ls started failed (#{status&.exitstatus || "no status"})" unless status&.success?

    puts filter_started_services(output)
    0
  end

  def dispatch_admin_command(args)
    dispatch_setup_command(args) ||
      dispatch_deploy_command(args) ||
      dispatch_ci_command(args) ||
      dispatch_service_command(args) ||
      execute_admin_command(args)
  end

  def execute_admin_command(args)
    command = command_for(args)
    raise "refused arguments: #{args.inspect}" unless command

    exec(*command)
  end

  def main(argv)
    raise "must run as root through doas" unless Process.euid.zero?

    dispatch_admin_command(Array(argv).map(&:to_s))
  rescue StandardError => e
    warn "pub5-admin: refused or failed: #{e.class}: #{e.message}"
    126
  end

end

exit(Pub5Admin.main(ARGV)) if $PROGRAM_NAME == __FILE__
