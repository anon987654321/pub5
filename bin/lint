#!/usr/bin/env ruby
# frozen_string_literal: true

# Developer shorthand for `bin/master lint`: every tracked Ruby, YAML, JSON
# and ERB file parses and no enforced Law has a finding. It refuses to run
# blind: a lint that read no files reports NOT_RUN and fails.
exec(RbConfig.ruby, File.expand_path("master", __dir__), "lint", *ARGV)
