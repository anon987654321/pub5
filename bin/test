#!/usr/bin/env ruby
# frozen_string_literal: true
require "rbconfig"

root = File.expand_path("..", __dir__)
roots = %w[core laws test]
files = roots.flat_map { |dir| Dir.glob(File.join(root, dir, "**", "test_*.rb")) + Dir.glob(File.join(root, dir, "test_*.rb")) }.uniq.sort
abort "test: no suites found; refusing to report a blind pass" if files.empty?
ENV["RUBYOPT"] = "-W2"
exec(RbConfig.ruby, *files.map { |path| File.expand_path(path) })
