#!/usr/bin/env ruby
# frozen_string_literal: true
require_relative "../lib/deploy_gate"
root = File.expand_path("../..", __dir__)
gate = OpenBSD::DeployGate.new(root: root)
command = ARGV.shift || "plan"
case command
when "plan"
  gate.plan.each { |key, value| puts "#{key}=#{value.is_a?(Array) ? value.join(",") : value}" }
  exit 3
when "verify-artifact"
  path = ARGV.shift or abort "usage: deploy verify-artifact PATH SHA256"
  sha = ARGV.shift or abort "usage: deploy verify-artifact PATH SHA256"
  puts gate.verify_artifact(path, expected_sha256: sha)
when "ship"
  abort "DEPLOYMENT BLOCKED: M0 live restore and host evidence are not proved; no network action was attempted"
else
  abort "usage: deploy [plan | verify-artifact PATH SHA256 | ship]"
end
