.DS_Store
/log/
*.log
*.pid
*.sqlite3*
/out/
/snapshots/
.bundle/

# Session runtime state; .master/ at the root and under master/ alike.
.master/
master/.constitutional_locks/
master/runtime/
master/output/

# Run output: rails app tmp/ and coverage, and the generated asset and
# upload trees that a deploy or a test boot recreates everywhere.
tmp/
coverage/
rails/*/app/assets/builds/
rails/*/public/assets/
rails/*/storage/*
!rails/*/storage/.keep


# Private real-person LoRA material. Keep source photos, captions, datasets,
# generated outputs, weights and temporary bundles out of this public repo.
/studio/replicate/lora/*/sources/
studio/replicate/lora/*/dataset/
studio/replicate/lora/*/weights/
studio/replicate/lora/*/out/
studio/replicate/lora/*/retouched/
studio/replicate/lora/**/.cache/
studio/replicate/lora/**/*.zip
studio/replicate/lora/**/*.pid
studio/replicate/lora/*.mp4
studio/replicate/lora/*.mov

studio/replicate/lora/*/contact_sheet.jpg
