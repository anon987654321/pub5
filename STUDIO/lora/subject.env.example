# Copy to STUDIO/lora/<subject>/subject.env and keep it local.
# subject.env is ignored by Git because it contains private subject configuration.
MODEL=subject
REPLICATE_DESTINATION=owner/private-model
REPLICATE_MODEL=
TRIGGER=SUBJECT_TRIGGER
DESCRIPTOR=Private descriptor approved from the subject's own reference photographs

# Human gate for selfie generation. After comparing full-size samples with
# approved subject references, set this to the exact immutable model version.
# Leave blank until likeness is explicitly approved.
LIKELINESS_REVIEWED_VERSION=
