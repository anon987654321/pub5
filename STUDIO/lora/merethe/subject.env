# What differs between one LoRA subject and the next. Everything else lives in
# the shared toolkit and is read by the renderer and the judge.
SUBJECT=merethe
MODEL=merethe
REPLICATE_MODEL=anon987654321/merethe-flux
TRIGGER=MERETHE

# What anchors age and appearance when the trigger alone is not enough. The
# trigger carries the face; without this the model reaches for its own average
# of the word. Structure rather than praise: bone structure and colouring are
# things the model can actually place, where "beautiful" pulls CLIP toward the
# stock-model average it saw most often and fights the likeness.
DESCRIPTOR="Norwegian woman, long wavy ash-blonde hair, blue eyes, warm open expression"
