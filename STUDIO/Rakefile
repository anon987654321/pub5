# frozen_string_literal: true

# STUDIO's rake surface: `rake check` proves the tree loads and the contracts
# answer, `rake test` runs the full studio suite. Keep both quiet and fast.
require "rbconfig"
require "open3"

STUDIO_ROOT = __dir__
RUBY = RbConfig.ruby

desc "Load every STUDIO entrypoint and prove the contracts answer"
task :check do
  require_relative "output_paths"
  raise "output_paths: render_directory is not absolute" unless Studio::OutputPaths.render_directory.start_with?(File::SEPARATOR)
  raise "output_paths: reference_root collides with the checkout" if Studio::OutputPaths.inside_repository?(Studio::OutputPaths.reference_root)

  rg69_files = %w[rg69.html rg69.css rg69.js].map { |name| File.join(STUDIO_ROOT, name) }
  missing_rg69 = rg69_files.reject { |path| File.file?(path) }
  raise "RG-69 assets missing: #{missing_rg69.map { |path| File.basename(path) }.join(', ')}" unless missing_rg69.empty?
  rg69_html = File.read(rg69_files.fetch(0))
  raise "RG-69 retains an inline style or script block" if rg69_html.match?(/<style\b|<script(?![^>]*\bsrc=)/i)
  raise "RG-69 references a missing local stylesheet" unless rg69_html.include?('href="rg69.css"')
  raise "RG-69 references a missing local application script" unless rg69_html.include?('src="rg69.js"')
  raise "RG-69 Tone.js dependency is not version-pinned" unless rg69_html.include?("tone/14.8.49/Tone.min.js")
  raise "RG-69 has no keyboard focus indicator" unless File.read(rg69_files.fetch(1)).include?(":focus-visible")

  dilla = File.join(STUDIO_ROOT, "dilla", "dilla.rb")
  raise "dilla/dilla.rb is missing" unless File.file?(dilla)

  out, status = Open3.capture2e(RUBY, dilla, "--list", chdir: STUDIO_ROOT)
  raise "dilla --list failed:\n#{out}" unless status.success?

  studio_cli = File.join(STUDIO_ROOT, "bin", "studio")
  cli_out, cli_status = Open3.capture2e(RUBY, studio_cli, "--list", chdir: STUDIO_ROOT)
  raise "studio --list failed:\n#{cli_out}" unless cli_status.success?
  raise "studio --list does not expose Ableton recovery" unless cli_out.include?("ableton")

  python_sources = Dir.glob(File.join(STUDIO_ROOT, "**", "*.py"))
  raise "Python source files remain in STUDIO: #{python_sources.map { |path| path.delete_prefix("#{STUDIO_ROOT}/") }.join(", ")}" unless python_sources.empty?

  reference_source = File.read(dilla)
  if reference_source.include?('which("python3")') || reference_source.include?("find_demucs") || reference_source.include?("separate_stems")
    raise "Dilla reference pipeline retains a Python/Demucs runtime call"
  end

  %w[
    bin/studio photograph.rb photograph/idea_picture.rb replicate/client.rb subprocess.rb test_runner.rb
    dilla/lib/als.rb dilla/lib/als_export.rb dilla/lib/als_to_midi.rb dilla/lib/reference_analyzer.rb
  ].each do |entry|
    path = File.join(STUDIO_ROOT, entry)
    raise "#{entry} is missing" unless File.file?(path)

    out, status = Open3.capture2e(RUBY, "-c", path)
    raise "#{entry} does not parse:\n#{out}" unless status.success?
  end
  puts "check0: studio contracts answer"
end

desc "Run the STUDIO test suite with bounded, non-empty Minitest proof"
task :test do
  require_relative "subprocess"
  require_relative "test_runner"

  tests = Dir[File.join(STUDIO_ROOT, "test", "*_test.rb")].sort
  abort "no studio tests found" if tests.empty?

  timeout_s = Integer(ENV.fetch("STUDIO_TEST_TIMEOUT_S", "300"))
  abort "STUDIO_TEST_TIMEOUT_S must be positive" unless timeout_s.positive?

  failed = []
  tests.each do |path|
    name = path.delete_prefix("#{STUDIO_ROOT}/")
    puts "studio-test0: #{name} starting (timeout #{timeout_s}s)"
    result = nil
    output = error_output = ""

    begin
      output, error_output, status = Studio::Subprocess.capture3(
        RUBY, path,
        timeout: timeout_s,
        chdir: STUDIO_ROOT,
        env: { "MT_NO_PLUGINS" => "1" }
      )
      result = Studio::TestRunner.classify([output, error_output].join("\n"), status)
    rescue Studio::Subprocess::TimeoutError => error
      result = Studio::TestRunner::Result.new(state: :blocked, reason: error.message)
    rescue StandardError => error
      result = Studio::TestRunner::Result.new(
        state: :blocked,
        reason: "runner error: #{error.class}: #{error.message}"
      )
    end

    summary = result.summary
    detail = summary ? Studio::TestRunner.summary_line(summary) : result.reason
    puts "studio-test0: #{result.state.to_s.upcase} #{name}#{detail ? " - #{detail}" : ""}"
    unless result.state == :pass
      failed << name
      [output, error_output].join("\n").lines.last(12).each do |line|
        puts "  #{line.rstrip}"
      end
    end
  end

  abort "test0: #{failed.size}/#{tests.size} file(s) failed or were unmeasured: #{failed.join(", ")}" if failed.any?
  puts "test0: #{tests.size} file(s) passed with non-empty Minitest summaries"
end

task default: %i[check test]
